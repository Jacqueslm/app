# Copy to .env and fill in. Nothing here is required to run locally.

# Signs the session cookie. REQUIRED in production - the server refuses to boot
# without it, because a random one per restart signs every customer out.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the SQLite file lives. On a hosting platform point this at the
# persistent volume, or every redeploy wipes the leads.
DB_PATH=./server/leadcatch.sqlite

# New-lead emails, via https://resend.com. Without a key, leads are still
# captured and shown in the dashboard - they just aren't emailed.
RESEND_API_KEY=
EMAIL_FROM=LeadCatch <leads@yourdomain.com>

# Absolute base URL, used for the dashboard link inside notification emails.
APP_URL=http://localhost:3100

PORT=3100
NODE_ENV=development
