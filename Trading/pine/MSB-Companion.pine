//@version=6
//  MSB COMPANION (quiet) — lines and three labels, nothing else.
//  Same brain as the bot. Run on the 1H chart next to it.

indicator("MSB Companion — quiet", "MSB-EYES", overlay = true,
     max_lines_count = 200, max_labels_count = 60, max_boxes_count = 30)

pvB = input.int(3, "Swing strength (match the bot)", minval = 1, maxval = 20)
expBars = input.int(400, "Setup expires after N bars", minval = 20)
showEQ  = input.bool(true, "Mark equal highs/lows (small)")
maxLbl  = input.int(9, "Keep at most this many labels", minval = 3, maxval = 30)

// ─── wave record ─────────────────────────────────────────────────────────────
ph = ta.pivothigh(pvB, pvB)
pl = ta.pivotlow(pvB, pvB)
var float h1 = na
var float h2 = na
var float h3 = na
var float l1 = na
var float l2 = na
newH = not na(ph)
newL = not na(pl)
if newH
    h3 := h2
    h2 := h1
    h1 := ph
if newL
    l2 := l1
    l1 := pl

var float aL_HH = na
var float aL_LH = na
var float aL_HL = na
var float aS_LL = na
var float aS_HL = na
var float aS_LH = na
if newH and not na(h3) and not na(l2) and h2 > h3 and l1 > l2 and h1 < h2 and h1 > l1
    aL_HH := h2
    aL_LH := h1
    aL_HL := l1
var float LL3 = na
if newL
    LL3 := l2[1]
if newL and not na(LL3) and not na(h2) and l2 < LL3 and h1 < h2 and l1 > l2 and l1 < h1
    aS_LL := l2
    aS_HL := l1
    aS_LH := h1

// keep the chart clean: a rolling bin of labels
var label[] bin = array.new_label()
f_note(float y, string txt, color col, bool up2) =>
    l = label.new(bar_index, y, txt, style = up2 ? label.style_label_up : label.style_label_down,
         color = col, textcolor = color.white, size = size.small)
    array.push(bin, l)
    if array.size(bin) > maxLbl
        label.delete(array.shift(bin))

// ─── long side ───────────────────────────────────────────────────────────────
var int   Lon = 0
var float LHH = na
var float LLH = na
var float LHL = na
var int   Lage = 0
var int   Lb = 0
var line  lnHH = na
var line  lnLH = na
var line  lnHL = na

if Lon == 0 and not na(aL_HL) and na(lnHL)
    lnHH := line.new(bar_index, aL_HH, bar_index + 60, aL_HH, color = color.new(#26a69a, 30), width = 2)
    lnLH := line.new(bar_index, aL_LH, bar_index + 60, aL_LH, color = color.new(#f0a020, 30), style = line.style_dashed)
    lnHL := line.new(bar_index, aL_HL, bar_index + 60, aL_HL, color = color.new(#ef5350, 30), width = 2)
if Lon == 1
    Lage += 1
    if Lage > expBars or close > LHH
        Lon := 0
if Lon == 0 and not na(aL_HL) and low < aL_HL
    Lon := 1
    LHH := aL_HH
    LLH := aL_LH
    LHL := aL_HL
    Lage := 0
    Lb := 0
    aL_HH := na
    aL_LH := na
    aL_HL := na
    f_note(low, "⚡ stop run — wait", color.new(#ef5350, 10), true)
else if Lon == 1
    if close > LHL and Lb == 0
        Lb := 1
    if Lb == 1 and close < LHL
        Lb := 2
        f_note(high, "⛔ crowd's short — stand aside", color.new(#ef5350, 40), false)
    if close > LLH
        f_note(low, "✅ trap sprung — bot longs", color.new(#26a69a, 0), true)
        Lon := 0
if Lon == 0 and not na(lnHL) and na(aL_HL)
    line.delete(lnHH)
    line.delete(lnLH)
    line.delete(lnHL)
    lnHH := na
    lnLH := na
    lnHL := na

// ─── short side ──────────────────────────────────────────────────────────────
var int   Son = 0
var float SLL = na
var float SHL = na
var float SLH = na
var int   Sage = 0
var int   Sb = 0
if Son == 1
    Sage += 1
    if Sage > expBars or close < SLL
        Son := 0
if Son == 0 and not na(aS_LH) and high > aS_LH
    Son := 1
    SLL := aS_LL
    SHL := aS_HL
    SLH := aS_LH
    Sage := 0
    Sb := 0
    aS_LL := na
    aS_HL := na
    aS_LH := na
    f_note(high, "⚡ stop run — wait", color.new(#ef5350, 10), false)
else if Son == 1
    if close < SLH and Sb == 0
        Sb := 1
    if Sb == 1 and close > SLH
        Sb := 2
        f_note(low, "⛔ crowd's long — stand aside", color.new(#ef5350, 40), true)
    if close < SHL
        f_note(high, "✅ trap sprung — bot shorts", color.new(#26a69a, 0), false)
        Son := 0

// ─── equal highs/lows: tiny marks, no paragraphs ─────────────────────────────
tol = math.abs(nz(h1, close) - nz(l1, close)) * 0.12
if showEQ and newH and not na(h2) and math.abs(h1 - h2) <= tol and h1 > close
    line.new(bar_index - pvB, h1, bar_index + 30, h1, color = color.new(#c084fc, 55), style = line.style_dotted)
if showEQ and newL and not na(l2) and math.abs(l1 - l2) <= tol and l1 < close
    line.new(bar_index - pvB, l1, bar_index + 30, l1, color = color.new(#c084fc, 55), style = line.style_dotted)

// ─── dashboard ───────────────────────────────────────────────────────────────
stTx(int on, int b, bool armed) => on == 1 ? (b == 2 ? "④ crowd in — trap loading" : b == 1 ? "③ bounced" : "② stops running") : armed ? "① level armed" : "watching"
crowd = Lon == 1 ? (Lb == 2 ? "sure it breaks (the trap)" : Lb == 1 ? "arguing" : "panic") :
     Son == 1 ? (Sb == 2 ? "sure it breaks (the trap)" : Sb == 1 ? "arguing" : "panic") : "quiet"
you = (Lon == 1 and Lb == 2) or (Son == 1 and Sb == 2) ? "wait for the reclaim ONLY" :
     Lon == 1 or Son == 1 ? "hands off" : "wait"

var table dash = table.new(position.top_right, 2, 4, bgcolor = color.new(#0e1116, 8),
     frame_color = color.new(color.gray, 60), frame_width = 1)
if barstate.islast
    table.cell(dash, 0, 0, "MSB EYES", text_color = color.white, text_size = size.small, bgcolor = #3b82f6)
    table.cell(dash, 1, 0, syminfo.ticker, text_color = color.white, text_size = size.small, bgcolor = #3b82f6)
    table.cell(dash, 0, 1, "Long", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 1, stTx(Lon, Lb, not na(aL_HL)), text_color = Lon == 1 ? color.yellow : color.silver, text_size = size.small)
    table.cell(dash, 0, 2, "Short", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 2, stTx(Son, Sb, not na(aS_LH)), text_color = Son == 1 ? color.yellow : color.silver, text_size = size.small)
    table.cell(dash, 0, 3, "Crowd / you", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 3, crowd + " / " + you, text_color = #26a69a, text_size = size.small)
