//@version=6
// =============================================================================
//  MSB COMPANION — the bot's eyes, drawn on the chart
//
//  Follow-along overlay for MSB-Price-Alerts. Same state machine, zero trades.
//  It marks, in real time:
//    · the wave record (HH / higher low / lower high)
//    · where the STOPS sleep - under the higher low, over the lower high,
//      behind equal highs/lows, behind yesterday's high and low
//    · the STOP RUN when the higher low breaks - and what the crowd feels
//    · the trade everyone takes there ("confirmed breakdown") - the one that
//      measured 63% wins and NEGATIVE money over 766 cases. Stand aside.
//    · the trap springing (reclaim of the lower high) - where the bot fires
//
//  Run it on the 1H chart, same chart as the alerts script. Pure structure.
// =============================================================================

indicator("MSB Companion — follow the bot", "MSB-EYES", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 100)

pvB = input.int(3, "Swing strength (match the bot)", minval = 1, maxval = 20)
expBars = input.int(400, "Setup expires after N bars", minval = 20)
showPD  = input.bool(true, "Yesterday's high/low (tourist stop zones)")
showEQ  = input.bool(true, "Equal highs/lows (stacked stops)")
showTxt = input.bool(true, "Psychology labels at each event")

// ─── The wave record (identical to the bot) ──────────────────────────────────
ph = ta.pivothigh(pvB, pvB)
pl = ta.pivotlow(pvB, pvB)
var float h1 = na
var float h2 = na
var float h3 = na
var float l1 = na
var float l2 = na
newH = not na(ph)
newL = not na(pl)
if newH
    h3 := h2
    h2 := h1
    h1 := ph
if newL
    l2 := l1
    l1 := pl

var float aL_HH = na
var float aL_LH = na
var float aL_HL = na
var float aS_LL = na
var float aS_HL = na
var float aS_LH = na
if newH and not na(h3) and not na(l2) and h2 > h3 and l1 > l2 and h1 < h2 and h1 > l1
    aL_HH := h2
    aL_LH := h1
    aL_HL := l1
var float LL3 = na
if newL
    LL3 := l2[1]
if newL and not na(LL3) and not na(h2) and l2 < LL3 and h1 < h2 and l1 > l2 and l1 < h1
    aS_LL := l2
    aS_HL := l1
    aS_LH := h1

// ─── State (identical to the bot) + the drawing ──────────────────────────────
var int   Lon = 0
var float LHH = na
var float LLH = na
var float LHL = na
var float Lext = na
var int   Lage = 0
var int   Lbounced = 0
var line  lnHH = na
var line  lnLH = na
var line  lnHL = na
var box   bxStops = na

f_note(float y, string txt, color col, bool up2) =>
    if showTxt
        label.new(bar_index, y, txt, style = up2 ? label.style_label_up : label.style_label_down,
             color = col, textcolor = color.white, size = size.small)

// arm: draw the map and the stop pool under the higher low
if Lon == 0 and not na(aL_HL) and na(lnHL)
    lnHH := line.new(bar_index, aL_HH, bar_index + 60, aL_HH, color = #26a69a, width = 2)
    lnLH := line.new(bar_index, aL_LH, bar_index + 60, aL_LH, color = #f0a020, width = 1, style = line.style_dashed)
    lnHL := line.new(bar_index, aL_HL, bar_index + 60, aL_HL, color = #ef5350, width = 2)
    bxStops := box.new(bar_index, aL_HL, bar_index + 60, aL_HL - (aL_HH - aL_HL) * 0.15,
         bgcolor = color.new(#ef5350, 88), border_color = color.new(#ef5350, 60))
    f_note(aL_HL, "SELL STOPS SLEEP HERE\nevery long since the higher low\n+ breakout shorts waiting", color.new(#ef5350, 20), false)

if Lon == 1
    Lage += 1
    if Lage > expBars
        Lon := 0
if Lon == 1 and close > LHH
    f_note(high, "ran to the old high — chance gone\nno chasing", color.new(color.gray, 20), false)
    Lon := 0

// the break = the stop run
if Lon == 0 and not na(aL_HL) and low < aL_HL
    Lon := 1
    LHH := aL_HH
    LLH := aL_LH
    LHL := aL_HL
    Lext := low
    Lage := 0
    Lbounced := 0
    aL_HH := na
    aL_LH := na
    aL_HL := na
    f_note(low, "⚡ STOP RUN\nlongs flushed at the worst price\ncrowd: panic · you: patience\nDO NOTHING YET", color.new(#ef5350, 0), true)
else if Lon == 1
    Lext := math.min(Lext, low)
    // the bounce: back over the level - the argument begins
    if close > LHL and Lbounced == 0
        Lbounced := 1
        f_note(low, "the bounce\ntrapped longs exit relieved\nearly shorts press · still nothing", color.new(#f0a020, 20), true)
    // the crowd's trade: 'confirmed' breakdown - the measured loser
    if Lbounced == 1 and close < LHL
        Lbounced := 2
        f_note(high, "⛔ 'CONFIRMED BREAKDOWN'\nthis is the click the crowd makes\nmeasured: 63% wins, LOSES money\nover 766 cases — STAND ASIDE", color.new(#ef5350, 30), false)
    // the trap springs: reclaim of the lower high - the bot's entry
    if close > LLH
        f_note(low, "✅ TRAP SPRUNG — bot fires LONG\nshorts stuck below, their stops above are fuel\nstop under the flush low\ntarget 80% back to the old high", color.new(#26a69a, 0), true)
        Lon := 0
if Lon == 0 and not na(lnHL) and na(aL_HL)
    line.delete(lnHH)
    line.delete(lnLH)
    line.delete(lnHL)
    box.delete(bxStops)
    lnHH := na
    lnLH := na
    lnHL := na
    bxStops := na

// ─── Short side (mirror), lighter drawing ────────────────────────────────────
var int   Son = 0
var float SLL = na
var float SHL = na
var float SLH = na
var float Sext = na
var int   Sage = 0
var int   Sbounced = 0
if Son == 1
    Sage += 1
    if Sage > expBars
        Son := 0
if Son == 1 and close < SLL
    Son := 0
if Son == 0 and not na(aS_LH) and high > aS_LH
    Son := 1
    SLL := aS_LL
    SHL := aS_HL
    SLH := aS_LH
    Sext := high
    Sage := 0
    Sbounced := 0
    aS_LL := na
    aS_HL := na
    aS_LH := na
    f_note(high, "⚡ STOP RUN above the lower high\nshorts flushed · crowd chases the break\nDO NOTHING YET", color.new(#ef5350, 0), false)
else if Son == 1
    Sext := math.max(Sext, high)
    if close < SLH and Sbounced == 0
        Sbounced := 1
        f_note(high, "the dip back — trapped shorts exit\nearly longs press · still nothing", color.new(#f0a020, 20), false)
    if Sbounced == 1 and close > SLH
        Sbounced := 2
        f_note(low, "⛔ 'CONFIRMED BREAKOUT'\nthe crowd's click — the measured loser\nSTAND ASIDE", color.new(#ef5350, 30), true)
    if close < SHL
        f_note(high, "✅ TRAP SPRUNG — bot fires SHORT\nlongs stuck above are the fuel\ntarget 80% back to the old low", color.new(#26a69a, 0), false)
        Son := 0

// ─── Familiar levels: where everyone's stops stack ───────────────────────────
// equal highs/lows: two swings within 12% of the recent wave of each other
tol = math.abs(nz(h1, close) - nz(l1, close)) * 0.12
if showEQ and newH and not na(h2) and math.abs(h1 - h2) <= tol and h1 > close
    line.new(bar_index - pvB, h1, bar_index + 40, h1, color = color.new(#c084fc, 30), style = line.style_dotted, width = 2)
    f_note(h1, "EQUAL HIGHS\nbuy stops stacked — a magnet\nexpect a run through, then the truth", color.new(#c084fc, 30), false)
if showEQ and newL and not na(l2) and math.abs(l1 - l2) <= tol and l1 < close
    line.new(bar_index - pvB, l1, bar_index + 40, l1, color = color.new(#c084fc, 30), style = line.style_dotted, width = 2)
    f_note(l1, "EQUAL LOWS\nsell stops stacked — a magnet\nexpect a run through, then the truth", color.new(#c084fc, 30), true)

// yesterday's high and low: the whole world watches these
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_on)
plot(showPD ? pdh : na, "Yesterday high", color.new(#8b96a5, 40), 1, plot.style_circles)
plot(showPD ? pdl : na, "Yesterday low",  color.new(#8b96a5, 40), 1, plot.style_circles)

// ─── The dashboard: what the crowd feels vs what you do ──────────────────────
crowdL = Lon == 0 and not na(aL_HL) ? "trusts the higher low" :
     Lon == 1 and Lbounced == 0 ? "PANIC — stops running" :
     Lon == 1 and Lbounced == 1 ? "arguing: real break or trap?" :
     Lon == 1 and Lbounced == 2 ? "certain it breaks down (the trap)" : "nothing to exploit"
youL = Lon == 0 and not na(aL_HL) ? "watch the level" :
     Lon == 1 and Lbounced <  2 ? "hands off — let them fight" :
     Lon == 1 ? "wait for the reclaim ONLY" : "wait"

var table dash = table.new(position.top_right, 2, 5, bgcolor = color.new(#0e1116, 8),
     frame_color = color.new(color.gray, 60), frame_width = 1)
if barstate.islast
    table.cell(dash, 0, 0, "MSB EYES", text_color = color.white, text_size = size.small, bgcolor = #3b82f6)
    table.cell(dash, 1, 0, syminfo.ticker, text_color = color.white, text_size = size.small, bgcolor = #3b82f6)
    table.cell(dash, 0, 1, "Long side", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 1, Lon == 1 ? (Lbounced == 2 ? "④ crowd shorting — trap loading" : Lbounced == 1 ? "③ bounced — the argument" : "② stops running") : not na(aL_HL) ? "① level armed" : "watching",
         text_color = Lon == 1 ? color.yellow : color.silver, text_size = size.small)
    table.cell(dash, 0, 2, "Short side", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 2, Son == 1 ? (Sbounced == 2 ? "④ crowd buying — trap loading" : Sbounced == 1 ? "③ dipped — the argument" : "② stops running") : not na(aS_LH) ? "① level armed" : "watching",
         text_color = Son == 1 ? color.yellow : color.silver, text_size = size.small)
    table.cell(dash, 0, 3, "Crowd feels", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 3, crowdL, text_color = #f0a020, text_size = size.small)
    table.cell(dash, 0, 4, "You do", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 4, youL, text_color = #26a69a, text_size = size.small)
