//@version=6
// =============================================================================
//  MARKET STRUCTURE BRIDGE — GATE DIAGNOSTIC
//
//  This does not trade. It answers one question: WHICH RULE IS BLOCKING TRADES?
//
//  It finds every bar where the structure sequence completed — break, back
//  through, reclaim, fresh break — and then, for each filter in turn, counts how
//  many of those it killed. The table reads top to bottom: sequence completions
//  at the top, then every gate with the number of setups it vetoed, then how
//  many survived everything.
//
//  Run it on the same chart and settings as the backtester. The biggest number
//  in the middle column is the rule that decides your trade frequency.
// =============================================================================

indicator("MSB — Gate Diagnostic", "MSB-DIAG", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)


// ─── Inputs ──────────────────────────────────────────────────────────────────
grpS = "Structure"
pvL      = input.int(3, "Swing strength (left)",  minval = 1, maxval = 20, group = grpS)
pvR      = input.int(3, "Swing strength (right)", minval = 1, maxval = 20, group = grpS)
biasTF   = input.timeframe("D",   "Bias timeframe",    group = grpS)
bridgeTF = input.timeframe("240", "Bridge timeframe",  group = grpS)
monTF    = input.timeframe("15",  "Monitor timeframe", group = grpS)

grpC = "Consolidation filter"
erLen   = input.int(20,     "Efficiency ratio length", minval = 5,   group = grpC)
erMin   = input.float(0.30, "Chop if ER below",        minval = 0.0, maxval = 1.0, step = 0.01, group = grpC)
rngLen  = input.int(20,     "Range length",            minval = 5,   group = grpC)
rngMin  = input.float(3.0,  "Chop if range/ATR below", minval = 0.5, step = 0.1, group = grpC)
adxMin  = input.float(18.0, "Chop if ADX below",       minval = 5.0, step = 0.5, group = grpC)
maxChop = input.int(1, "Max chop measures allowed", minval = 0, maxval = 3, group = grpC)

grpI = "Institutional context"
useCtx   = input.bool(true, "Apply context layer (master switch)", group = grpI,
     tooltip = "OFF = structure only. ON = plus VWAP gates, RVOL, sweeps, reference levels, correlation. Run both.")
useVwap  = input.bool(true, "Gate: right side of VWAP", group = grpI)
useExt   = input.bool(true, "Gate: reject if past the 2σ band", group = grpI)
vwapDev  = input.float(2.0, "VWAP band (std dev)", minval = 0.5, step = 0.5, group = grpI)
rvolMin  = input.float(1.2, "Point: RVOL at or above", minval = 0.1, step = 0.1, group = grpI)
holdBars = input.int(2, "Bars price must hold the reclaim", minval = 1, maxval = 10, group = grpI)
reqHold  = input.bool(true, "Gate: require acceptance before triggering", group = grpI)
useSweep = input.bool(true, "Point: reward a liquidity sweep", group = grpI)
useRef   = input.bool(true, "Point: reward reference-level confluence", group = grpI)
refTolA  = input.float(0.5, "Reference tolerance (× ATR)", minval = 0.1, step = 0.1, group = grpI)
useCorr  = input.bool(true, "Point: correlated instrument agrees", group = grpI)
corrSym  = input.symbol("CME_MINI:MES1!", "Correlated symbol", group = grpI)
corrLen  = input.int(5, "Correlation lookback (bars)", minval = 2, group = grpI)

grpP = "Professional read — the day, top down"
useBudget = input.bool(true, "Gate: reject when the range budget is spent", group = grpP)
budgetMax = input.float(0.85, "Budget spent at (× daily ATR)", minval = 0.3, maxval = 2.0, step = 0.05, group = grpP)
useDayTp  = input.bool(true, "Point: day type agrees (not a balance day)", group = grpP)
useVA     = input.bool(true, "Point: trading beyond yesterday's value", group = grpP)
vaAccept  = input.int(2, "Closes beyond value = acceptance", minval = 1, maxval = 6, group = grpP)

grpM2 = "Manipulation guard — the range trap"
useTrap   = input.bool(true, "Gate: no breakout entries while the 4H is ranging", group = grpM2)
trapAccept = input.int(3, "Closes beyond the edge = real break", minval = 1, maxval = 10, group = grpM2)
trapBars  = input.int(6, "Snap back within N bars = fake-out", minval = 2, maxval = 20, group = grpM2)
useFuel   = input.bool(true, "Point: opposite edge was swept (fuel)", group = grpM2)
fuelLook  = input.int(30, "Fuel counts for N bars", minval = 5, group = grpM2)
htfRngLen = input.int(20, "HTF range length (bars)", minval = 5, group = grpM2)

grpZ = "Your zones & alignment"
useAlign = input.bool(true, "Gate: all four timeframes must align (D · 4H · 1H · 15m)", group = grpZ)
zoneImp  = input.float(2.0, "Zone impulse (body vs 20-bar avg)", minval = 1.2, step = 0.1, group = grpZ)

grpN = "News blackout — your rule, on the clock"
useNews = input.bool(true, "Gate: weekly report blackout (Thu/Fri 08:30 ET)", group = grpN,
     tooltip = "The 7:30am Central weekly reports = 08:30 Eastern. No alerts in the window around them on Thu/Fri.")
newsSess = input.session("0800-0900:56", "Blackout window (:56 = Thu+Fri)", group = grpN,
     tooltip = "Times are Eastern. 0800-0900 covers the 08:30 release with 30 min either side.")
fomcDay = input.bool(false, "FOMC today — block the whole day (manual)", group = grpN,
     tooltip = "Pine cannot see the Fed calendar. Tick this on the ~8 FOMC Wednesdays a year (and untick after). The one news box only you can hold.")

grpT = "Trigger & grading"
dispMult = input.float(1.2, "Displacement (body vs 20-bar avg)", minval = 1.0, step = 0.1, group = grpT)
setupTO  = input.int(40, "Setup expires after N bars", minval = 5, group = grpT)
minScore = input.int(8,  "Minimum grade score (8 = B, 10 = A+)", minval = 0, maxval = 13, group = grpT)
stopBuf  = input.float(0.15, "Stop buffer (× ATR)", minval = 0.0, step = 0.05, group = grpT)

grpM = "Management — the 1R partial model"
partialR = input.float(1.0, "T1 at R multiple (take half here)", minval = 0.5, step = 0.5, group = grpM,
     tooltip = "Where you get to be right, in cash, early. T2 is the HTF level, not a fixed multiple.")
t1Pct   = input.int(50, "% off at T1", minval = 0, maxval = 100, group = grpM)
beAtT1  = input.bool(true, "Move stop to break-even at T1", group = grpM)
maxLoss = input.int(2, "Stop trading after N losses per day", minval = 1, maxval = 10, group = grpM)

grpR = "Your rules"
maxPerDay = input.int(1, "Max trades per day", minval = 1, maxval = 5, group = grpR,
     tooltip = "One bullet. Set to 5 to see what unrestricted trading would have done — the comparison is the point.")
scalpMax = input.float(2.0, "SCALP if room below this (R)", minval = 1.0, step = 0.5, group = grpR)
holdMin  = input.float(3.5, "HOLD if room above this (R)",  minval = 2.0, step = 0.5, group = grpR)
minRoom  = input.float(1.0, "Reject if room below this (R)", minval = 0.5, step = 0.5, group = grpR)

grpX = "Session — New York only"
useSess = input.bool(true, "Only trade inside the tradeable window", group = grpX)
sessStr = input.session("0930-1500", "Tradeable window", group = grpX)
primeStr = input.session("0930-1130", "Prime hours (earns a quality point)", group = grpX)
rthStr  = input.session("0930-1600", "Regular hours (for IB / overnight)", group = grpX)
sessTZ  = input.string("America/New_York", "Timezone", group = grpX)
flatEOD = input.bool(true, "Flatten at session end", group = grpX)

grpD = "Backtest window"
useDates = input.bool(false, "Limit date range", group = grpD)
dFrom = input.time(timestamp("01 Jan 2023 00:00 +0000"), "From", group = grpD)
dTo   = input.time(timestamp("01 Jan 2030 00:00 +0000"), "To",   group = grpD)

// ─── Structure engine ────────────────────────────────────────────────────────
f_structure() =>
    var float swingHi  = na
    var float swingLo  = na
    var float brokenHi = na
    var float brokenLo = na
    var float protLo   = na
    var float protHi   = na
    var int   trend    = 0

    ph = ta.pivothigh(high, pvL, pvR)
    pl = ta.pivotlow(low,  pvL, pvR)
    if not na(ph)
        swingHi := ph
    if not na(pl)
        swingLo := pl

    bUp = not na(swingHi) and close > swingHi
    bDn = not na(swingLo) and close < swingLo
    if bUp and bDn
        if close >= open
            bDn := false
        else
            bUp := false

    if bUp
        brokenHi := swingHi
        protLo   := swingLo
        trend    := 1
        swingHi  := na
    else if bDn
        brokenLo := swingLo
        protHi   := swingHi
        trend    := -1
        swingLo  := na

    [trend, brokenHi, brokenLo, protLo, protHi, bUp, bDn]

f_trend() =>
    [t, _bh, _bl, _pl, _ph, _bu, _bd] = f_structure()
    t

// Supply/demand zones: the base candle before an explosive departure. A zone dies
// the moment price CLOSES through its far side.
f_zone() =>
    var float demTop = na
    var float demBot = na
    var float supTop = na
    var float supBot = na
    avgB  = ta.sma(math.abs(close - open), 20)
    upImp = close > open and (close - open) > avgB * zoneImp
    dnImp = open > close and (open - close) > avgB * zoneImp
    if upImp and close[1] < open[1]
        demTop := math.max(open[1], close[1])
        demBot := low[1]
    if dnImp and close[1] > open[1]
        supBot := math.min(open[1], close[1])
        supTop := high[1]
    if not na(demBot) and close < demBot
        demTop := na
        demBot := na
    if not na(supTop) and close > supTop
        supTop := na
        supBot := na
    [demTop, demBot, supTop, supBot]

[xTrend, xBrokenHi, xBrokenLo, xProtLo, xProtHi, xBosUp, xBosDn] = f_structure()
biasTrend   = request.security(syminfo.tickerid, biasTF,   f_trend(), lookahead = barmerge.lookahead_off)
bridgeTrend = request.security(syminfo.tickerid, bridgeTF, f_trend(), lookahead = barmerge.lookahead_off)
m15Trend    = request.security(syminfo.tickerid, monTF,    f_trend(), lookahead = barmerge.lookahead_off)

[dDemT, dDemB, dSupT, dSupB] = request.security(syminfo.tickerid, biasTF,   f_zone(), lookahead = barmerge.lookahead_off)
[hDemT, hDemB, hSupT, hSupB] = request.security(syminfo.tickerid, bridgeTF, f_zone(), lookahead = barmerge.lookahead_off)

alignL = not useAlign or (biasTrend ==  1 and bridgeTrend ==  1 and xTrend ==  1 and m15Trend ==  1)
alignS = not useAlign or (biasTrend == -1 and bridgeTrend == -1 and xTrend == -1 and m15Trend == -1)

// ─── Consolidation filter ────────────────────────────────────────────────────
f_chop() =>
    atr14  = ta.atr(14)
    move   = math.abs(close - close[erLen])
    path   = math.sum(math.abs(close - close[1]), erLen)
    er     = path > 0 ? move / path : 0.0
    rng    = ta.highest(high, rngLen) - ta.lowest(low, rngLen)
    rngAtr = atr14 > 0 ? rng / atr14 : 0.0
    [_dip, _dim, adxv] = ta.dmi(14, 14)
    (er < erMin ? 1 : 0) + (rngAtr < rngMin ? 1 : 0) + (adxv < adxMin ? 1 : 0)

chopN    = f_chop()
monChopN = request.security(syminfo.tickerid, monTF, f_chop(), lookahead = barmerge.lookahead_off)
chopOK   = chopN <= maxChop and monChopN <= maxChop

// ─── Institutional context ───────────────────────────────────────────────────
newDay = timeframe.change("D")
[vwapV, vwapUp, vwapDn] = ta.vwap(hlc3, newDay, vwapDev)
vwapSideL = not useCtx or not useVwap or (not na(vwapV) and close > vwapV)
vwapSideS = not useCtx or not useVwap or (not na(vwapV) and close < vwapV)
notExtL   = not useCtx or not useExt  or (na(vwapUp) or close < vwapUp)
notExtS   = not useCtx or not useExt  or (na(vwapDn) or close > vwapDn)

// RVOL by hour of day — read before updating, so no lookahead.
var array<float> hvSum = array.new_float(24, 0.0)
var array<int>   hvCnt = array.new_int(24, 0)
hrIdx  = hour(time, sessTZ)
hvN    = array.get(hvCnt, hrIdx)
hvMean = hvN > 0 ? array.get(hvSum, hrIdx) / hvN : na
rvol   = not na(hvMean) and hvMean > 0 and not na(volume) ? volume / hvMean : 1.0
if barstate.isconfirmed and not na(volume)
    array.set(hvSum, hrIdx, array.get(hvSum, hrIdx) + volume)
    array.set(hvCnt, hrIdx, hvN + 1)
rvolOK = not useCtx or rvol >= rvolMin

pdh = request.security(syminfo.tickerid, "D", high[1],  lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],   lookahead = barmerge.lookahead_on)
pdc = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)

inRth = not na(time(timeframe.period, rthStr, sessTZ))
var float ibH = na
var float ibL = na
var float onH = na
var float onL = na
if inRth and not inRth[1]
    ibH := high
    ibL := low
if not inRth
    if inRth[1]
        onH := high
        onL := low
    else
        onH := math.max(nz(onH, high), high)
        onL := math.min(nz(onL, low),  low)

atr = ta.atr(14)
f_near(float lvl, float ref, float tol) => not na(lvl) and not na(ref) and math.abs(lvl - ref) <= tol

// ─── The professional read: value, day type, range budget (PRO-ANALYSIS.md) ──
// Yesterday's value area ≈ prior day's final VWAP ± 1σ.
[vaMid, vaHiRun, vaLoRun] = ta.vwap(hlc3, newDay, 1.0)
var float pPoc = na
var float pVah = na
var float pVal = na
if newDay
    pPoc := vaMid[1]
    pVah := vaHiRun[1]
    pVal := vaLoRun[1]

var int vaAboveCnt = 0
var int vaBelowCnt = 0
vaAboveCnt := not na(pVah) and close > pVah ? vaAboveCnt + 1 : 0
vaBelowCnt := not na(pVal) and close < pVal ? vaBelowCnt + 1 : 0
dayType = vaAboveCnt >= vaAccept ? 1 : vaBelowCnt >= vaAccept ? -1 : 0

dAtr = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead = barmerge.lookahead_on)
var float tdHi = na
var float tdLo = na
if newDay
    tdHi := high
    tdLo := low
else
    tdHi := math.max(nz(tdHi, high), high)
    tdLo := math.min(nz(tdLo, low),  low)
usedUpLong  = not na(dAtr) and dAtr > 0 ? (close - tdLo) / dAtr : 0.0
usedUpShort = not na(dAtr) and dAtr > 0 ? (tdHi - close) / dAtr : 0.0
budgetOKL = not useCtx or not useBudget or usedUpLong  <= budgetMax
budgetOKS = not useCtx or not useBudget or usedUpShort <= budgetMax

// ─── Manipulation guard: the range trap (see the indicator for the reasoning) ─
htfChopN = request.security(syminfo.tickerid, bridgeTF, f_chop(), lookahead = barmerge.lookahead_off)
htfRngHi = request.security(syminfo.tickerid, bridgeTF, ta.highest(high, htfRngLen)[1], lookahead = barmerge.lookahead_off)
htfRngLo = request.security(syminfo.tickerid, bridgeTF, ta.lowest(low,  htfRngLen)[1],  lookahead = barmerge.lookahead_off)
htfRanging = htfChopN >= 2

var int edgeUpCnt = 0
var int edgeDnCnt = 0
edgeUpCnt := not na(htfRngHi) and close > htfRngHi ? edgeUpCnt + 1 : 0
edgeDnCnt := not na(htfRngLo) and close < htfRngLo ? edgeDnCnt + 1 : 0

trapUp = htfRanging and edgeUpCnt == 0 and edgeUpCnt[1] > 0 and edgeUpCnt[1] <= trapBars
trapDn = htfRanging and edgeDnCnt == 0 and edgeDnCnt[1] > 0 and edgeDnCnt[1] <= trapBars

var int lastTrapUpBar = na
var int lastTrapDnBar = na
if trapUp
    lastTrapUpBar := bar_index
if trapDn
    lastTrapDnBar := bar_index
fuelLong  = not na(lastTrapDnBar) and bar_index - lastTrapDnBar <= fuelLook
fuelShort = not na(lastTrapUpBar) and bar_index - lastTrapUpBar <= fuelLook

trapGateL = not useCtx or not useTrap or not htfRanging or not (not na(htfRngHi) and close > htfRngHi) or edgeUpCnt >= trapAccept
trapGateS = not useCtx or not useTrap or not htfRanging or not (not na(htfRngLo) and close < htfRngLo) or edgeDnCnt >= trapAccept

corrClose = request.security(corrSym, timeframe.period, close, lookahead = barmerge.lookahead_off)
corrChg   = corrClose - corrClose[corrLen]
ownChg    = close - close[corrLen]
corrAgree = not useCtx or not useCorr or (not na(corrChg) and math.sign(corrChg) == math.sign(ownChg))

// ─── Higher-timeframe swing levels (what a HOLD is aiming at) ────────────────
f_lastPivotHi() =>
    var float p = na
    v = ta.pivothigh(high, pvL, pvR)
    if not na(v)
        p := v
    p
f_lastPivotLo() =>
    var float p = na
    v = ta.pivotlow(low, pvL, pvR)
    if not na(v)
        p := v
    p

h4Hi = request.security(syminfo.tickerid, bridgeTF, f_lastPivotHi(), lookahead = barmerge.lookahead_off)
h4Lo = request.security(syminfo.tickerid, bridgeTF, f_lastPivotLo(), lookahead = barmerge.lookahead_off)
dHi  = request.security(syminfo.tickerid, biasTF,   f_lastPivotHi(), lookahead = barmerge.lookahead_off)
dLo  = request.security(syminfo.tickerid, biasTF,   f_lastPivotLo(), lookahead = barmerge.lookahead_off)

f_pickAbove(float cur, float lvl, float px) =>
    not na(lvl) and lvl > px ? (na(cur) ? lvl : math.min(cur, lvl)) : cur
f_pickBelow(float cur, float lvl, float px) =>
    not na(lvl) and lvl < px ? (na(cur) ? lvl : math.max(cur, lvl)) : cur

// ─── Shared series ───────────────────────────────────────────────────────────
inSess  = not useSess or not na(time(timeframe.period, sessStr, sessTZ))
// Your news rule, mechanical: outside the Thu/Fri report window, and not an FOMC day.
newsOK = not useNews or (na(time(timeframe.period, newsSess, sessTZ)) and not fomcDay)
inPrime = not na(time(timeframe.period, primeStr, sessTZ))
inDates = not useDates or (time >= dFrom and time <= dTo)
avgBody = ta.sma(math.abs(close - open), 20)
disp    = math.abs(close - open) >= avgBody * dispMult
// The gate requires displacement, so rewarding the same threshold would score on every
// trigger and discriminate nothing. The POINT needs a genuinely stronger candle.
dispStrong = math.abs(close - open) >= avgBody * dispMult * 1.5
hi100   = ta.highest(high, 100)[1]
lo100   = ta.lowest(low, 100)[1]

// ─── Daily loss limit ────────────────────────────────────────────────────────
var int lossesToday = 0
var int lastDay     = na
// na(lastDay) first — `dayofmonth != na` evaluates to na, never true, so without
// this the counter would never reset and the daily limit would become a lifetime one.
if na(lastDay) or dayofmonth != lastDay
    lossesToday := 0
    lastDay     := dayofmonth
dayOK = lossesToday < maxLoss

// ─── Setup state machine ─────────────────────────────────────────────────────
var int   st       = 0
var int   stDir    = 0
var float zone     = na
var float prot     = na
var int   stBars   = 0
var int   touches  = 0
var bool  cleanRt  = true
var float pullExt  = na
var float trigLvl  = na
var bool  swept    = false
var int   heldBars = 0

armLong  = xBosUp and biasTrend ==  1
armShort = xBosDn and biasTrend == -1
armedNow = armLong or armShort

if armLong
    st       := 1
    stDir    := 1
    zone     := xBrokenHi
    prot     := na(xProtLo) ? low : xProtLo
    stBars   := 0
    touches  := 0
    cleanRt  := true
    pullExt  := low
    trigLvl  := na
    swept    := false
    heldBars := 0
else if armShort
    st       := 1
    stDir    := -1
    zone     := xBrokenLo
    prot     := na(xProtHi) ? high : xProtHi
    stBars   := 0
    touches  := 0
    cleanRt  := true
    pullExt  := high
    trigLvl  := na
    swept    := false
    heldBars := 0
else if st > 0
    stBars += 1

// `not armedNow` — the breakout candle's own low sits below the level it just broke.
if st > 0 and stDir == 1 and not armedNow
    // Liquidity sweep: a NEW pullback low that closes back above the old one, in the
    // upper half of its range. Measured against the pullback's own low, not a fixed
    // window — a fixed window reaches back past the breakout and never triggers.
    prevExt = pullExt
    pullExt := math.min(pullExt, low)
    if st == 2 and not na(prevExt) and low < prevExt and close > prevExt and close > (high + low) / 2
        swept := true
    if st == 1 and low < zone
        st := 2
    else if st == 2 and close > zone
        st       := 3
        touches  := touches + 1
        trigLvl  := high
        heldBars := 0
    else if st == 3
        if close < zone
            st       := 2
            cleanRt  := false
            heldBars := 0
        else
            heldBars += 1

if st > 0 and stDir == -1 and not armedNow
    prevExt = pullExt
    pullExt := math.max(pullExt, high)
    if st == 2 and not na(prevExt) and high > prevExt and close < prevExt and close < (high + low) / 2
        swept := true
    if st == 1 and high > zone
        st := 2
    else if st == 2 and close < zone
        st       := 3
        touches  := touches + 1
        trigLvl  := low
        heldBars := 0
    else if st == 3
        if close > zone
            st       := 2
            cleanRt  := false
            heldBars := 0
        else
            heldBars += 1

invalid = st > 0 and (
     (stDir ==  1 and ((not na(prot) and close < prot) or biasTrend == -1)) or
     (stDir == -1 and ((not na(prot) and close > prot) or biasTrend ==  1)) or
     stBars > setupTO)
if invalid
    st      := 0
    stDir   := 0
    zone    := na
    prot    := na
    trigLvl := na

refTol = atr * refTolA
f_inZone(float lvl, float top, float bot, float tol) =>
    not na(lvl) and not na(top) and not na(bot) and lvl >= bot - tol and lvl <= top + tol
refHit = f_near(zone, pdh, refTol) or f_near(zone, pdl, refTol) or f_near(zone, pdc, refTol) or
     f_near(zone, onH, refTol) or f_near(zone, onL, refTol) or
     f_near(zone, ibH, refTol) or f_near(zone, ibL, refTol) or
     f_inZone(zone, dDemT, dDemB, refTol) or f_inZone(zone, dSupT, dSupB, refTol) or
     f_inZone(zone, hDemT, hDemB, refTol) or f_inZone(zone, hSupT, hSupB, refTol)
refOK = not useCtx or not useRef or refHit

// Acceptance gate — step ⑤. The market answering the question the touch asked.
acceptOK = not reqHold or heldBars >= holdBars

// ─── Trigger & grade ─────────────────────────────────────────────────────────
// RAW = the structure sequence completed. Every gate below is measured against this.
rawLong  = st == 3 and stDir ==  1 and not na(trigLvl) and close > trigLvl
rawShort = st == 3 and stDir == -1 and not na(trigLvl) and close < trigLvl
raw      = rawLong or rawShort
trigLong  = rawLong  and bridgeTrend ==  1 and
     disp and chopOK and vwapSideL and notExtL and acceptOK and budgetOKL and trapGateL and alignL
trigShort = rawShort and bridgeTrend == -1 and
     disp and chopOK and vwapSideS and notExtS and acceptOK and budgetOKS and trapGateS and alignS

entry   = close
stopRaw = rawLong  ? math.min(nz(pullExt, low),  nz(zone, low))  - atr * stopBuf :
          rawShort ? math.max(nz(pullExt, high), nz(zone, high)) + atr * stopBuf : na
riskPts = na(stopRaw) ? na : math.abs(entry - stopRaw)

// Nearest opposing HTF level = the realistic target; the distance decides scalp vs hold.
tgtUp = f_pickAbove(float(na), h4Hi, entry)
tgtUp := f_pickAbove(tgtUp, dHi, entry)
tgtUp := f_pickAbove(tgtUp, pdh, entry)
tgtUp := f_pickAbove(tgtUp, onH, entry)
tgtDn = f_pickBelow(float(na), h4Lo, entry)
tgtDn := f_pickBelow(tgtDn, dLo, entry)
tgtDn := f_pickBelow(tgtDn, pdl, entry)
tgtDn := f_pickBelow(tgtDn, onL, entry)

htfTgt = rawLong ? nz(tgtUp, hi100) : nz(tgtDn, lo100)
roomR  = not na(riskPts) and riskPts > 0 ? math.abs(htfTgt - entry) / riskPts : 0.0
plan   = roomR < minRoom  ? "NO TRADE" :
         roomR < scalpMax ? "SCALP"    :
         roomR < holdMin  ? "STANDARD" : "HOLD"

pSweep = not useCtx or not useSweep or swept
pDayTp = not useCtx or not useDayTp or (rawLong ? dayType == 1 : rawShort ? dayType == -1 : false)
pVAout = not useCtx or not useVA or (rawLong ? (not na(pVah) and close > pVah) :
     rawShort ? (not na(pVal) and close < pVal) : false)
pFuel  = not useCtx or not useFuel or (rawLong ? fuelLong : rawShort ? fuelShort : false)
score  = (touches <= 1 ? 1 : 0) + (cleanRt and heldBars >= holdBars ? 1 : 0) +
     (dispStrong ? 1 : 0) + (rvolOK ? 1 : 0) + (pSweep ? 1 : 0) + (refOK ? 1 : 0) +
     (corrAgree ? 1 : 0) + (inPrime ? 1 : 0) + (chopN == 0 ? 1 : 0) + (roomR >= 3.0 ? 1 : 0) +
     (pDayTp ? 1 : 0) + (pVAout ? 1 : 0) + (pFuel ? 1 : 0)

// One bullet a day. na(lastEntryDay) first — `dayofmonth != na` is never true.
var int tookToday    = 0
var int lastEntryDay = na
if na(lastEntryDay) or dayofmonth != lastEntryDay
    tookToday    := 0
    lastEntryDay := dayofmonth

okToTrade = score >= minScore and plan != "NO TRADE" and inSess and newsOK and inDates and dayOK and
     tookToday < maxPerDay and riskPts > 0

// ─── Counters — one per gate, each measured against the raw sequence ─────────
f_hit(bool cond) => cond ? 1 : 0

var int nArm  = 0      // sequence armed (break of structure)
var int nSeq3 = 0      // reached the reclaim
var int nRaw  = 0      // full sequence incl. the fresh break
var int nPass = 0      // survived every gate

var int kBridge = 0
var int kDisp   = 0
var int kChop   = 0
var int kVwap   = 0
var int kExt    = 0
var int kHold   = 0
var int kBudget = 0
var int kTrap   = 0
var int kAlign  = 0
var int kSess   = 0
var int kNews   = 0
var int kRoom   = 0
var int kScore  = 0
var int kDaily  = 0

if st == 1 and st[1] != 1
    nArm += 1
if st == 3 and st[1] != 3
    nSeq3 += 1

gBridge = rawLong ? bridgeTrend == 1 : bridgeTrend == -1
gVwap   = rawLong ? vwapSideL : vwapSideS
gExt    = rawLong ? notExtL   : notExtS
gBudget = rawLong ? budgetOKL : budgetOKS
gTrap   = rawLong ? trapGateL : trapGateS
gAlign  = rawLong ? alignL    : alignS
gRoom   = plan != "NO TRADE"
gScore  = score >= minScore
gDaily  = tookToday < maxPerDay
allPass = gBridge and disp and chopOK and gVwap and gExt and acceptOK and gBudget and
     gTrap and gAlign and inSess and newsOK and gRoom and gScore and gDaily

if raw
    nRaw    += 1
    kBridge += f_hit(not gBridge)
    kDisp   += f_hit(not disp)
    kChop   += f_hit(not chopOK)
    kVwap   += f_hit(not gVwap)
    kExt    += f_hit(not gExt)
    kHold   += f_hit(not acceptOK)
    kBudget += f_hit(not gBudget)
    kTrap   += f_hit(not gTrap)
    kAlign  += f_hit(not gAlign)
    kSess   += f_hit(not inSess)
    kNews   += f_hit(not newsOK)
    kRoom   += f_hit(not gRoom)
    kScore  += f_hit(not gScore)
    kDaily  += f_hit(not gDaily)
    nPass   += f_hit(allPass)
    // spend the day's bullet, so the one-trade-a-day cap is counted honestly
    if allPass
        tookToday += 1

// ─── The table ───────────────────────────────────────────────────────────────
var table dg = table.new(position.bottom_right, 2, 19,
     bgcolor = color.new(#0e1116, 8), frame_color = color.new(color.gray, 60), frame_width = 1,
     border_color = color.new(color.gray, 80), border_width = 1)

if barstate.islast
    table.cell(dg, 0, 0, "GATE DIAGNOSTIC", text_color = color.white, text_size = size.small, bgcolor = #3b82f6)
    table.cell(dg, 1, 0, "count", text_color = color.white, text_size = size.small, bgcolor = #3b82f6)

    table.cell(dg, 0, 1, "Setups armed (break)", text_color = color.gray, text_size = size.small)
    table.cell(dg, 1, 1, str.tostring(nArm), text_color = color.silver, text_size = size.small)
    table.cell(dg, 0, 2, "Reached the reclaim", text_color = color.gray, text_size = size.small)
    table.cell(dg, 1, 2, str.tostring(nSeq3), text_color = color.silver, text_size = size.small)
    table.cell(dg, 0, 3, "FULL SEQUENCE completed", text_color = color.white, text_size = size.small)
    table.cell(dg, 1, 3, str.tostring(nRaw), text_color = color.yellow, text_size = size.small)

    table.cell(dg, 0, 4, "killed by: 4H bridge disagreed", text_color = color.gray, text_size = size.small)
    table.cell(dg, 1, 4, str.tostring(kBridge), text_color = color.orange, text_size = size.small)
    table.cell(dg, 0, 5, "killed by: no displacement", text_color = color.gray, text_size = size.small)
    table.cell(dg, 1, 5, str.tostring(kDisp), text_color = color.orange, text_size = size.small)
    table.cell(dg, 0, 6, "killed by: chopping", text_color = color.gray, text_size = size.small)
    table.cell(dg, 1, 6, str.tostring(kChop), text_color = color.orange, text_size = size.small)
    table.cell(dg, 0, 7, "killed by: wrong side of VWAP", text_color = color.gray, text_size = size.small)
    table.cell(dg, 1, 7, str.tostring(kVwap), text_color = color.orange, text_size = size.small)
    table.cell(dg, 0, 8, "killed by: past the 2 sigma band", text_color = color.gray, text_size = size.small)
    table.cell(dg, 1, 8, str.tostring(kExt), text_color = color.orange, text_size = size.small)
    table.cell(dg, 0, 9, "killed by: acceptance not held", text_color = color.gray, text_size = size.small)
    table.cell(dg, 1, 9, str.tostring(kHold), text_color = color.orange, text_size = size.small)
    table.cell(dg, 0, 10, "killed by: range budget spent", text_color = color.gray, text_size = size.small)
    table.cell(dg, 1, 10, str.tostring(kBudget), text_color = color.orange, text_size = size.small)
    table.cell(dg, 0, 11, "killed by: range-trap guard", text_color = color.gray, text_size = size.small)
    table.cell(dg, 1, 11, str.tostring(kTrap), text_color = color.orange, text_size = size.small)
    table.cell(dg, 0, 12, "killed by: 4 timeframes unaligned", text_color = color.gray, text_size = size.small)
    table.cell(dg, 1, 12, str.tostring(kAlign), text_color = color.orange, text_size = size.small)
    table.cell(dg, 0, 13, "killed by: outside session", text_color = color.gray, text_size = size.small)
    table.cell(dg, 1, 13, str.tostring(kSess), text_color = color.orange, text_size = size.small)
    table.cell(dg, 0, 14, "killed by: news blackout", text_color = color.gray, text_size = size.small)
    table.cell(dg, 1, 14, str.tostring(kNews), text_color = color.orange, text_size = size.small)
    table.cell(dg, 0, 15, "killed by: under 1R of room", text_color = color.gray, text_size = size.small)
    table.cell(dg, 1, 15, str.tostring(kRoom), text_color = color.orange, text_size = size.small)
    table.cell(dg, 0, 16, "killed by: score below minimum", text_color = color.gray, text_size = size.small)
    table.cell(dg, 1, 16, str.tostring(kScore), text_color = color.orange, text_size = size.small)
    table.cell(dg, 0, 17, "killed by: already traded today", text_color = color.gray, text_size = size.small)
    table.cell(dg, 1, 17, str.tostring(kDaily), text_color = color.orange, text_size = size.small)

    table.cell(dg, 0, 18, "SURVIVED EVERYTHING", text_color = color.white, text_size = size.small)
    table.cell(dg, 1, 18, str.tostring(nPass), text_color = #26a69a, text_size = size.small)

plotshape(raw, "Sequence complete", shape.circle, location.belowbar, color.new(color.yellow, 40), size = size.tiny)
plotshape(trigLong  and okToTrade, "Long",  shape.triangleup,   location.belowbar, color.new(#26a69a, 0), size = size.small)
plotshape(trigShort and okToTrade, "Short", shape.triangledown, location.abovebar, color.new(#ef5350, 0), size = size.small)
