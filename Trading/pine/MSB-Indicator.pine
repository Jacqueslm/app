//@version=6
// =============================================================================
//  MARKET STRUCTURE BRIDGE  —  Daily bias / 4H bridge / 1H execution
//  Apply this to a 1H chart. MNQ, MES, MGC.
//
//  THIS SCRIPT PREDICTS NOTHING. It listens: the Daily/4H say where the market
//  is trying to go (intent, already on record), the level says what it is
//  saying right now (acceptance or rejection, in closed candles). The trigger
//  is the moment the two agree — never a forecast. PLAYBOOK.md §1½.
//
//  STRUCTURE tells you WHERE. CONTEXT tells you WHETHER ANYONE IS THERE.
//  This script needs both to agree before it says a word. See INSTITUTIONAL.md.
//
//  The sequence:
//     ① Daily structure agrees with the direction         (permission)
//     ② 1H closes through a swing high/low                (the HH break)
//     ③ Price trades back through that level              (break back below)
//        ↳ bonus if it sweeps liquidity and reclaims      (absorption you can see)
//     ④ Price reclaims the level                          (back up to it)
//     ⑤ It HOLDS for 2+ bars                              (acceptance — the wait)
//     ⑥ 4H agrees + fresh 1H break with volume            (the trigger)
//
//  Hard gates: Daily bias · 4H bridge · not chopping · protected level intact ·
//              acceptance held · right side of VWAP · not past the 2σ band.
//  Quality:    13 points. 10+ = A+, 8-9 = B, below = no trade.
//
//  On top sits the professional read (PRO-ANALYSIS.md): yesterday's value area,
//  live day-type classification (trend vs balance), a daily range budget that
//  rejects late chases, and the volatility regime. Amateurs start with the
//  setup; this script starts with the day.
//
//  Every context filter is a toggle so you can backtest with and without them.
//  Do not take my word that they help. Measure it.
// =============================================================================

indicator("Market Structure Bridge", "MSB", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ─── Inputs ──────────────────────────────────────────────────────────────────
grpS = "Structure"
pvL      = input.int(3,    "Swing strength (left)",  minval = 1, maxval = 20, group = grpS)
pvR      = input.int(3,    "Swing strength (right)", minval = 1, maxval = 20, group = grpS,
     tooltip = "Bars required to the right before a swing confirms. Higher = slower but cleaner.")
biasTF   = input.timeframe("D",   "Bias timeframe",    group = grpS)
bridgeTF = input.timeframe("240", "Bridge timeframe",  group = grpS)
monTF    = input.timeframe("15",  "Monitor timeframe", group = grpS)

grpC = "Consolidation filter"
erLen    = input.int(20,     "Efficiency ratio length",   minval = 5,   group = grpC)
erMin    = input.float(0.30, "Chop if ER below",          minval = 0.0, maxval = 1.0, step = 0.01, group = grpC)
rngLen   = input.int(20,     "Range length",              minval = 5,   group = grpC)
rngMin   = input.float(3.0,  "Chop if range/ATR below",   minval = 0.5, step = 0.1, group = grpC)
adxMin   = input.float(18.0, "Chop if ADX below",         minval = 5.0, step = 0.5, group = grpC)
maxChop  = input.int(1,      "Max chop measures allowed", minval = 0, maxval = 3,   group = grpC)

grpI = "Institutional context"
useCtx   = input.bool(true,  "Apply context layer (master switch)", group = grpI,
     tooltip = "Turn OFF to backtest structure alone, ON to compare. This is how you verify the layer earns its place.")
useVwap  = input.bool(true,  "Gate: must be on the right side of VWAP",  group = grpI)
useExt   = input.bool(true,  "Gate: reject if stretched past the 2σ band", group = grpI)
vwapDev  = input.float(2.0,  "VWAP band (std dev)", minval = 0.5, step = 0.5, group = grpI)
rvolMin  = input.float(1.2,  "Point: RVOL at or above", minval = 0.1, step = 0.1, group = grpI,
     tooltip = "Volume vs the average for THIS HOUR OF DAY — not a flat moving average.")
holdBars = input.int(2,      "Bars price must hold the reclaim", minval = 1, maxval = 10, group = grpI)
reqHold  = input.bool(true,  "Gate: require acceptance before triggering", group = grpI,
     tooltip = "Step ⑤. A touch is a question; holding is the answer. Off = enter on the first close through.")
useSweep = input.bool(true,  "Point: reward a liquidity sweep on the pullback", group = grpI)
useRef   = input.bool(true,  "Point: reward confluence with a reference level", group = grpI)
refTolA  = input.float(0.5,  "Reference level tolerance (× ATR)", minval = 0.1, step = 0.1, group = grpI)
useCorr  = input.bool(true,  "Point: correlated instrument must agree", group = grpI,
     tooltip = "MNQ ↔ MES. For MGC either point this at silver/DXY or switch it off.")
corrSym  = input.symbol("CME_MINI:MES1!", "Correlated symbol", group = grpI)
corrLen  = input.int(5, "Correlation lookback (bars)", minval = 2, group = grpI)

grpP = "Professional read — the day, top down"
useBudget = input.bool(true, "Gate: reject when the range budget is spent", group = grpP,
     tooltip = "Kills the perfect-looking setup at 1:30pm, 240 points into a 250-point day. Nothing on the chart makes that trade look wrong — only the budget does.")
budgetMax = input.float(0.85, "Budget spent at (× daily ATR)", minval = 0.3, maxval = 2.0, step = 0.05, group = grpP)
useDayTp  = input.bool(true, "Point: day type agrees (not a balance day)", group = grpP,
     tooltip = "Your setup describes trend-day behaviour. On balance days the identical setup is the losing pattern.")
useVA     = input.bool(true, "Point: trading beyond yesterday's value", group = grpP,
     tooltip = "Initiative territory. The middle of yesterday's value is the market's definition of fair — fair means no edge.")
vaAccept  = input.int(2, "Closes beyond value = acceptance", minval = 1, maxval = 6, group = grpP)

grpM2 = "Manipulation guard — the range trap"
useTrap   = input.bool(true, "Gate: no breakout entries while the 4H is ranging", group = grpM2,
     tooltip = "A balanced HTF raids its own edges for stops before it trends. A breakout of a ranging 4H without acceptance is the trap, not the move.")
trapAccept = input.int(3, "Closes beyond the edge = real break", minval = 1, maxval = 10, group = grpM2,
     tooltip = "How many 1H closes beyond the 4H range edge before a break is trusted instead of suspected.")
trapBars  = input.int(6, "Snap back within N bars = fake-out", minval = 2, maxval = 20, group = grpM2)
useFuel   = input.bool(true, "Point: opposite edge was swept (fuel)", group = grpM2,
     tooltip = "A failed raid on the FAR edge means stops there were collected — fuel for the move toward you.")
fuelLook  = input.int(30, "Fuel counts for N bars", minval = 5, group = grpM2)
htfRngLen = input.int(20, "HTF range length (bars)", minval = 5, group = grpM2)
showTrap  = input.bool(true, "Mark fake-outs and range edges", group = grpM2)

grpZ = "Your zones & alignment"
useAlign = input.bool(true, "Gate: all four timeframes must align (D · 4H · 1H · 15m)", group = grpZ,
     tooltip = "Alignment is the thing that makes this strategy a go. If the four timeframes don't agree, executing is off the table — no score can override this.")
showZones = input.bool(true, "Show Daily + 4H supply/demand zones", group = grpZ)
zoneImp  = input.float(2.0, "Zone impulse (body vs 20-bar avg)", minval = 1.2, step = 0.1, group = grpZ,
     tooltip = "How explosive the move away must be for the base before it to count as a zone.")
cDem     = input.color(#2ecc71, "Demand", group = grpZ, inline = "z")
cSup     = input.color(#e74c3c, "Supply", group = grpZ, inline = "z")

grpN = "News blackout — your rule, on the clock"
useNews = input.bool(true, "Gate: weekly report blackout (Thu/Fri 08:30 ET)", group = grpN,
     tooltip = "The 7:30am Central weekly reports = 08:30 Eastern. No alerts in the window around them on Thu/Fri.")
newsSess = input.session("0800-0900:56", "Blackout window (:56 = Thu+Fri)", group = grpN,
     tooltip = "Times are Eastern. 0800-0900 covers the 08:30 release with 30 min either side.")
fomcDay = input.bool(false, "FOMC today — block the whole day (manual)", group = grpN,
     tooltip = "Pine cannot see the Fed calendar. Tick this on the ~8 FOMC Wednesdays a year (and untick after). The one news box only you can hold.")

grpT = "Trigger & grading"
dispMult = input.float(1.2, "Displacement (body vs 20-bar avg)", minval = 1.0, step = 0.1, group = grpT)
setupTO  = input.int(40,    "Setup expires after N bars", minval = 5, group = grpT)
minGrade = input.string("B", "Alert on grade", options = ["A+", "B"], group = grpT)
stopBuf  = input.float(0.15,"Stop buffer (× ATR)", minval = 0.0, step = 0.05, group = grpT)

grpX = "Session — New York only"
useSess = input.bool(true, "Only alert inside the tradeable window", group = grpX)
sessStr = input.session("0930-1500", "Tradeable window", group = grpX,
     tooltip = "MNQ/MES: 0930-1500. MGC: 0800-1300. Nothing fires outside this.")
primeStr = input.session("0930-1130", "Prime hours (earns a quality point)", group = grpX,
     tooltip = "MNQ/MES: 0930-1130. MGC: 0800-1200. Where most A+ setups live.")
rthStr  = input.session("0930-1600", "Regular hours (for IB / overnight)", group = grpX)
sessTZ  = input.string("America/New_York", "Timezone", group = grpX)

grpR = "Your rules — protect me from myself"
maxPerDay = input.int(1, "Max alerts per day", minval = 1, maxval = 5, group = grpR,
     tooltip = "One bullet. After it fires the system goes quiet until tomorrow. Zero-trade days are correct outcomes.")
partialR  = input.float(1.0, "First target (R) — take half here", minval = 0.5, step = 0.5, group = grpR,
     tooltip = "You like being right. This is where you get to be, in cash, early — without cutting the runner.")
scalpMax  = input.float(2.0, "SCALP if room below this (R)", minval = 1.0, step = 0.5, group = grpR)
holdMin   = input.float(3.5, "HOLD if room above this (R)",  minval = 2.0, step = 0.5, group = grpR)
minRoom   = input.float(1.0, "Reject if room below this (R)", minval = 0.5, step = 0.5, group = grpR,
     tooltip = "Entering into a wall. Looks identical to a good setup; there is just no money in it.")
tgtMinR  = input.float(0.5, "Ignore walls closer than this (R)", minval = 0.0, step = 0.1, group = grpR,
     tooltip = "A level a fraction of a stop away is noise, not a target. Measured: with every prior-day, overnight, 4H and Daily level treated as a wall, one is nearly always within a fraction of the stop, and the trade was rejected for no room. Look past those.")
tgtProj  = input.float(4.0, "Open-air target (ATR) when no wall exists", minval = 1.0, step = 0.5, group = grpR,
     tooltip = "When nothing stands above (a long) or below (a short), price is in open air - the cleanest case. The old fallback reached back to a 100-bar extreme sitting BEHIND price and scored it as no room, rejecting exactly those trades.")

grpF = "Prop firm guard"
propMode   = input.bool(false, "Prop evaluation mode — A+ only + risk cap", group = grpF,
     tooltip = "The eval trap is oversizing and overtrading to pass fast. This forces A+ only and caps risk so the trailing drawdown survives a real losing streak. See PROP-FIRMS.md.")
propDDLeft = input.float(2500, "Distance to drawdown limit ($) — update it daily", minval = 100, step = 50, group = grpF)
propStreak = input.int(8, "Must survive N straight losses", minval = 4, maxval = 20, group = grpF)

grpV = "Display"
showZone = input.bool(true,  "Show retest zone",     group = grpV)
showSwg  = input.bool(true,  "Show swing labels",    group = grpV)
showDash = input.bool(true,  "Show dashboard",       group = grpV)
showVwap = input.bool(true,  "Show VWAP + bands",    group = grpV)
showRef  = input.bool(false, "Show reference levels",group = grpV)
showVA   = input.bool(true,  "Show yesterday's value area", group = grpV)
cBull    = input.color(#26a69a, "Bullish", group = grpV, inline = "c")
cBear    = input.color(#ef5350, "Bearish", group = grpV, inline = "c")

// ─── Structure engine ────────────────────────────────────────────────────────
// A BOS requires a CLOSE beyond the swing — wicks never count.
f_structure() =>
    var float swingHi  = na
    var float swingLo  = na
    var float brokenHi = na
    var float brokenLo = na
    var float protLo   = na
    var float protHi   = na
    var int   trend    = 0

    ph = ta.pivothigh(high, pvL, pvR)
    pl = ta.pivotlow(low,  pvL, pvR)
    if not na(ph)
        swingHi := ph
    if not na(pl)
        swingLo := pl

    bUp = not na(swingHi) and close > swingHi
    bDn = not na(swingLo) and close < swingLo
    if bUp and bDn
        if close >= open
            bDn := false
        else
            bUp := false

    if bUp
        brokenHi := swingHi
        protLo   := swingLo
        trend    := 1
        swingHi  := na
    else if bDn
        brokenLo := swingLo
        protHi   := swingHi
        trend    := -1
        swingLo  := na

    [trend, brokenHi, brokenLo, protLo, protHi, bUp, bDn]

f_trend() =>
    [t, _bh, _bl, _pl, _ph, _bu, _bd] = f_structure()
    t

// Supply/demand zones: the base candle before an explosive departure. Demand = the
// last down-candle before a strong rally; supply = the last up-candle before a strong
// drop. A zone dies the moment price CLOSES through its far side — a broken zone is
// not "still kind of there," it's gone.
f_zone() =>
    var float demTop = na
    var float demBot = na
    var float supTop = na
    var float supBot = na
    avgB  = ta.sma(math.abs(close - open), 20)
    upImp = close > open and (close - open) > avgB * zoneImp
    dnImp = open > close and (open - close) > avgB * zoneImp
    if upImp and close[1] < open[1]
        demTop := math.max(open[1], close[1])
        demBot := low[1]
    if dnImp and close[1] > open[1]
        supBot := math.min(open[1], close[1])
        supTop := high[1]
    if not na(demBot) and close < demBot
        demTop := na
        demBot := na
    if not na(supTop) and close > supTop
        supTop := na
        supBot := na
    [demTop, demBot, supTop, supBot]

[xTrend, xBrokenHi, xBrokenLo, xProtLo, xProtHi, xBosUp, xBosDn] = f_structure()
biasTrend   = request.security(syminfo.tickerid, biasTF,   f_trend(), lookahead = barmerge.lookahead_off)
bridgeTrend = request.security(syminfo.tickerid, bridgeTF, f_trend(), lookahead = barmerge.lookahead_off)
m15Trend    = request.security(syminfo.tickerid, monTF,    f_trend(), lookahead = barmerge.lookahead_off)

// Your zones, from the two intent timeframes.
[dDemT, dDemB, dSupT, dSupB] = request.security(syminfo.tickerid, biasTF,   f_zone(), lookahead = barmerge.lookahead_off)
[hDemT, hDemB, hSupT, hSupB] = request.security(syminfo.tickerid, bridgeTF, f_zone(), lookahead = barmerge.lookahead_off)

// The alignment gate: D · 4H · 1H · 15m all pointing the same way, or no execution.
alignL = not useAlign or (biasTrend ==  1 and bridgeTrend ==  1 and xTrend ==  1 and m15Trend ==  1)
alignS = not useAlign or (biasTrend == -1 and bridgeTrend == -1 and xTrend == -1 and m15Trend == -1)
fullAlign = (biasTrend == 1 and bridgeTrend == 1 and xTrend == 1 and m15Trend == 1) or
     (biasTrend == -1 and bridgeTrend == -1 and xTrend == -1 and m15Trend == -1)

// ─── Consolidation filter ────────────────────────────────────────────────────
f_chop() =>
    atr14  = ta.atr(14)
    move   = math.abs(close - close[erLen])
    path   = math.sum(math.abs(close - close[1]), erLen)
    er     = path > 0 ? move / path : 0.0
    rng    = ta.highest(high, rngLen) - ta.lowest(low, rngLen)
    rngAtr = atr14 > 0 ? rng / atr14 : 0.0
    [_dip, _dim, adxv] = ta.dmi(14, 14)
    n = (er < erMin ? 1 : 0) + (rngAtr < rngMin ? 1 : 0) + (adxv < adxMin ? 1 : 0)
    [n, er, rngAtr, adxv]

f_chopN() =>
    [n, _e, _r, _a] = f_chop()
    n

[chopN, erVal, rngAtrVal, adxVal] = f_chop()
monChopN = request.security(syminfo.tickerid, monTF, f_chopN(), lookahead = barmerge.lookahead_off)
chopOK   = chopN <= maxChop and monChopN <= maxChop

// =============================================================================
//  INSTITUTIONAL CONTEXT
// =============================================================================

// ─── VWAP + bands ────────────────────────────────────────────────────────────
// The benchmark execution algos are actually graded against. Buy-side algos want
// fills at or below it; stretched far above it is where they become sellers.
newDay = timeframe.change("D")
[vwapV, vwapUp, vwapDn] = ta.vwap(hlc3, newDay, vwapDev)

vwapSideL = not useCtx or not useVwap or (not na(vwapV) and close > vwapV)
vwapSideS = not useCtx or not useVwap or (not na(vwapV) and close < vwapV)
notExtL   = not useCtx or not useExt  or (na(vwapUp) or close < vwapUp)
notExtS   = not useCtx or not useExt  or (na(vwapDn) or close > vwapDn)

// ─── Relative volume, by hour of day ─────────────────────────────────────────
// Comparing the 10:00 bar to the 13:00 bar with a flat average tells you nothing.
// This compares each hour to its own history. Read BEFORE updating — no lookahead.
var array<float> hvSum = array.new_float(24, 0.0)
var array<int>   hvCnt = array.new_int(24, 0)
hrIdx  = hour(time, sessTZ)
hvN    = array.get(hvCnt, hrIdx)
hvMean = hvN > 0 ? array.get(hvSum, hrIdx) / hvN : na
rvol   = not na(hvMean) and hvMean > 0 and not na(volume) ? volume / hvMean : 1.0
if barstate.isconfirmed and not na(volume)
    array.set(hvSum, hrIdx, array.get(hvSum, hrIdx) + volume)
    array.set(hvCnt, hrIdx, hvN + 1)
rvolOK = not useCtx or rvol >= rvolMin

// ─── Reference levels ────────────────────────────────────────────────────────
// Prior day values via [1] + lookahead_on: the standard non-repainting idiom.
pdh = request.security(syminfo.tickerid, "D", high[1],  lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],   lookahead = barmerge.lookahead_on)
pdc = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)

inRth = not na(time(timeframe.period, rthStr, sessTZ))
var float ibH = na
var float ibL = na
var float onH = na
var float onL = na
if inRth and not inRth[1]           // first bar of the regular session = initial balance
    ibH := high
    ibL := low
if not inRth
    if inRth[1]                     // just left RTH — start a fresh overnight range
        onH := high
        onL := low
    else
        onH := math.max(nz(onH, high), high)
        onL := math.min(nz(onL, low),  low)

atr = ta.atr(14)
f_near(float lvl, float ref, float tol) => not na(lvl) and not na(ref) and math.abs(lvl - ref) <= tol

// ─── The professional read: value, day type, range budget, regime ────────────
// Yesterday's value area ≈ prior day's final VWAP ± 1σ (captures ~70% of the
// activity, same as a Market Profile value area — an approximation, a sound one).
[vaMid, vaHiRun, vaLoRun] = ta.vwap(hlc3, newDay, 1.0)
var float pPoc = na
var float pVah = na
var float pVal = na
var float dayOpenPx = na
if newDay
    pPoc      := vaMid[1]
    pVah      := vaHiRun[1]
    pVal      := vaLoRun[1]
    dayOpenPx := open

// Day type by ACCEPTANCE beyond value — closes, not pokes. Late by design: it will
// miss the first hour of some trend days, and not be fooled on the many balance days.
var int vaAboveCnt = 0
var int vaBelowCnt = 0
vaAboveCnt := not na(pVah) and close > pVah ? vaAboveCnt + 1 : 0
vaBelowCnt := not na(pVal) and close < pVal ? vaBelowCnt + 1 : 0
dayType = vaAboveCnt >= vaAccept ? 1 : vaBelowCnt >= vaAccept ? -1 : 0

// Range budget: how much of a normal day's travel is already spent in each direction.
// Yesterday's daily ATR via [1] + lookahead_on — the non-repainting idiom.
dAtr = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead = barmerge.lookahead_on)
var float tdHi = na
var float tdLo = na
if newDay
    tdHi := high
    tdLo := low
else
    tdHi := math.max(nz(tdHi, high), high)
    tdLo := math.min(nz(tdLo, low),  low)
usedUpLong  = not na(dAtr) and dAtr > 0 ? (close - tdLo) / dAtr : 0.0   // spent off the low
usedUpShort = not na(dAtr) and dAtr > 0 ? (tdHi - close) / dAtr : 0.0   // spent off the high
budgetOKL = not useCtx or not useBudget or usedUpLong  <= budgetMax
budgetOKS = not useCtx or not useBudget or usedUpShort <= budgetMax

// Volatility regime — the weather report. Display and expectations, not a gate:
// sizing and the chop filter already act on it mechanically.
atrBase  = ta.sma(atr, 100)
volRegime = na(atrBase) or atrBase == 0 ? "—" : atr > atrBase * 1.3 ? "HIGH" : atr < atrBase * 0.7 ? "LOW" : "NORMAL"

// ─── Manipulation guard: the range trap ──────────────────────────────────────
// Balance one rung up = the bridge TF chopping. Its edges hold the resting stops,
// and a balanced market raids BOTH edges for fuel before it trends. A break of a
// ranging 4H is suspected until it earns acceptance; a failed raid on the far
// edge is collected fuel for the move toward you. See INSTITUTIONAL.md.
htfChopN = request.security(syminfo.tickerid, bridgeTF, f_chopN(), lookahead = barmerge.lookahead_off)
htfRngHi = request.security(syminfo.tickerid, bridgeTF, ta.highest(high, htfRngLen)[1], lookahead = barmerge.lookahead_off)
htfRngLo = request.security(syminfo.tickerid, bridgeTF, ta.lowest(low,  htfRngLen)[1],  lookahead = barmerge.lookahead_off)
htfRanging = htfChopN >= 2

// Acceptance beyond the edge, counted in execution-TF closes.
var int edgeUpCnt = 0
var int edgeDnCnt = 0
edgeUpCnt := not na(htfRngHi) and close > htfRngHi ? edgeUpCnt + 1 : 0
edgeDnCnt := not na(htfRngLo) and close < htfRngLo ? edgeDnCnt + 1 : 0

// A fake-out completes when the count resets: it poked beyond, stayed briefly, closed back inside.
trapUp = htfRanging and edgeUpCnt == 0 and edgeUpCnt[1] > 0 and edgeUpCnt[1] <= trapBars
trapDn = htfRanging and edgeDnCnt == 0 and edgeDnCnt[1] > 0 and edgeDnCnt[1] <= trapBars

var int lastTrapUpBar = na
var int lastTrapDnBar = na
if trapUp
    lastTrapUpBar := bar_index
if trapDn
    lastTrapDnBar := bar_index
// Fuel for a LONG = the LOW edge was raided and failed: sell-stops collected below.
fuelLong  = not na(lastTrapDnBar) and bar_index - lastTrapDnBar <= fuelLook
fuelShort = not na(lastTrapUpBar) and bar_index - lastTrapUpBar <= fuelLook

// The gate: while the 4H ranges, a trigger BEYOND its edge needs acceptance first.
trapGateL = not useCtx or not useTrap or not htfRanging or not (not na(htfRngHi) and close > htfRngHi) or edgeUpCnt >= trapAccept
trapGateS = not useCtx or not useTrap or not htfRanging or not (not na(htfRngLo) and close < htfRngLo) or edgeDnCnt >= trapAccept

// ─── Correlated instrument ───────────────────────────────────────────────────
corrClose = request.security(corrSym, timeframe.period, close, lookahead = barmerge.lookahead_off)
corrChg   = corrClose - corrClose[corrLen]
ownChg    = close - close[corrLen]
corrAgree = not useCtx or not useCorr or (not na(corrChg) and math.sign(corrChg) == math.sign(ownChg))

// ─── Higher-timeframe swing levels (what a HOLD is aiming at) ────────────────
f_lastPivotHi() =>
    var float p = na
    v = ta.pivothigh(high, pvL, pvR)
    if not na(v)
        p := v
    p
f_lastPivotLo() =>
    var float p = na
    v = ta.pivotlow(low, pvL, pvR)
    if not na(v)
        p := v
    p

h4Hi = request.security(syminfo.tickerid, bridgeTF, f_lastPivotHi(), lookahead = barmerge.lookahead_off)
h4Lo = request.security(syminfo.tickerid, bridgeTF, f_lastPivotLo(), lookahead = barmerge.lookahead_off)
dHi  = request.security(syminfo.tickerid, biasTF,   f_lastPivotHi(), lookahead = barmerge.lookahead_off)
dLo  = request.security(syminfo.tickerid, biasTF,   f_lastPivotLo(), lookahead = barmerge.lookahead_off)

// Keep the NEAREST level on the far side of the trade — that's the realistic target,
// and the distance to it is what decides scalp vs hold.
f_pickAbove(float cur, float lvl, float px) =>
    not na(lvl) and lvl > px ? (na(cur) ? lvl : math.min(cur, lvl)) : cur
f_pickBelow(float cur, float lvl, float px) =>
    not na(lvl) and lvl < px ? (na(cur) ? lvl : math.max(cur, lvl)) : cur

// ─── Session ─────────────────────────────────────────────────────────────────
inSess  = not useSess or not na(time(timeframe.period, sessStr, sessTZ))
// Your news rule, mechanical: outside the Thu/Fri report window, and not an FOMC day.
newsOK = not useNews or (na(time(timeframe.period, newsSess, sessTZ)) and not fomcDay)
inPrime = not na(time(timeframe.period, primeStr, sessTZ))

// ─── Shared series (never call ta.* conditionally) ───────────────────────────
avgBody = ta.sma(math.abs(close - open), 20)
disp    = math.abs(close - open) >= avgBody * dispMult
// The gate requires displacement, so rewarding the same threshold would score on every
// trigger and discriminate nothing. The POINT needs a genuinely stronger candle.
dispStrong = math.abs(close - open) >= avgBody * dispMult * 1.5
phG     = ta.pivothigh(high, pvL, pvR)
plG     = ta.pivotlow(low,  pvL, pvR)
hi100   = ta.highest(high, 100)[1]
lo100   = ta.lowest(low, 100)[1]

// ─── Setup state machine ─────────────────────────────────────────────────────
// 0 idle · 1 armed (BOS printed) · 2 traded back through · 3 reclaimed, waiting
var int   st       = 0
var int   stDir    = 0
var float zone     = na     // the HH break level being retested
var float prot     = na     // protected low/high — lose it and the setup is dead
var int   stBars   = 0
var int   touches  = 0
var bool  cleanRt  = true
var float pullExt  = na     // deepest point of the pullback (used for the stop)
var float trigLvl  = na     // reclaim candle's extreme — the level to close through
var bool  swept    = false  // did the pullback take liquidity and reclaim it?
var int   heldBars = 0      // closes holding beyond the level since the reclaim

armLong  = xBosUp and biasTrend ==  1
armShort = xBosDn and biasTrend == -1
armedNow = armLong or armShort

// The protected level falls back to the breakout candle's own extreme when no swing
// has confirmed yet — otherwise a setup can arm with no invalidation level at all.
if armLong
    st       := 1
    stDir    := 1
    zone     := xBrokenHi
    prot     := na(xProtLo) ? low : xProtLo
    stBars   := 0
    touches  := 0
    cleanRt  := true
    pullExt  := low
    trigLvl  := na
    swept    := false
    heldBars := 0
else if armShort
    st       := 1
    stDir    := -1
    zone     := xBrokenLo
    prot     := na(xProtHi) ? high : xProtHi
    stBars   := 0
    touches  := 0
    cleanRt  := true
    pullExt  := high
    trigLvl  := na
    swept    := false
    heldBars := 0
else if st > 0
    stBars += 1

// Progress the sequence — longs.
// `not armedNow` matters: the breakout candle's own low sits below the level it just
// broke, so without this guard every setup would jump straight to ③ on the arming bar.
if st > 0 and stDir == 1 and not armedNow
    // Liquidity sweep: a NEW pullback low that closes back above the old one, in the
    // upper half of its range. Measured against the pullback's own low, not a fixed
    // window — a fixed window reaches back past the breakout and never triggers.
    prevExt = pullExt
    pullExt := math.min(pullExt, low)
    if st == 2 and not na(prevExt) and low < prevExt and close > prevExt and close > (high + low) / 2
        swept := true
    if st == 1 and low < zone                  // ③ traded back below the level
        st := 2
    else if st == 2 and close > zone           // ④ reclaimed it
        st       := 3
        touches  := touches + 1
        trigLvl  := high                       // ⑤ now wait for a close above this
        heldBars := 0
    else if st == 3
        if close < zone                        // fell back through — rejection, not acceptance
            st       := 2
            cleanRt  := false
            heldBars := 0
        else
            heldBars += 1

// Progress the sequence — shorts
if st > 0 and stDir == -1 and not armedNow
    prevExt = pullExt
    pullExt := math.max(pullExt, high)
    if st == 2 and not na(prevExt) and high > prevExt and close < prevExt and close < (high + low) / 2
        swept := true
    if st == 1 and high > zone
        st := 2
    else if st == 2 and close < zone
        st       := 3
        touches  := touches + 1
        trigLvl  := low
        heldBars := 0
    else if st == 3
        if close > zone
            st       := 2
            cleanRt  := false
            heldBars := 0
        else
            heldBars += 1

// Invalidation: protected level lost, bias flipped, or the setup went stale.
invalid = st > 0 and (
     (stDir ==  1 and ((not na(prot) and close < prot) or biasTrend == -1)) or
     (stDir == -1 and ((not na(prot) and close > prot) or biasTrend ==  1)) or
     stBars > setupTO)
if invalid
    st      := 0
    stDir   := 0
    zone    := na
    prot    := na
    trigLvl := na

// ─── Reference-level confluence for the active zone ──────────────────────────
refTol = atr * refTolA
f_inZone(float lvl, float top, float bot, float tol) =>
    not na(lvl) and not na(top) and not na(bot) and lvl >= bot - tol and lvl <= top + tol
refHit = f_near(zone, pdh, refTol) or f_near(zone, pdl, refTol) or f_near(zone, pdc, refTol) or
     f_near(zone, onH, refTol) or f_near(zone, onL, refTol) or
     f_near(zone, ibH, refTol) or f_near(zone, ibL, refTol) or
     f_inZone(zone, dDemT, dDemB, refTol) or f_inZone(zone, dSupT, dSupB, refTol) or
     f_inZone(zone, hDemT, hDemB, refTol) or f_inZone(zone, hSupT, hSupB, refTol)
refOK = not useCtx or not useRef or refHit

// Acceptance gate — step ⑤. The market answering the question the touch asked.
acceptOK = not reqHold or heldBars >= holdBars

// ─── Trigger ─────────────────────────────────────────────────────────────────
// ⑥ close through the reclaim candle, with body, bridge agreeing, context clear.
trigLong  = st == 3 and stDir ==  1 and bridgeTrend ==  1 and not na(trigLvl) and
     close > trigLvl and disp and chopOK and vwapSideL and notExtL and acceptOK and budgetOKL and trapGateL and alignL
trigShort = st == 3 and stDir == -1 and bridgeTrend == -1 and not na(trigLvl) and
     close < trigLvl and disp and chopOK and vwapSideS and notExtS and acceptOK and budgetOKS and trapGateS and alignS
anyTrig = trigLong or trigShort

// ─── Trade levels ────────────────────────────────────────────────────────────
entry   = close
stopRaw = trigLong  ? math.min(nz(pullExt, low),  nz(zone, low))  - atr * stopBuf :
          trigShort ? math.max(nz(pullExt, high), nz(zone, high)) + atr * stopBuf : na
riskPts = na(stopRaw) ? na : math.abs(entry - stopRaw)

// The nearest opposing HTF level is the realistic target, and the distance to it in R
// is what decides scalp vs hold. hi100/lo100 is only a fallback if nothing is in the way.
// A wall closer than a fraction of the stop is not a target, it is noise on the way.
tgtFloorUp = entry + nz(riskPts, 0) * tgtMinR
tgtFloorDn = entry - nz(riskPts, 0) * tgtMinR
tgtUp = f_pickAbove(float(na), h4Hi, tgtFloorUp)
tgtUp := f_pickAbove(tgtUp, dHi, tgtFloorUp)
tgtUp := f_pickAbove(tgtUp, pdh, tgtFloorUp)
tgtUp := f_pickAbove(tgtUp, onH, tgtFloorUp)
tgtDn = f_pickBelow(float(na), h4Lo, tgtFloorDn)
tgtDn := f_pickBelow(tgtDn, dLo, tgtFloorDn)
tgtDn := f_pickBelow(tgtDn, pdl, tgtFloorDn)
tgtDn := f_pickBelow(tgtDn, onL, tgtFloorDn)

htfTgt = trigLong ? nz(tgtUp, entry + atr * tgtProj) : nz(tgtDn, entry - atr * tgtProj)
roomR  = not na(riskPts) and riskPts > 0 ? math.abs(htfTgt - entry) / riskPts : 0.0

// T1 is where you get to be right, in cash. T2 is what pays for the losers.
t1   = na(riskPts) ? na : trigLong ? entry + riskPts * partialR : entry - riskPts * partialR
plan = roomR < minRoom  ? "NO TRADE" :
       roomR < scalpMax ? "SCALP"    :
       roomR < holdMin  ? "STANDARD" : "HOLD"
t2   = plan == "SCALP" ? t1 : htfTgt

// ─── Grading — 12 points ─────────────────────────────────────────────────────
pFirst = touches <= 1                       // first retest, not the third
pHold  = cleanRt and heldBars >= holdBars   // ACCEPTANCE — the reason you wait
pDisp  = dispStrong                         // a genuinely strong candle, not just past the gate
pRvol  = rvolOK                             // participation — is anyone actually there
pSweep = not useCtx or not useSweep or swept // absorption you can see
pRef   = refOK                              // the whole market is watching this level
pCorr  = corrAgree                          // market flow, not one chart's noise
pSess  = inPrime                            // prime hours, not merely open
pChop  = chopN == 0
pRoom  = roomR >= 3.0
// A continuation setup on a balance day is the losing pattern wearing the winning one's clothes.
pDayTp = not useCtx or not useDayTp or (trigLong ? dayType == 1 : trigShort ? dayType == -1 : false)
// Beyond yesterday's value = initiative territory. The middle of value is "fair" — no edge.
pVAout = not useCtx or not useVA or (trigLong ? (not na(pVah) and close > pVah) :
     trigShort ? (not na(pVal) and close < pVal) : false)
// Liquidity fuel: the far edge of the HTF range was raided and failed — stops collected.
pFuel  = not useCtx or not useFuel or (trigLong ? fuelLong : trigShort ? fuelShort : false)

score = (pFirst ? 1 : 0) + (pHold ? 1 : 0) + (pDisp ? 1 : 0) + (pRvol ? 1 : 0) +
     (pSweep ? 1 : 0) + (pRef ? 1 : 0) + (pCorr ? 1 : 0) + (pSess ? 1 : 0) +
     (pChop ? 1 : 0) + (pRoom ? 1 : 0) + (pDayTp ? 1 : 0) + (pVAout ? 1 : 0) +
     (pFuel ? 1 : 0)

grade   = score >= 10 ? "A+" : score >= 8 ? "B" : "C"
// Prop guard: risk capped so the drawdown survives a real losing streak, A+ only.
propCap = propDDLeft / propStreak
propR1  = not na(riskPts) ? riskPts * syminfo.pointvalue : na
propQty = propMode and not na(propR1) and propR1 > 0 ? math.floor(propCap / propR1) : na
propOK  = not propMode or (not na(propQty) and propQty >= 1)
// Quality percent = confluence, NOT win probability. Nobody can print a real win
// probability from a chart — your journal computes the real one from your trades.
qualPct = math.round(score / 13.0 * 100)
gradeOK = grade == "A+" or (not propMode and minGrade == "B" and grade == "B")

// ─── One bullet a day ────────────────────────────────────────────────────────
// na(lastAlertDay) first — `dayofmonth != na` is na, never true, so without it the
// counter would never reset and one trade per day would become one per lifetime.
var int firedToday   = 0
var int lastAlertDay = na
if na(lastAlertDay) or dayofmonth != lastAlertDay
    firedToday   := 0
    lastAlertDay := dayofmonth
bulletsLeft = maxPerDay - firedToday

fire = anyTrig and gradeOK and plan != "NO TRADE" and inSess and newsOK and propOK and
     bulletsLeft > 0 and barstate.isconfirmed
if fire
    firedToday += 1

// ─── Drawing ─────────────────────────────────────────────────────────────────
plot(showVwap ? vwapV  : na, "VWAP",    color.new(color.orange, 0),  1)
plot(showVwap ? vwapUp : na, "VWAP +σ", color.new(color.orange, 65), 1)
plot(showVwap ? vwapDn : na, "VWAP −σ", color.new(color.orange, 65), 1)
plot(showVA ? pVah : na, "Yesterday VAH", color.new(color.aqua, 55), 1, plot.style_circles)
plot(showVA ? pPoc : na, "Yesterday POC", color.new(color.aqua, 30), 1, plot.style_circles)
plot(showVA ? pVal : na, "Yesterday VAL", color.new(color.aqua, 55), 1, plot.style_circles)
plot(showRef ? pdh : na, "Prior day high", color.new(color.purple, 40), 1, plot.style_circles)
plot(showRef ? pdl : na, "Prior day low",  color.new(color.purple, 40), 1, plot.style_circles)
plot(showRef ? onH : na, "Overnight high", color.new(color.teal, 50),   1, plot.style_circles)
plot(showRef ? onL : na, "Overnight low",  color.new(color.teal, 50),   1, plot.style_circles)

plot(showTrap and htfRanging ? htfRngHi : na, "4H range high (stops above)", color.new(color.red, 45), 1, plot.style_circles)
plot(showTrap and htfRanging ? htfRngLo : na, "4H range low (stops below)",  color.new(color.red, 45), 1, plot.style_circles)
plotshape(showTrap and trapUp, "Fake-out high", shape.diamond, location.abovebar, color.new(color.red, 0), size = size.tiny,
     text = "TRAP", textcolor = color.new(color.red, 20))
plotshape(showTrap and trapDn, "Fake-out low",  shape.diamond, location.belowbar, color.new(color.red, 0), size = size.tiny,
     text = "TRAP", textcolor = color.new(color.red, 20))

var box zoneBox = na
if showZone and st > 0 and not na(zone)
    if na(zoneBox)
        zoneBox := box.new(bar_index, zone, bar_index, zone,
             border_color = color.new(color.gray, 40), bgcolor = color.new(color.gray, 88))
    box.set_right(zoneBox, bar_index + 3)
    box.set_top(zoneBox, zone + atr * 0.10)
    box.set_bottom(zoneBox, zone - atr * 0.10)
    box.set_bgcolor(zoneBox, color.new(stDir == 1 ? cBull : cBear, st == 3 ? 78 : 90))
if st == 0 and not na(zoneBox)
    box.delete(zoneBox)
    zoneBox := na

if showSwg and not na(phG)
    label.new(bar_index - pvR, high[pvR], "H", style = label.style_label_down,
         color = color.new(cBear, 70), textcolor = color.white, size = size.tiny)
if showSwg and not na(plG)
    label.new(bar_index - pvR, low[pvR], "L", style = label.style_label_up,
         color = color.new(cBull, 70), textcolor = color.white, size = size.tiny)

plotshape(xBosUp, "BOS up",   shape.triangleup,   location.belowbar, cBull, size = size.tiny)
plotshape(xBosDn, "BOS down", shape.triangledown, location.abovebar, cBear, size = size.tiny)
plotshape(swept and not swept[1], "Liquidity sweep", shape.xcross, location.belowbar,
     color.new(color.yellow, 0), size = size.tiny)

if fire
    label.new(bar_index, trigLong ? low - atr : high + atr,
         (trigLong ? "▲ LONG " : "▼ SHORT ") + grade + "  " + str.tostring(score) + "/13 · " + str.tostring(qualPct) + "%\n" +
              plan + "  " + str.tostring(roomR, "#.0") + "R room",
         style = trigLong ? label.style_label_up : label.style_label_down,
         color = trigLong ? cBull : cBear, textcolor = color.white, size = size.small)
    line.new(bar_index, entry,   bar_index + 12, entry,   color = color.blue, width = 1)
    line.new(bar_index, stopRaw, bar_index + 12, stopRaw, color = cBear, width = 1, style = line.style_dashed)
    line.new(bar_index, t1,      bar_index + 12, t1,      color = cBull, width = 1, style = line.style_dashed)
    line.new(bar_index, t2,      bar_index + 12, t2,      color = color.new(cBull, 45), width = 1, style = line.style_dotted)

// ─── Your zones: green demand, red supply, Daily + 4H ────────────────────────
f_zoneBox(box b, float top, float bot, color zc, string txt) =>
    box r = b
    if na(top) or na(bot)
        if not na(r)
            box.delete(r)
            r := na
        r
    else
        if na(r)
            r := box.new(bar_index - 60, top, bar_index + 15, bot,
                 border_color = color.new(zc, 45), bgcolor = color.new(zc, 86),
                 text = txt, text_color = color.new(zc, 15), text_size = size.tiny,
                 text_halign = text.align_right)
        box.set_lefttop(r, bar_index - 60, top)
        box.set_rightbottom(r, bar_index + 15, bot)
        box.set_text(r, txt)
        r

var box bDDem = na
var box bDSup = na
var box bHDem = na
var box bHSup = na
if barstate.islast
    bDDem := f_zoneBox(bDDem, showZones ? dDemT : na, showZones ? dDemB : na, cDem, "D demand")
    bDSup := f_zoneBox(bDSup, showZones ? dSupT : na, showZones ? dSupB : na, cSup, "D supply")
    bHDem := f_zoneBox(bHDem, showZones ? hDemT : na, showZones ? hDemB : na, cDem, "4H demand")
    bHSup := f_zoneBox(bHSup, showZones ? hSupT : na, showZones ? hSupB : na, cSup, "4H supply")

// ─── Dashboard ───────────────────────────────────────────────────────────────
f_txt(int t) => t == 1 ? "BULL" : t == -1 ? "BEAR" : "—"
f_col(int t) => t == 1 ? cBull  : t == -1 ? cBear  : color.gray
f_yn(bool b)  => b ? "✓" : "✗"
f_alChr(int t) => t == 1 ? "▲" : t == -1 ? "▼" : "·"
f_ync(bool b) => b ? cBull : cBear

var table dash = table.new(position.top_right, 2, 20,
     border_width = 1, border_color = color.new(color.gray, 60))
if showDash and barstate.islast
    stName = st == 0 ? "IDLE" : st == 1 ? "① BOS — armed" : st == 2 ? "② back through" :
         "③ held " + str.tostring(heldBars) + "/" + str.tostring(holdBars)
    vwSide = na(vwapV) ? "—" : close > vwapV ? "above" : "below"
    dtTxt  = dayType == 1 ? "TREND ↑" : dayType == -1 ? "TREND ↓" : "BALANCE"
    vaTxt  = na(pVah) or na(pVal) ? "—" : close > pVah ? "above value" : close < pVal ? "below value" : "inside value"
    // Show the budget for the direction the day is leaning; both if undecided.
    budTxt = na(dAtr) or dAtr == 0 ? "—" :
         dayType == -1 ? str.tostring(usedUpShort * 100, "#") + "% ↓" :
         dayType == 1  ? str.tostring(usedUpLong * 100, "#") + "% ↑" :
         str.tostring(usedUpLong * 100, "#") + "%↑ " + str.tostring(usedUpShort * 100, "#") + "%↓"
    budHot = math.max(usedUpLong, usedUpShort) > budgetMax
    table.cell(dash, 0, 0, "MSB", text_color = color.white, bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(dash, 1, 0, syminfo.ticker + (useCtx ? " +ctx" : ""), text_color = color.white,
         bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(dash, 0, 1, "Bias " + biasTF, text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 1, f_txt(biasTrend), text_color = f_col(biasTrend), text_size = size.small)
    table.cell(dash, 0, 2, "Bridge " + bridgeTF, text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 2, f_txt(bridgeTrend), text_color = f_col(bridgeTrend), text_size = size.small)
    table.cell(dash, 0, 3, "Exec " + timeframe.period, text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 3, f_txt(xTrend), text_color = f_col(xTrend), text_size = size.small)
    table.cell(dash, 0, 4, "Chop 1H/15m", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 4, str.tostring(chopN) + " / " + str.tostring(monChopN),
         text_color = chopOK ? cBull : cBear, text_size = size.small)
    table.cell(dash, 0, 5, "VWAP", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 5, vwSide, text_color = color.silver, text_size = size.small)
    table.cell(dash, 0, 6, "RVOL (this hr)", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 6, str.tostring(rvol, "#.00"),
         text_color = rvol >= rvolMin ? cBull : rvol < 0.8 ? cBear : color.silver, text_size = size.small)
    table.cell(dash, 0, 7, "Swept liquidity", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 7, f_yn(swept), text_color = f_ync(swept), text_size = size.small)
    table.cell(dash, 0, 8, "At ref level", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 8, f_yn(refHit), text_color = f_ync(refHit), text_size = size.small)
    table.cell(dash, 0, 9, "Correlation", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 9, f_yn(corrAgree), text_color = f_ync(corrAgree), text_size = size.small)
    table.cell(dash, 0, 10, "Day type", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 10, dtTxt, text_color = f_col(dayType), text_size = size.small)
    table.cell(dash, 0, 11, "Vs yest. value", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 11, vaTxt, text_color = color.silver, text_size = size.small)
    table.cell(dash, 0, 12, "Range budget", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 12, budTxt, text_color = budHot ? cBear : color.silver, text_size = size.small)
    table.cell(dash, 0, 13, "Bridge range", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 13, htfRanging ? "BALANCE — edges hot" : "trending",
         text_color = htfRanging ? color.orange : cBull, text_size = size.small)
    table.cell(dash, 0, 17, "Align D·4H·1H·15m", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 17, f_alChr(biasTrend) + " " + f_alChr(bridgeTrend) + " " + f_alChr(xTrend) + " " + f_alChr(m15Trend),
         text_color = fullAlign ? cBull : cBear, text_size = size.small)
    table.cell(dash, 0, 18, "Vol regime", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 18, volRegime, text_color = volRegime == "HIGH" ? color.orange :
         volRegime == "LOW" ? color.gray : color.silver, text_size = size.small)
    table.cell(dash, 0, 14, "Setup", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 14, stName, text_color = st == 3 ? color.yellow : color.silver, text_size = size.small)
    table.cell(dash, 0, 15, "Session", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 15, inSess ? (inPrime ? "PRIME" : "open") : "closed",
         text_color = inPrime ? cBull : inSess ? color.silver : color.gray, text_size = size.small)
    table.cell(dash, 0, 16, "Bullets left", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 16, str.tostring(bulletsLeft) + " / " + str.tostring(maxPerDay),
         text_color = bulletsLeft > 0 ? cBull : cBear, text_size = size.small)
    table.cell(dash, 0, 19, "Prop guard", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 19, propMode ? "$" + str.tostring(propDDLeft, "#") + " → cap $" + str.tostring(propCap, "#") + "/trade" : "off",
         text_color = propMode ? color.orange : color.gray, text_size = size.small)

// ─── Alerts ──────────────────────────────────────────────────────────────────
if fire
    string exitPlan = "Half at T1, stop to break-even, TRAIL the rest on the 15m to T2."
    if plan == "SCALP"
        exitPlan := "Single target at T1. Full exit. Done for the day."
    if plan == "STANDARD"
        exitPlan := "Half at T1, stop to break-even, rest at T2."
    dtA  = dayType == 1 ? "TREND ↑" : dayType == -1 ? "TREND ↓" : "BALANCE day"
    budA = str.tostring((trigLong ? usedUpLong : usedUpShort) * 100, "#") + "% of range budget used"
    alert(syminfo.ticker + " " + (trigLong ? "LONG" : "SHORT") + " " + grade +
         " (" + str.tostring(score) + "/13 · " + str.tostring(qualPct) + "% quality) — " + plan +
         "\n" + dtA + " | " + budA + " | vol " + volRegime +
         "\nentry " + str.tostring(entry,   format.mintick) +
         " | stop " + str.tostring(stopRaw, format.mintick) +
         " | risk " + str.tostring(riskPts, format.mintick) + " pts" +
         "\nT1 "    + str.tostring(t1, format.mintick) + " (" + str.tostring(partialR, "#.#") + "R)" +
         " | T2 "   + str.tostring(t2, format.mintick) +
         " | room " + str.tostring(roomR, "#.0") + "R" +
         " | RVOL " + str.tostring(rvol, "#.0") + (swept ? " | swept" : "") + ((trigLong ? fuelLong : fuelShort) ? " | fuel: far edge raided" : "") + (useNews ? " | news ✓" : "") +
         "\n" + exitPlan +
         (propMode ? "\nPROP: cap " + str.tostring(propQty) + " contracts ($" + str.tostring(propCap, "#") + " max risk, survives " + str.tostring(propStreak) + " straight losses)" : "") +
         "\nBracket goes in as ONE action. That is your last bullet today.",
         alert.freq_once_per_bar_close)

alertcondition(st == 3 and st[1] != 3, "Level reclaimed — watch for the trigger",
     "MSB: level reclaimed. Now waiting to see if it HOLDS.")

// ─── Fallback full-signal alert (for alert dialogs without "Any alert() function call") ──
// Hidden plots carry the live numbers; the alertcondition message reads them via
// {{plot()}} placeholders. Same gates, same one-bullet counter, same content.
plot(fire ? (trigLong ? 1 : -1) : na, "aDir",   display = display.none, editable = false)
plot(fire ? entry   : na,             "aEntry", display = display.none, editable = false)
plot(fire ? stopRaw : na,             "aStop",  display = display.none, editable = false)
plot(fire ? riskPts : na,             "aRisk",  display = display.none, editable = false)
plot(fire ? t1      : na,             "aT1",    display = display.none, editable = false)
plot(fire ? t2      : na,             "aT2",    display = display.none, editable = false)
plot(fire ? roomR   : na,             "aRoom",  display = display.none, editable = false)
plot(fire ? score   : na,             "aScore", display = display.none, editable = false)
alertcondition(fire, "TRADE SIGNAL — the full alert",
     "{{ticker}} MSB dir {{plot(\"aDir\")}} | score {{plot(\"aScore\")}}/13 | entry {{plot(\"aEntry\")}} | stop {{plot(\"aStop\")}} | risk {{plot(\"aRisk\")}} pts | T1 {{plot(\"aT1\")}} | T2 {{plot(\"aT2\")}} | room {{plot(\"aRoom\")}}R")
