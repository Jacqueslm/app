//@version=6
// =============================================================================
//  MARKET STRUCTURE BRIDGE  —  Daily bias / 4H bridge / 1H execution
//  Apply this to a 1H chart. MNQ, MES, MGC.
//
//  It watches for this exact sequence and nothing else:
//     ① Daily structure agrees with the direction         (permission)
//     ② 1H closes through a swing high/low                (the HH break)
//     ③ Price trades back through that level              (break back below)
//     ④ Price reclaims the level                          (back up to it)
//     ⑤ 4H structure still agrees                         (the bridge)
//     ⑥ 1H closes above the reclaim candle's high         (the trigger)
//  ...then it grades the setup and only alerts if it passes.
//
//  Chop is rejected by three measures — efficiency ratio, range/ATR, ADX —
//  on both the 1H and the 15m. See PLAYBOOK.md §5.
// =============================================================================

indicator("Market Structure Bridge", "MSB", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ─── Inputs ──────────────────────────────────────────────────────────────────
grpS = "Structure"
pvL      = input.int(3,    "Swing strength (left)",  minval = 1, maxval = 20, group = grpS)
pvR      = input.int(3,    "Swing strength (right)", minval = 1, maxval = 20, group = grpS,
     tooltip = "Bars required to the right before a swing confirms. Higher = slower but cleaner.")
biasTF   = input.timeframe("D",   "Bias timeframe",    group = grpS)
bridgeTF = input.timeframe("240", "Bridge timeframe",  group = grpS)
monTF    = input.timeframe("15",  "Monitor timeframe", group = grpS)

grpC = "Consolidation filter"
erLen    = input.int(20,     "Efficiency ratio length",   minval = 5,   group = grpC)
erMin    = input.float(0.30, "Chop if ER below",          minval = 0.0, maxval = 1.0, step = 0.01, group = grpC)
rngLen   = input.int(20,     "Range length",              minval = 5,   group = grpC)
rngMin   = input.float(3.0,  "Chop if range/ATR below",   minval = 0.5, step = 0.1, group = grpC)
adxMin   = input.float(18.0, "Chop if ADX below",         minval = 5.0, step = 0.5, group = grpC)
maxChop  = input.int(1,      "Max chop measures allowed", minval = 0, maxval = 3,   group = grpC,
     tooltip = "Reject once MORE than this many of the three chop measures are firing.")

grpT = "Trigger & grading"
dispMult = input.float(1.2, "Displacement (body vs 20-bar avg)", minval = 1.0, step = 0.1, group = grpT)
setupTO  = input.int(40,    "Setup expires after N bars", minval = 5, group = grpT)
minGrade = input.string("B", "Alert on grade", options = ["A+", "B"], group = grpT)
rrTarget = input.float(2.0, "R multiple for T1",  minval = 1.0, step = 0.5,  group = grpT)
stopBuf  = input.float(0.15,"Stop buffer (× ATR)", minval = 0.0, step = 0.05, group = grpT)

grpX = "Session"
useSess = input.bool(true, "Only alert inside session", group = grpX)
sessStr = input.session("0930-1130", "Session window", group = grpX,
     tooltip = "MNQ/MES: 0930-1130. MGC: 0800-1200.")
sessTZ  = input.string("America/New_York", "Timezone", group = grpX)

grpV = "Display"
showZone = input.bool(true, "Show retest zone",  group = grpV)
showSwg  = input.bool(true, "Show swing labels", group = grpV)
showDash = input.bool(true, "Show dashboard",    group = grpV)
cBull    = input.color(#26a69a, "Bullish", group = grpV, inline = "c")
cBear    = input.color(#ef5350, "Bearish", group = grpV, inline = "c")

// ─── Structure engine ────────────────────────────────────────────────────────
// Evaluated on whatever timeframe it is called in.
// A BOS requires a CLOSE beyond the swing — wicks never count.
f_structure() =>
    var float swingHi  = na   // most recent confirmed, still-unbroken swing high
    var float swingLo  = na
    var float brokenHi = na   // the level the last up-BOS closed through
    var float brokenLo = na
    var float protLo   = na   // last swing low before the up-BOS
    var float protHi   = na
    var int   trend    = 0    // 1 bull · -1 bear · 0 undecided

    ph = ta.pivothigh(high, pvL, pvR)
    pl = ta.pivotlow(low,  pvL, pvR)
    if not na(ph)
        swingHi := ph
    if not na(pl)
        swingLo := pl

    bUp = not na(swingHi) and close > swingHi
    bDn = not na(swingLo) and close < swingLo
    // Outside bar closing through both sides: resolve by candle direction.
    if bUp and bDn
        if close >= open
            bDn := false
        else
            bUp := false

    if bUp
        brokenHi := swingHi
        protLo   := swingLo
        trend    := 1
        swingHi  := na
    else if bDn
        brokenLo := swingLo
        protHi   := swingHi
        trend    := -1
        swingLo  := na

    [trend, brokenHi, brokenLo, protLo, protHi, bUp, bDn]

// Trend only — cheap enough to request for the higher timeframes.
f_trend() =>
    [t, _bh, _bl, _pl, _ph, _bu, _bd] = f_structure()
    t

// Execution timeframe = the chart. Put this on the 1H.
[xTrend, xBrokenHi, xBrokenLo, xProtLo, xProtHi, xBosUp, xBosDn] = f_structure()

// Higher timeframes. lookahead_off — no peeking inside unclosed HTF bars.
biasTrend   = request.security(syminfo.tickerid, biasTF,   f_trend(), lookahead = barmerge.lookahead_off)
bridgeTrend = request.security(syminfo.tickerid, bridgeTF, f_trend(), lookahead = barmerge.lookahead_off)

// ─── Consolidation filter ────────────────────────────────────────────────────
f_chop() =>
    atr14  = ta.atr(14)
    move   = math.abs(close - close[erLen])
    path   = math.sum(math.abs(close - close[1]), erLen)
    er     = path > 0 ? move / path : 0.0
    rng    = ta.highest(high, rngLen) - ta.lowest(low, rngLen)
    rngAtr = atr14 > 0 ? rng / atr14 : 0.0
    [_dip, _dim, adxv] = ta.dmi(14, 14)
    n = (er < erMin ? 1 : 0) + (rngAtr < rngMin ? 1 : 0) + (adxv < adxMin ? 1 : 0)
    [n, er, rngAtr, adxv]

f_chopN() =>
    [n, _e, _r, _a] = f_chop()
    n

[chopN, erVal, rngAtrVal, adxVal] = f_chop()
monChopN = request.security(syminfo.tickerid, monTF, f_chopN(), lookahead = barmerge.lookahead_off)
chopOK   = chopN <= maxChop and monChopN <= maxChop

// ─── Session ─────────────────────────────────────────────────────────────────
inSess = not useSess or not na(time(timeframe.period, sessStr, sessTZ))

// ─── Shared series (never call ta.* conditionally) ───────────────────────────
atr     = ta.atr(14)
avgBody = ta.sma(math.abs(close - open), 20)
disp    = math.abs(close - open) >= avgBody * dispMult
volOK   = na(volume) or volume > ta.sma(volume, 20)
phG     = ta.pivothigh(high, pvL, pvR)
plG     = ta.pivotlow(low,  pvL, pvR)

// ─── Setup state machine ─────────────────────────────────────────────────────
// 0 idle · 1 armed (BOS printed) · 2 traded back through · 3 reclaimed, waiting
var int   st      = 0
var int   stDir   = 0
var float zone    = na     // the HH break level being retested
var float prot    = na     // protected low/high — lose it and the setup is dead
var int   stBars  = 0
var int   touches = 0
var bool  cleanRt = true
var float pullExt = na     // deepest point of the pullback (used for the stop)
var float trigLvl = na     // reclaim candle's extreme — the level to close through

armLong  = xBosUp and biasTrend ==  1
armShort = xBosDn and biasTrend == -1
armedNow = armLong or armShort

// The protected level falls back to the breakout candle's own extreme when no swing
// has confirmed yet — otherwise a setup can arm with no invalidation level at all.
if armLong
    st      := 1
    stDir   := 1
    zone    := xBrokenHi
    prot    := na(xProtLo) ? low : xProtLo
    stBars  := 0
    touches := 0
    cleanRt := true
    pullExt := low
    trigLvl := na
else if armShort
    st      := 1
    stDir   := -1
    zone    := xBrokenLo
    prot    := na(xProtHi) ? high : xProtHi
    stBars  := 0
    touches := 0
    cleanRt := true
    pullExt := high
    trigLvl := na
else if st > 0
    stBars += 1

// Progress the sequence — longs.
// `not armedNow` matters: the breakout candle's own low sits below the level it just
// broke, so without this guard every setup would jump straight to ③ on the arming bar.
if st > 0 and stDir == 1 and not armedNow
    pullExt := math.min(pullExt, low)
    if st == 1 and low < zone                  // ③ traded back below the level
        st := 2
    else if st == 2 and close > zone           // ④ reclaimed it
        st      := 3
        touches := touches + 1
        trigLvl := high                        // ⑤ wait for a close above this
    else if st == 3 and close < zone           // fell back through — no longer clean
        st      := 2
        cleanRt := false

// Progress the sequence — shorts
if st > 0 and stDir == -1 and not armedNow
    pullExt := math.max(pullExt, high)
    if st == 1 and high > zone
        st := 2
    else if st == 2 and close < zone
        st      := 3
        touches := touches + 1
        trigLvl := low
    else if st == 3 and close > zone
        st      := 2
        cleanRt := false

// Invalidation: protected level lost, bias flipped, or the setup went stale.
invalid = st > 0 and (
     (stDir ==  1 and ((not na(prot) and close < prot) or biasTrend == -1)) or
     (stDir == -1 and ((not na(prot) and close > prot) or biasTrend ==  1)) or
     stBars > setupTO)
if invalid
    st      := 0
    stDir   := 0
    zone    := na
    prot    := na
    trigLvl := na

// ─── Trigger ─────────────────────────────────────────────────────────────────
// ⑥ close through the reclaim candle, with body, while the bridge agrees.
trigLong  = st == 3 and stDir ==  1 and bridgeTrend ==  1 and not na(trigLvl) and close > trigLvl and disp and chopOK
trigShort = st == 3 and stDir == -1 and bridgeTrend == -1 and not na(trigLvl) and close < trigLvl and disp and chopOK
anyTrig   = trigLong or trigShort

// ─── Trade levels ────────────────────────────────────────────────────────────
entry   = close
stopRaw = trigLong  ? math.min(nz(pullExt, low),  nz(zone, low))  - atr * stopBuf :
          trigShort ? math.max(nz(pullExt, high), nz(zone, high)) + atr * stopBuf : na
riskPts = na(stopRaw) ? na : math.abs(entry - stopRaw)
t1      = na(riskPts) ? na : trigLong ? entry + riskPts * rrTarget : entry - riskPts * rrTarget

// Clear air to the next opposing swing — "room to run".
// Hoisted out of the ternary — ta.* must be called on every bar, not conditionally.
hi100  = ta.highest(high, 100)[1]
lo100  = ta.lowest(low, 100)[1]
oppLvl = trigLong ? hi100 : lo100
roomR  = not na(riskPts) and riskPts > 0 ? math.abs(oppLvl - entry) / riskPts : 0.0

// ─── Grading (PLAYBOOK §6) ───────────────────────────────────────────────────
score = (touches <= 1 ? 1 : 0) +   // first retest
     (cleanRt      ? 1 : 0) +      // clean pullback, no repeated pokes
     (disp         ? 1 : 0) +      // displacement on the trigger
     (volOK        ? 1 : 0) +      // volume expansion
     (inSess       ? 1 : 0) +      // inside the session window
     (chopN == 0   ? 1 : 0) +      // zero chop measures firing
     (roomR >= 3.0 ? 1 : 0)        // 3R+ of room to the next level

grade   = score >= 6 ? "A+" : score >= 4 ? "B" : "C"
gradeOK = grade == "A+" or (minGrade == "B" and grade == "B")
fire    = anyTrig and gradeOK and roomR >= 2.0 and inSess and barstate.isconfirmed

// ─── Drawing ─────────────────────────────────────────────────────────────────
var box zoneBox = na
if showZone and st > 0 and not na(zone)
    if na(zoneBox)
        zoneBox := box.new(bar_index, zone, bar_index, zone,
             border_color = color.new(color.gray, 40), bgcolor = color.new(color.gray, 88))
    box.set_right(zoneBox, bar_index + 3)
    box.set_top(zoneBox, zone + atr * 0.10)
    box.set_bottom(zoneBox, zone - atr * 0.10)
    box.set_bgcolor(zoneBox, color.new(stDir == 1 ? cBull : cBear, st == 3 ? 78 : 90))
if st == 0 and not na(zoneBox)
    box.delete(zoneBox)
    zoneBox := na

if showSwg and not na(phG)
    label.new(bar_index - pvR, high[pvR], "H", style = label.style_label_down,
         color = color.new(cBear, 70), textcolor = color.white, size = size.tiny)
if showSwg and not na(plG)
    label.new(bar_index - pvR, low[pvR], "L", style = label.style_label_up,
         color = color.new(cBull, 70), textcolor = color.white, size = size.tiny)

plotshape(xBosUp, "BOS up",   shape.triangleup,   location.belowbar, cBull, size = size.tiny)
plotshape(xBosDn, "BOS down", shape.triangledown, location.abovebar, cBear, size = size.tiny)

if fire
    label.new(bar_index, trigLong ? low - atr : high + atr,
         (trigLong ? "▲ LONG " : "▼ SHORT ") + grade + "  " + str.tostring(score) + "/7",
         style = trigLong ? label.style_label_up : label.style_label_down,
         color = trigLong ? cBull : cBear, textcolor = color.white, size = size.small)
    line.new(bar_index, entry,   bar_index + 12, entry,   color = color.blue, width = 1)
    line.new(bar_index, stopRaw, bar_index + 12, stopRaw, color = cBear, width = 1, style = line.style_dashed)
    line.new(bar_index, t1,      bar_index + 12, t1,      color = cBull, width = 1, style = line.style_dashed)

// ─── Dashboard ───────────────────────────────────────────────────────────────
f_txt(int t) => t == 1 ? "BULL" : t == -1 ? "BEAR" : "—"
f_col(int t) => t == 1 ? cBull  : t == -1 ? cBear  : color.gray

var table dash = table.new(position.top_right, 2, 8,
     border_width = 1, border_color = color.new(color.gray, 60))
if showDash and barstate.islast
    stName = st == 0 ? "IDLE" : st == 1 ? "① BOS — armed" : st == 2 ? "② back through" : "③ RECLAIMED — waiting"
    table.cell(dash, 0, 0, "MSB", text_color = color.white, bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(dash, 1, 0, syminfo.ticker, text_color = color.white, bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(dash, 0, 1, "Bias " + biasTF, text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 1, f_txt(biasTrend), text_color = f_col(biasTrend), text_size = size.small)
    table.cell(dash, 0, 2, "Bridge " + bridgeTF, text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 2, f_txt(bridgeTrend), text_color = f_col(bridgeTrend), text_size = size.small)
    table.cell(dash, 0, 3, "Exec " + timeframe.period, text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 3, f_txt(xTrend), text_color = f_col(xTrend), text_size = size.small)
    table.cell(dash, 0, 4, "Chop 1H/15m", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 4, str.tostring(chopN) + " / " + str.tostring(monChopN),
         text_color = chopOK ? cBull : cBear, text_size = size.small)
    table.cell(dash, 0, 5, "ER·R/ATR·ADX", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 5, str.tostring(erVal, "#.00") + "  " + str.tostring(rngAtrVal, "#.0") + "  " + str.tostring(adxVal, "#"),
         text_color = color.silver, text_size = size.small)
    table.cell(dash, 0, 6, "Setup", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 6, stName, text_color = st == 3 ? color.yellow : color.silver, text_size = size.small)
    table.cell(dash, 0, 7, "Session", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 7, inSess ? "OPEN" : "closed", text_color = inSess ? cBull : color.gray, text_size = size.small)

// ─── Alerts ──────────────────────────────────────────────────────────────────
if fire
    alert(syminfo.ticker + " " + (trigLong ? "LONG" : "SHORT") + " " + grade +
         " (" + str.tostring(score) + "/7)" +
         " | entry " + str.tostring(entry,   format.mintick) +
         " | stop "  + str.tostring(stopRaw, format.mintick) +
         " | T1 "    + str.tostring(t1,      format.mintick) +
         " | risk "  + str.tostring(riskPts, format.mintick) + " pts" +
         " | room "  + str.tostring(roomR, "#.0") + "R" +
         " — size it in the grader before you click buy.",
         alert.freq_once_per_bar_close)

alertcondition(st == 3 and st[1] != 3, "Level reclaimed — watch for the trigger",
     "MSB: level reclaimed. Waiting on the 1H close-through.")
