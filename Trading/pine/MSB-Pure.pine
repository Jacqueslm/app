//@version=6
// =============================================================================
//  MARKET STRUCTURE BRIDGE — PURE
//
//  Structure and nothing else. No VWAP, no RVOL, no ADX, no efficiency ratio,
//  no ATR, no value area, no day type, no range budget, no correlation, no
//  scoring. Every number this thing looks at is a swing high or a swing low.
//
//  ALIGNMENT — four timeframes, and all four must agree with the trade:
//    Standard   Daily + 4H  (the bias pair)   ·  1H + 15m  (the execution pair)
//    Scalp      4H    + 1H  (the bias pair)   ·  15m + 5m  (the execution pair)
//
//  Put the script on the EXECUTION chart: the 1H in standard mode, the 15m in
//  scalp mode. The other three timeframes are read from it.
//
//  TWO WAYS IN, both pure structure, both switchable:
//
//    PULLBACK  — the trend is aligned, price pulls back far enough to print a
//                swing against it, then closes back through the swing it came
//                from. You are buying the resumption of a trend that never
//                stopped being a trend.
//
//    RETEST    — the longer sequence:
//                (1) price closes through a swing high      break of structure
//                (2) price trades back through that level   the retest starts
//                (3) price closes back above it             the reclaim
//                (4) it HOLDS for N closed bars             the wait
//                (5) price closes past the reclaim bar      the fresh break
//
//  DEATH: a close beyond the protected swing, the bias flipping, or the setup
//  running out of bars.
//
//  TARGETS: the next opposing swing on the bridge or bias timeframe. If there
//  is none — price in open air — the measured move of the leg that built the
//  setup. Structure projects structure; nothing else is invented.
//
//  SIZE: a fixed percentage of the account, computed from the stop distance
//  and the instrument's dollars-per-point. If the stop is so wide that the
//  answer is zero contracts, the trade is skipped rather than shrunk.
// =============================================================================

strategy("MSB Pure — structure only", "MSB-PURE", overlay = true,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     initial_capital = 25000, currency = currency.USD,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.39,
     slippage = 2, margin_long = 0, margin_short = 0,
     max_lines_count = 500, max_labels_count = 500)

// ─── Alignment: the four timeframes ──────────────────────────────────────────
grpA = "Alignment"
useScalp = input.bool(false, "Scalp mode", group = grpA,
     tooltip = "OFF — standard: Daily+4H bias, trigger on the 1H, 15m must agree. Run it on the 1H chart.\nON — scalp: 4H+1H bias, trigger on the 15m, 5m must agree. Run it on the 15m chart.")
biasIn   = input.timeframe("D",   "Bias TF   (scalp mode forces 4H)",  group = grpA)
bridgeIn = input.timeframe("240", "Bridge TF (scalp mode forces 1H)",  group = grpA)
alignIn  = input.timeframe("15",  "Lower TF  (scalp mode forces 5m)",  group = grpA)
useBias   = input.bool(true, "Bias TF must agree",   group = grpA)
useBridge = input.bool(true, "Bridge TF must agree", group = grpA)
useAlign  = input.bool(true, "Lower TF must agree",  group = grpA)
useExec   = input.bool(true, "This chart must agree", group = grpA,
     tooltip = "The execution chart's own structure has to point the same way. This plus the lower TF is the '1H and 15m alignment' half of the rule.")

biasTF   = useScalp ? "240" : biasIn
bridgeTF = useScalp ? "60"  : bridgeIn
alignTF  = useScalp ? "5"   : alignIn
wantTF   = useScalp ? "15"  : "60"

grpS = "Structure"
pvL = input.int(7, "Swing strength (left)",  minval = 1, maxval = 20, group = grpS)
pvR = input.int(7, "Swing strength (right)", minval = 1, maxval = 20, group = grpS)

// ─── The two ways in ─────────────────────────────────────────────────────────
grpQ = "Entries"
usePB  = input.bool(true, "Pullback entry", group = grpQ,
     tooltip = "Aligned trend, price pulls back far enough to print a swing against it, then closes back through the swing it came from.")
useSeq = input.bool(true, "Retest sequence entry", group = grpQ,
     tooltip = "The long version: break, back through, reclaim, hold, fresh break.")
holdBars = input.int(1, "Bars the reclaim must hold (the wait)", minval = 0, maxval = 10, group = grpQ)
setupTO  = input.int(40, "Retest setup expires after N bars", minval = 5, group = grpQ)
freshBrk = input.bool(true, "Require the fresh break (close past the reclaim bar)", group = grpQ)

// ─── Stop, target, size ──────────────────────────────────────────────────────
grpE = "Stop & target — structural only"
stopTicks = input.int(4, "Stop buffer (ticks beyond the swing)", minval = 0, group = grpE)
minRoom   = input.float(0.0, "Reject if room below this (R)", minval = 0.0, step = 0.5, group = grpE)
useMM     = input.bool(true, "Open air: use the measured move of the leg", group = grpE)

// The target decides the win rate, and it does so mechanically: a nearer target
// is hit more often. That is not an edge, it is arithmetic, and the money moves
// the other way. Measured on MES 1H, swing 7, 72 trades over 43 months, net of
// $0.78 commission and a tick of slippage each way:
//
//     target    win rate    net expectancy    total over 43 months
//     0.20R       71%          +0.011R              +1.8R
//     0.25R       64%          -0.010R              +0.3R
//     0.40R       60%          +0.013R              +1.9R
//     0.50R       58%          +0.025R              +2.8R
//     0.75R       57%          +0.055R              +5.0R   <- most money
//     1.00R       57%          +0.048R              +4.4R
//     2.00R       56%          +0.053R              +4.8R
//     structure   varies       see the sweep        varies
//
// So 71% is available and it earns a fifth of what 57% earns. Pick knowingly.
// Re-measure with: node engine/msb-winrate.js  in the TradeDesk folder.
tgtMode = input.string("Fixed R", "Target", options = ["Fixed R", "Next opposing swing"], group = grpE,
     tooltip = "Fixed R sets the target at a multiple of the stop, which is what makes the win rate predictable. Next opposing swing is the structural target and hits far less often because it is usually a long way away.")
tgtR    = input.float(0.4, "Fixed R multiple", minval = 0.1, maxval = 10, step = 0.05, group = grpE,
     tooltip = "0.40 measured 60% wins. 0.20 measured 71% wins but a fifth of the money. 0.75 made the most money at 57%.")

grpZ = "Size"
riskPct = input.float(1.0, "Risk per trade (% of account)", minval = 0.1, maxval = 100, step = 0.25, group = grpZ,
     tooltip = "Contracts = floor( (account x this%) / (stop in points x dollars per point) ). Zero contracts means the stop is too wide for the account and the trade is skipped, never shrunk.\n\nYour own paper record averages 0.87% of the account per trade. The sweeps showed 10% turning every positive edge into a 30-99% drawdown, so this ships at 1%.")
maxQty  = input.int(50, "Contract cap", minval = 1, group = grpZ)

grpM = "Management"
partialR = input.float(1.0, "T1 at R multiple (take half here)", minval = 0.5, step = 0.5, group = grpM)
t1Pct    = input.int(50, "% off at T1", minval = 0, maxval = 100, group = grpM)
beAtT1   = input.bool(true, "Move stop to break-even at T1", group = grpM)

grpR = "Your rules"
maxPerDay = input.int(1, "Max trades per day", minval = 1, maxval = 10, group = grpR)
useSess = input.bool(true, "Only trade the New York session", group = grpR)
sessStr = input.session("0930-1500", "Tradeable window", group = grpR)
sessTZ  = input.string("America/New_York", "Timezone", group = grpR)
flatEOD = input.bool(true, "Flatten at the session close", group = grpR)

// ─── Structure: trend from swings, nothing else ──────────────────────────────
// Higher highs AND higher lows = up. Lower highs AND lower lows = down.
// Anything else keeps the previous read — structure does not flip on one bar.
f_trend() =>
    ph = ta.pivothigh(pvL, pvR)
    pl = ta.pivotlow(pvL, pvR)
    var float h1 = na
    var float h2 = na
    var float l1 = na
    var float l2 = na
    var int   t  = 0
    if not na(ph)
        h2 := h1
        h1 := ph
    if not na(pl)
        l2 := l1
        l1 := pl
    if not na(h1) and not na(h2) and not na(l1) and not na(l2)
        if h1 > h2 and l1 > l2
            t := 1
        else if h1 < h2 and l1 < l2
            t := -1
    t

f_pivHi() =>
    var float p = na
    x = ta.pivothigh(pvL, pvR)
    if not na(x)
        p := x
    p

f_pivLo() =>
    var float p = na
    x = ta.pivotlow(pvL, pvR)
    if not na(x)
        p := x
    p

biasT   = request.security(syminfo.tickerid, biasTF,   f_trend(), lookahead = barmerge.lookahead_off)
bridgeT = request.security(syminfo.tickerid, bridgeTF, f_trend(), lookahead = barmerge.lookahead_off)
alignT  = request.security(syminfo.tickerid, alignTF,  f_trend(), lookahead = barmerge.lookahead_off)
execT   = f_trend()

bridgeHi = request.security(syminfo.tickerid, bridgeTF, f_pivHi(), lookahead = barmerge.lookahead_off)
bridgeLo = request.security(syminfo.tickerid, bridgeTF, f_pivLo(), lookahead = barmerge.lookahead_off)
biasHi   = request.security(syminfo.tickerid, biasTF,   f_pivHi(), lookahead = barmerge.lookahead_off)
biasLo   = request.security(syminfo.tickerid, biasTF,   f_pivLo(), lookahead = barmerge.lookahead_off)

// All four must point the same way as the trade. This is the whole of
// "Daily and 4H aligned, 1H and 15m aligned" — nothing else is consulted.
alignedL = (not useBias   or biasT   ==  1) and (not useBridge or bridgeT ==  1) and
           (not useAlign  or alignT  ==  1) and (not useExec   or execT   ==  1)
alignedS = (not useBias   or biasT   == -1) and (not useBridge or bridgeT == -1) and
           (not useAlign  or alignT  == -1) and (not useExec   or execT   == -1)

// Swings on the execution chart, and WHEN each one was put on the record.
// The bar indices are what tell a pullback apart from a fresh break.
phC = ta.pivothigh(pvL, pvR)
plC = ta.pivotlow(pvL, pvR)
var float swHi    = na
var float swLo    = na
var int   swHiBar = na
var int   swLoBar = na
if not na(phC)
    swHi    := phC
    swHiBar := bar_index - pvR
if not na(plC)
    swLo    := plC
    swLoBar := bar_index - pvR

bosUp = not na(swHi) and close > swHi and close[1] <= swHi
bosDn = not na(swLo) and close < swLo and close[1] >= swLo

// ─── The retest sequence ─────────────────────────────────────────────────────
var int   st      = 0     // 0 idle · 1 armed · 2 back through · 3 reclaimed & holding
var int   stDir   = 0
var float zone    = na    // the broken level — the whole setup pivots on this
var float prot    = na    // protected swing; a close beyond it kills the setup
var float trigLvl = na    // the reclaim bar's extreme — step 5 must close past it
var float pullExt = na    // deepest point of the pullback — where the stop lives
var float legLo   = na    // the leg that built the setup, for the measured move
var float legHi   = na
var int   heldBars = 0
var int   stBars   = 0

biasOKL = not useBias or biasT ==  1
biasOKS = not useBias or biasT == -1

armedNow = false
if st == 0 and useSeq
    if bosUp and biasOKL
        st       := 1
        stDir    := 1
        zone     := swHi
        prot     := nz(swLo, low)
        legLo    := nz(swLo, low)
        legHi    := high
        pullExt  := low
        trigLvl  := na
        heldBars := 0
        stBars   := 0
        armedNow := true
    else if bosDn and biasOKS
        st       := 1
        stDir    := -1
        zone     := swLo
        prot     := nz(swHi, high)
        legHi    := nz(swHi, high)
        legLo    := low
        pullExt  := high
        trigLvl  := na
        heldBars := 0
        stBars   := 0
        armedNow := true
else if st > 0
    stBars += 1

// Longs
if st > 0 and stDir == 1 and not armedNow
    pullExt := math.min(pullExt, low)
    legHi   := math.max(legHi, high)
    if st == 1 and low < zone
        st := 2
    else if st == 2 and close > zone
        st       := 3
        trigLvl  := high
        heldBars := 0
    else if st == 3
        if close < zone
            st       := 2
            heldBars := 0
        else
            heldBars += 1

// Shorts
if st > 0 and stDir == -1 and not armedNow
    pullExt := math.max(pullExt, high)
    legLo   := math.min(legLo, low)
    if st == 1 and high > zone
        st := 2
    else if st == 2 and close < zone
        st       := 3
        trigLvl  := low
        heldBars := 0
    else if st == 3
        if close > zone
            st       := 2
            heldBars := 0
        else
            heldBars += 1

invalid = st > 0 and (
     (stDir ==  1 and ((not na(prot) and close < prot) or (useBias and biasT == -1))) or
     (stDir == -1 and ((not na(prot) and close > prot) or (useBias and biasT ==  1))) or
     stBars > setupTO)
if invalid
    st      := 0
    stDir   := 0
    zone    := na
    prot    := na
    trigLvl := na

// ─── Triggers ────────────────────────────────────────────────────────────────
// Retest: the sequence completed.
heldOK = heldBars >= holdBars
breakL = not freshBrk or (not na(trigLvl) and close > trigLvl)
breakS = not freshBrk or (not na(trigLvl) and close < trigLvl)
seqL   = useSeq and st == 3 and stDir ==  1 and heldOK and breakL
seqS   = useSeq and st == 3 and stDir == -1 and heldOK and breakS

// Pullback: a swing against the trend is on the record (the pullback happened
// and finished), and price has just closed back through the swing it came from.
// The pullback low IS the stop — if it goes, the pullback was a reversal.
pbL = usePB and bosUp and not na(swLoBar) and not na(swHiBar) and swLoBar > swHiBar and close > nz(swLo, low)
pbS = usePB and bosDn and not na(swHiBar) and not na(swLoBar) and swHiBar > swLoBar and close < nz(swHi, high)

trigLong  = (seqL or pbL) and alignedL
trigShort = (seqS or pbS) and alignedS

entry = close
buf   = syminfo.mintick * stopTicks

// The stop sits under whatever structure the entry was built on: the retest's
// pullback extreme, or the pullback low itself.
stopL = seqL ? math.min(nz(pullExt, low),  nz(zone, low))  - buf : nz(swLo, low)  - buf
stopS = seqS ? math.max(nz(pullExt, high), nz(zone, high)) + buf : nz(swHi, high) + buf
stopRaw = trigLong ? stopL : trigShort ? stopS : na
riskPts = na(stopRaw) ? na : math.abs(entry - stopRaw)

// Target: the next opposing swing on the bridge or bias timeframe.
f_above(float cur, float lvl, float px) =>
    not na(lvl) and lvl > px ? (na(cur) ? lvl : math.min(cur, lvl)) : cur
f_below(float cur, float lvl, float px) =>
    not na(lvl) and lvl < px ? (na(cur) ? lvl : math.max(cur, lvl)) : cur

wallUp = f_above(float(na), bridgeHi, entry)
wallUp := f_above(wallUp, biasHi, entry)
wallDn = f_below(float(na), bridgeLo, entry)
wallDn := f_below(wallDn, biasLo, entry)

// Open air: project the leg that built the setup. Structure projecting structure.
legSize = nz(legHi, high) - nz(legLo, low)
mmUp    = useMM and legSize > 0 ? entry + legSize : na
mmDn    = useMM and legSize > 0 ? entry - legSize : na
structTgt = trigLong ? nz(wallUp, mmUp) : nz(wallDn, mmDn)
fixedTgt  = na(riskPts) ? na : trigLong ? entry + riskPts * tgtR : entry - riskPts * tgtR
target    = tgtMode == "Fixed R" ? fixedTgt : structTgt
roomR     = not na(riskPts) and riskPts > 0 and not na(target) ? math.abs(target - entry) / riskPts : 0.0

// ─── Size: percent of account, from the stop distance ────────────────────────
// Contracts = floor( (account x risk%) / (stop points x dollars per point) ).
// Zero means the stop is too wide for the account, and the answer to that is
// to skip the trade — never to shrink the stop to fit the size.
ptVal   = syminfo.pointvalue
riskUsd = strategy.equity * riskPct / 100.0
qtyRaw  = not na(riskPts) and riskPts > 0 and ptVal > 0 ? math.floor(riskUsd / (riskPts * ptVal)) : 0
qty     = math.min(maxQty, qtyRaw)

// ─── Your rules ──────────────────────────────────────────────────────────────
inSess = not useSess or not na(time(timeframe.period, sessStr, sessTZ))
var int tookToday = 0
var int lastDay   = na
if na(lastDay) or dayofmonth != lastDay
    tookToday := 0
    lastDay   := dayofmonth

okToTrade = roomR >= minRoom and inSess and tookToday < maxPerDay and
     not na(riskPts) and riskPts > 0 and qty > 0 and strategy.position_size == 0

// ─── Orders ──────────────────────────────────────────────────────────────────
var float pStop = na
var float pT1   = na
var float pT2   = na
var bool  t1Hit = false
var bool  split = false

// A partial at 1R only exists if the target is further away than 1R. With a
// fixed target of 0.4R there is nothing to take half of on the way — the whole
// position exits at the target, and pretending otherwise leaves half the trade
// running to a price the plan never chose.
splitOK = not na(target) and not na(riskPts) and riskPts > 0 and
     math.abs(target - entry) > riskPts * partialR

// The exits go in WITH the entry — the bracket exists from the first bar of the
// position. And the trade consumes the sequence, or the day counter resets
// overnight and the SAME stale setup re-fires tomorrow.
if trigLong and okToTrade
    pStop := stopRaw
    pT1   := entry + riskPts * partialR
    pT2   := target
    t1Hit := false
    tookToday += 1
    split := splitOK
    strategy.entry("L", strategy.long, qty = qty)
    if split
        strategy.exit("L-T1", "L", qty_percent = t1Pct, limit = pT1, stop = pStop)
        strategy.exit("L-T2", "L", limit = pT2, stop = pStop)
    else
        strategy.exit("L-X", "L", limit = pT2, stop = pStop)
    st       := 0
    stDir    := 0
    zone     := na
    prot     := na
    trigLvl  := na
    heldBars := 0
    stBars   := 0

if trigShort and okToTrade
    pStop := stopRaw
    pT1   := entry - riskPts * partialR
    pT2   := target
    t1Hit := false
    tookToday += 1
    split := splitOK
    strategy.entry("S", strategy.short, qty = qty)
    if split
        strategy.exit("S-T1", "S", qty_percent = t1Pct, limit = pT1, stop = pStop)
        strategy.exit("S-T2", "S", limit = pT2, stop = pStop)
    else
        strategy.exit("S-X", "S", limit = pT2, stop = pStop)
    st       := 0
    stDir    := 0
    zone     := na
    prot     := na
    trigLvl  := na
    heldBars := 0
    stBars   := 0

if strategy.position_size > 0 and split and not t1Hit and high >= pT1
    t1Hit := true
    if beAtT1
        pStop := math.max(pStop, strategy.position_avg_price)
if strategy.position_size < 0 and split and not t1Hit and low <= pT1
    t1Hit := true
    if beAtT1
        pStop := math.min(pStop, strategy.position_avg_price)

if strategy.position_size > 0
    if split
        strategy.exit("L-T1", "L", qty_percent = t1Pct, limit = pT1, stop = pStop)
        strategy.exit("L-T2", "L", limit = pT2, stop = pStop)
    else
        strategy.exit("L-X", "L", limit = pT2, stop = pStop)
if strategy.position_size < 0
    if split
        strategy.exit("S-T1", "S", qty_percent = t1Pct, limit = pT1, stop = pStop)
        strategy.exit("S-T2", "S", limit = pT2, stop = pStop)
    else
        strategy.exit("S-X", "S", limit = pT2, stop = pStop)

if flatEOD and useSess and not inSess and inSess[1] and strategy.position_size != 0
    strategy.close_all("EOD")

// ─── Visuals ─────────────────────────────────────────────────────────────────
plotshape(bosUp, "BOS up",   shape.triangleup,   location.belowbar, color.new(#26a69a, 60), size = size.tiny)
plotshape(bosDn, "BOS down", shape.triangledown, location.abovebar, color.new(#ef5350, 60), size = size.tiny)
plotshape(trigLong  and okToTrade, "Long",  shape.triangleup,   location.belowbar, color.new(#26a69a, 0), size = size.small)
plotshape(trigShort and okToTrade, "Short", shape.triangledown, location.abovebar, color.new(#ef5350, 0), size = size.small)
plot(strategy.position_size != 0 ? pStop : na, "Stop", color.new(#ef5350, 0), style = plot.style_linebr)
plot(strategy.position_size != 0 ? pT1   : na, "T1",   color.new(#26a69a, 0), style = plot.style_linebr)
plot(strategy.position_size != 0 ? pT2   : na, "T2",   color.new(#26a69a, 50), style = plot.style_linebr)

// ─── How often does the sequence even happen? ────────────────────────────────
var int nPB  = 0
var int nSeq = 0
if (pbL or pbS) and (alignedL or alignedS)
    nPB += 1
if (seqL or seqS) and (alignedL or alignedS)
    nSeq += 1

var table t = table.new(position.bottom_right, 2, 6, bgcolor = color.new(#0e1116, 10),
     frame_color = color.new(color.gray, 60), frame_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "MSB PURE", text_color = color.white, text_size = size.small, bgcolor = #3b82f6)
    table.cell(t, 1, 0, useScalp ? "scalp" : "standard", text_color = color.white, text_size = size.small, bgcolor = #3b82f6)
    table.cell(t, 0, 1, "Chart TF", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 1, timeframe.period + (timeframe.period == wantTF ? "" : "  ⚠ want " + wantTF),
         text_color = timeframe.period == wantTF ? color.silver : color.orange, text_size = size.small)
    table.cell(t, 0, 2, "Pullback triggers", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 2, str.tostring(nPB), text_color = color.silver, text_size = size.small)
    table.cell(t, 0, 3, "Retest triggers", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 3, str.tostring(nSeq), text_color = color.silver, text_size = size.small)
    table.cell(t, 0, 4, "Trades taken", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 4, str.tostring(strategy.closedtrades), text_color = #26a69a, text_size = size.small)
    table.cell(t, 0, 5, "Risk per trade", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 5, str.tostring(riskPct, "#.#") + "%", text_color = color.orange, text_size = size.small)
