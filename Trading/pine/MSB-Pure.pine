//@version=6
// =============================================================================
//  MARKET STRUCTURE BRIDGE — PURE
//
//  Structure and nothing else. No VWAP, no RVOL, no ADX, no efficiency ratio,
//  no value area, no day type, no range budget, no correlation, no scoring.
//  Every number this thing looks at is a swing high or a swing low.
//
//  Why it exists: the loaded version stacked twelve filters on top of the
//  sequence and the gate diagnostic showed they killed ~99% of valid setups —
//  about 800 completed sequences a year became 2 trades. The trader was right
//  and the filters were the problem.
//
//  THE SEQUENCE (all of it, on the execution chart):
//    ① price closes through a swing high  (break of structure — the direction)
//    ② price trades back through that level  (the retest starts)
//    ③ price closes back above it  (the reclaim)
//    ④ it HOLDS for N closed bars  (the wait — this is the whole edge)
//    ⑤ price closes above the reclaim bar's high  (the fresh break — entry)
//
//  PERMISSION comes from higher structure: the bias timeframe must be making
//  higher highs and higher lows for a long, and the bridge timeframe must agree
//  at the moment of the trigger. That is all "alignment" means here.
//
//  DEATH: a close beyond the protected swing, the bias flipping, or the setup
//  running out of bars.
//
//  TARGETS: the next opposing swing on the bridge or bias timeframe. If there
//  is none — price in open air — the measured move of the leg that built the
//  setup. Structure projects structure; nothing else is invented.
//
//  Run it on the 1H first, then the 15m. Compare trade counts against how often
//  you actually take a trade. If the machine finds far fewer than you do, the
//  sequence definition is still wrong and that is what to fix — not more filters.
// =============================================================================

strategy("MSB Pure — structure only", "MSB-PURE", overlay = true,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     initial_capital = 25000, currency = currency.USD,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.39,
     slippage = 2, margin_long = 0, margin_short = 0,
     max_lines_count = 500, max_labels_count = 500)

// ─── Inputs ──────────────────────────────────────────────────────────────────
grpS = "Structure"
pvL      = input.int(3, "Swing strength (left)",  minval = 1, maxval = 20, group = grpS)
pvR      = input.int(3, "Swing strength (right)", minval = 1, maxval = 20, group = grpS)
biasTF   = input.timeframe("D",   "Bias timeframe (permission)", group = grpS)
bridgeTF = input.timeframe("240", "Bridge timeframe (must agree at the trigger)", group = grpS)
useBias  = input.bool(true, "Bias timeframe must agree", group = grpS)
useBridge = input.bool(true, "Bridge timeframe must agree", group = grpS)

grpQ = "The sequence"
holdBars = input.int(1, "Bars the reclaim must hold (the wait)", minval = 0, maxval = 10, group = grpQ,
     tooltip = "Your rule is 'wait again' after the reclaim. 1 = one closed bar of holding. Raise it to demand more patience and watch the trade count fall.")
setupTO  = input.int(40, "Setup expires after N bars", minval = 5, group = grpQ)
freshBrk = input.bool(true, "Require the fresh break (close past the reclaim bar)", group = grpQ,
     tooltip = "OFF = enter on the reclaim itself. ON = wait for a close beyond the reclaim bar's extreme. This is step 5 of your sequence.")

grpE = "Stop & target — structural only"
stopTicks = input.int(4, "Stop buffer (ticks beyond the swing)", minval = 0, group = grpE)
minRoom   = input.float(1.0, "Reject if room below this (R)", minval = 0.0, step = 0.5, group = grpE)
useMM     = input.bool(true, "Open air: use the measured move of the leg", group = grpE,
     tooltip = "When no opposing swing exists above (long) or below (short), project the height of the leg that built the setup. Structure projecting structure - nothing invented.")

grpM = "Management"
partialR = input.float(1.0, "T1 at R multiple (take half here)", minval = 0.5, step = 0.5, group = grpM)
t1Pct    = input.int(50, "% off at T1", minval = 0, maxval = 100, group = grpM)
beAtT1   = input.bool(true, "Move stop to break-even at T1", group = grpM)

grpR = "Your rules"
maxPerDay = input.int(1, "Max trades per day", minval = 1, maxval = 10, group = grpR,
     tooltip = "Set high to see what the rules alone produce, then bring it back to your real limit and compare.")
useSess = input.bool(true, "Only trade the New York session", group = grpR)
sessStr = input.session("0930-1500", "Tradeable window", group = grpR)
sessTZ  = input.string("America/New_York", "Timezone", group = grpR)
flatEOD = input.bool(true, "Flatten at the session close", group = grpR)

// ─── Structure: trend from swings, nothing else ──────────────────────────────
// Higher highs AND higher lows = up. Lower highs AND lower lows = down.
// Anything else keeps the previous read — structure does not flip on one bar.
f_trend() =>
    ph = ta.pivothigh(pvL, pvR)
    pl = ta.pivotlow(pvL, pvR)
    var float h1 = na
    var float h2 = na
    var float l1 = na
    var float l2 = na
    var int   t  = 0
    if not na(ph)
        h2 := h1
        h1 := ph
    if not na(pl)
        l2 := l1
        l1 := pl
    if not na(h1) and not na(h2) and not na(l1) and not na(l2)
        if h1 > h2 and l1 > l2
            t := 1
        else if h1 < h2 and l1 < l2
            t := -1
    t

f_pivHi() =>
    var float p = na
    x = ta.pivothigh(pvL, pvR)
    if not na(x)
        p := x
    p

f_pivLo() =>
    var float p = na
    x = ta.pivotlow(pvL, pvR)
    if not na(x)
        p := x
    p

biasT   = request.security(syminfo.tickerid, biasTF,   f_trend(), lookahead = barmerge.lookahead_off)
bridgeT = request.security(syminfo.tickerid, bridgeTF, f_trend(), lookahead = barmerge.lookahead_off)

bridgeHi = request.security(syminfo.tickerid, bridgeTF, f_pivHi(), lookahead = barmerge.lookahead_off)
bridgeLo = request.security(syminfo.tickerid, bridgeTF, f_pivLo(), lookahead = barmerge.lookahead_off)
biasHi   = request.security(syminfo.tickerid, biasTF,   f_pivHi(), lookahead = barmerge.lookahead_off)
biasLo   = request.security(syminfo.tickerid, biasTF,   f_pivLo(), lookahead = barmerge.lookahead_off)

// Swings on the execution chart
phC = ta.pivothigh(pvL, pvR)
plC = ta.pivotlow(pvL, pvR)
var float swHi = na
var float swLo = na
if not na(phC)
    swHi := phC
if not na(plC)
    swLo := plC

bosUp = not na(swHi) and close > swHi and close[1] <= swHi
bosDn = not na(swLo) and close < swLo and close[1] >= swLo

// ─── The sequence ────────────────────────────────────────────────────────────
var int   st      = 0     // 0 idle · 1 armed · 2 back through · 3 reclaimed & holding
var int   stDir   = 0
var float zone    = na    // the broken level — the whole setup pivots on this
var float prot    = na    // protected swing; a close beyond it kills the setup
var float trigLvl = na    // the reclaim bar's extreme — step ⑤ must close past it
var float pullExt = na    // deepest point of the pullback — where the stop lives
var float legLo   = na    // the leg that built the setup, for the measured move
var float legHi   = na
var int   heldBars = 0
var int   stBars   = 0

biasOKL   = not useBias or biasT ==  1
biasOKS   = not useBias or biasT == -1
bridgeOKL = not useBridge or bridgeT ==  1
bridgeOKS = not useBridge or bridgeT == -1

armedNow = false
if st == 0
    if bosUp and biasOKL
        st       := 1
        stDir    := 1
        zone     := swHi
        prot     := nz(swLo, low)
        legLo    := nz(swLo, low)
        legHi    := high
        pullExt  := low
        trigLvl  := na
        heldBars := 0
        stBars   := 0
        armedNow := true
    else if bosDn and biasOKS
        st       := 1
        stDir    := -1
        zone     := swLo
        prot     := nz(swHi, high)
        legHi    := nz(swHi, high)
        legLo    := low
        pullExt  := high
        trigLvl  := na
        heldBars := 0
        stBars   := 0
        armedNow := true
else
    stBars += 1

// Longs
if st > 0 and stDir == 1 and not armedNow
    pullExt := math.min(pullExt, low)
    legHi   := math.max(legHi, high)
    if st == 1 and low < zone
        st := 2
    else if st == 2 and close > zone
        st       := 3
        trigLvl  := high
        heldBars := 0
    else if st == 3
        if close < zone
            st       := 2
            heldBars := 0
        else
            heldBars += 1

// Shorts
if st > 0 and stDir == -1 and not armedNow
    pullExt := math.max(pullExt, high)
    legLo   := math.min(legLo, low)
    if st == 1 and high > zone
        st := 2
    else if st == 2 and close < zone
        st       := 3
        trigLvl  := low
        heldBars := 0
    else if st == 3
        if close > zone
            st       := 2
            heldBars := 0
        else
            heldBars += 1

invalid = st > 0 and (
     (stDir ==  1 and ((not na(prot) and close < prot) or (useBias and biasT == -1))) or
     (stDir == -1 and ((not na(prot) and close > prot) or (useBias and biasT ==  1))) or
     stBars > setupTO)
if invalid
    st      := 0
    stDir   := 0
    zone    := na
    prot    := na
    trigLvl := na

// ─── Trigger ─────────────────────────────────────────────────────────────────
heldOK  = heldBars >= holdBars
breakL  = not freshBrk or (not na(trigLvl) and close > trigLvl)
breakS  = not freshBrk or (not na(trigLvl) and close < trigLvl)
trigLong  = st == 3 and stDir ==  1 and heldOK and breakL and bridgeOKL
trigShort = st == 3 and stDir == -1 and heldOK and breakS and bridgeOKS

entry   = close
buf     = syminfo.mintick * stopTicks
stopRaw = trigLong  ? math.min(nz(pullExt, low),  nz(zone, low))  - buf :
          trigShort ? math.max(nz(pullExt, high), nz(zone, high)) + buf : na
riskPts = na(stopRaw) ? na : math.abs(entry - stopRaw)

// Target: the next opposing swing on the bridge or bias timeframe.
f_above(float cur, float lvl, float px) =>
    not na(lvl) and lvl > px ? (na(cur) ? lvl : math.min(cur, lvl)) : cur
f_below(float cur, float lvl, float px) =>
    not na(lvl) and lvl < px ? (na(cur) ? lvl : math.max(cur, lvl)) : cur

wallUp = f_above(float(na), bridgeHi, entry)
wallUp := f_above(wallUp, biasHi, entry)
wallDn = f_below(float(na), bridgeLo, entry)
wallDn := f_below(wallDn, biasLo, entry)

// Open air: project the leg that built the setup. Structure projecting structure.
legSize = nz(legHi, high) - nz(legLo, low)
mmUp    = useMM and legSize > 0 ? entry + legSize : na
mmDn    = useMM and legSize > 0 ? entry - legSize : na
target  = trigLong ? nz(wallUp, mmUp) : nz(wallDn, mmDn)
roomR   = not na(riskPts) and riskPts > 0 and not na(target) ? math.abs(target - entry) / riskPts : 0.0

// ─── Your rules ──────────────────────────────────────────────────────────────
inSess = not useSess or not na(time(timeframe.period, sessStr, sessTZ))
var int tookToday = 0
var int lastDay   = na
if na(lastDay) or dayofmonth != lastDay
    tookToday := 0
    lastDay   := dayofmonth

okToTrade = roomR >= minRoom and inSess and tookToday < maxPerDay and
     not na(riskPts) and riskPts > 0 and strategy.position_size == 0

// ─── Orders ──────────────────────────────────────────────────────────────────
var float pStop = na
var float pT1   = na
var float pT2   = na
var bool  t1Hit = false

// The exits go in WITH the entry — the bracket exists from the first bar of
// the position, exactly like the bot places it. (They used to be submitted a
// bar late from the position_size block below, so a T1 touch or a stop-out on
// the entry bar itself could never fill and the backtest flattered the rules.)
// And the trade consumes the sequence — same as the bot — or the day counter
// resets overnight and the SAME stale setup re-fires tomorrow.
if trigLong and okToTrade
    pStop := stopRaw
    pT1   := entry + riskPts * partialR
    pT2   := target
    t1Hit := false
    tookToday += 1
    strategy.entry("L", strategy.long)
    strategy.exit("L-T1", "L", qty_percent = t1Pct, limit = pT1, stop = pStop)
    strategy.exit("L-T2", "L", limit = pT2, stop = pStop)
    st       := 0
    stDir    := 0
    zone     := na
    prot     := na
    trigLvl  := na
    heldBars := 0
    stBars   := 0

if trigShort and okToTrade
    pStop := stopRaw
    pT1   := entry - riskPts * partialR
    pT2   := target
    t1Hit := false
    tookToday += 1
    strategy.entry("S", strategy.short)
    strategy.exit("S-T1", "S", qty_percent = t1Pct, limit = pT1, stop = pStop)
    strategy.exit("S-T2", "S", limit = pT2, stop = pStop)
    st       := 0
    stDir    := 0
    zone     := na
    prot     := na
    trigLvl  := na
    heldBars := 0
    stBars   := 0

if strategy.position_size > 0 and not t1Hit and high >= pT1
    t1Hit := true
    if beAtT1
        pStop := math.max(pStop, strategy.position_avg_price)
if strategy.position_size < 0 and not t1Hit and low <= pT1
    t1Hit := true
    if beAtT1
        pStop := math.min(pStop, strategy.position_avg_price)

if strategy.position_size > 0
    strategy.exit("L-T1", "L", qty_percent = t1Pct, limit = pT1, stop = pStop)
    strategy.exit("L-T2", "L", limit = pT2, stop = pStop)
if strategy.position_size < 0
    strategy.exit("S-T1", "S", qty_percent = t1Pct, limit = pT1, stop = pStop)
    strategy.exit("S-T2", "S", limit = pT2, stop = pStop)

if flatEOD and useSess and not inSess and inSess[1] and strategy.position_size != 0
    strategy.close_all("EOD")

// ─── Visuals ─────────────────────────────────────────────────────────────────
plotshape(bosUp, "BOS up",   shape.triangleup,   location.belowbar, color.new(#26a69a, 60), size = size.tiny)
plotshape(bosDn, "BOS down", shape.triangledown, location.abovebar, color.new(#ef5350, 60), size = size.tiny)
plotshape(trigLong  and okToTrade, "Long",  shape.triangleup,   location.belowbar, color.new(#26a69a, 0), size = size.small)
plotshape(trigShort and okToTrade, "Short", shape.triangledown, location.abovebar, color.new(#ef5350, 0), size = size.small)
plot(strategy.position_size != 0 ? pStop : na, "Stop", color.new(#ef5350, 0), style = plot.style_linebr)
plot(strategy.position_size != 0 ? pT1   : na, "T1",   color.new(#26a69a, 0), style = plot.style_linebr)
plot(strategy.position_size != 0 ? pT2   : na, "T2",   color.new(#26a69a, 50), style = plot.style_linebr)

// ─── How often does the sequence even happen? ────────────────────────────────
var int nArm = 0
var int nRaw = 0
if armedNow
    nArm += 1
if (trigLong or trigShort)
    nRaw += 1

var table t = table.new(position.bottom_right, 2, 4, bgcolor = color.new(#0e1116, 10),
     frame_color = color.new(color.gray, 60), frame_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "MSB PURE", text_color = color.white, text_size = size.small, bgcolor = #3b82f6)
    table.cell(t, 1, 0, "", bgcolor = #3b82f6)
    table.cell(t, 0, 1, "Setups armed", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 1, str.tostring(nArm), text_color = color.silver, text_size = size.small)
    table.cell(t, 0, 2, "Triggers (sequence done)", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 2, str.tostring(nRaw), text_color = color.yellow, text_size = size.small)
    table.cell(t, 0, 3, "Trades taken", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 3, str.tostring(strategy.closedtrades), text_color = #26a69a, text_size = size.small)
