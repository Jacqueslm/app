//@version=6
// =============================================================================
//  MSB TRAP — the setup from the drawing  (the watcher: dashboard + alerts)
//
//  Long (shorts are the mirror):
//    1  Daily makes HH + HL                     -> longs only
//    2  1H prints a lower high (LH) under the bigger high H1
//    3  price pokes ABOVE the LH (wick or close - either)
//    4  a 1H-chart close BACK BELOW it          -> the trap is set
//       (a close above H1 instead = real move. Stand down. No chasing.)
//    5  price falls to "something": the last 1H swing low L*
//    6  this chart SWEEPS it - low takes out L*, close back above
//    7  the FLIP: a close above this chart's own last swing high
//    8  ENTER. Stop under the sweep low. Target H1 - the high from BEFORE
//       the lower high, never the LH itself.
//
//  Pure structure. Every number is a swing high, a swing low, or a close.
//  Run it on the 15m chart. The 1H, 4H and Daily are read from it.
// =============================================================================

indicator("MSB Trap — alerts", "MSB-TRAP", overlay = true, max_lines_count = 500, max_labels_count = 500)

grpS = "Structure"
pvC  = input.int(3, "Swing strength — this chart",  minval = 1, maxval = 20, group = grpS)
pvH  = input.int(5, "Swing strength — 1H / 4H / Daily", minval = 1, maxval = 20, group = grpS)
useFlat = input.bool(false, "4H must not trend against the trade", group = grpS,
     tooltip = "The drawing plays a 4H consolidation. ON = block when the 4H trends against you. The backtest fired more, and better, with this OFF - the trap itself already is the consolidation.")
expBars = input.int(400, "Setup expires after N bars", minval = 20, group = grpS)

grpZ = "Size"
riskPct  = input.float(10.0, "Risk per trade (% of account)", minval = 0.1, maxval = 100, step = 0.5, group = grpZ)
acctSize = input.float(100000, "Account size ($)", minval = 100, step = 500, group = grpZ,
     tooltip = "An indicator cannot see your broker balance. Keep this current - the demo reset counts.")
maxQty   = input.int(50, "Contract cap", minval = 1, group = grpZ)
stopTicks = input.int(4, "Stop buffer (ticks beyond the sweep)", minval = 0, group = grpZ)
minRoom  = input.float(1.0, "Reject if room to H1 below this (R)", minval = 0.0, step = 0.5, group = grpZ)

grpM = "Management"
useT1  = input.bool(true, "Half off at 1R, stop to break-even", group = grpM)

grpR = "Your rules"
maxPerDay = input.int(1, "Max trades per day", minval = 1, maxval = 10, group = grpR)
useSess = input.bool(true, "Only trade the New York session", group = grpR)
sessStr = input.session("0930-1500", "Tradeable window", group = grpR)
sessTZ  = input.string("America/New_York", "Timezone", group = grpR)

// ─── Structure ───────────────────────────────────────────────────────────────
f_trend() =>
    ph = ta.pivothigh(pvH, pvH)
    pl = ta.pivotlow(pvH, pvH)
    var float h1 = na
    var float h2 = na
    var float l1 = na
    var float l2 = na
    var int   t  = 0
    if not na(ph)
        h2 := h1
        h1 := ph
    if not na(pl)
        l2 := l1
        l1 := pl
    if not na(h1) and not na(h2) and not na(l1) and not na(l2)
        if h1 > h2 and l1 > l2
            t := 1
        else if h1 < h2 and l1 < l2
            t := -1
    [t, h1, h2, l1, l2]

[dT, dh1, dh2, dl1, dl2] = request.security(syminfo.tickerid, "D",   f_trend(), lookahead = barmerge.lookahead_off)
[fT, fh1, fh2, fl1, fl2] = request.security(syminfo.tickerid, "240", f_trend(), lookahead = barmerge.lookahead_off)
[hT, hh1, hh2, hl1, hl2] = request.security(syminfo.tickerid, "60",  f_trend(), lookahead = barmerge.lookahead_off)

// this chart's swings: the flip level and the sweep read
phC = ta.pivothigh(pvC, pvC)
plC = ta.pivotlow(pvC, pvC)
var float cHi = na
var float cLo = na
if not na(phC)
    cHi := phC
if not na(plC)
    cLo := plC

inSess = not useSess or not na(time(timeframe.period, sessStr, sessTZ))
var int tookToday = 0
var int lastDay = na
if na(lastDay) or dayofmonth != lastDay
    tookToday := 0
    lastDay := dayofmonth

// ─── The trap, long side ─────────────────────────────────────────────────────
// st: 0 idle · 1 poked · 2 trapped · 3 at the level · 4 swept, waiting the flip
var int   Lst = 0
var float LH1 = na
var float LLH = na
var float LLs = na
var float LswpExt = na
var float LflipLvl = na
var int   Lage = 0

allowedL = dT == 1 and (not useFlat or fT >= 0)
if not allowedL
    Lst := 0
if Lst > 0
    Lage += 1
    if Lage > expBars
        Lst := 0
if Lst > 0 and close > LH1
    Lst := 0                       // the move was real - no chase
if Lst == 0 and allowedL and not na(hh1) and not na(hh2) and hh1 < hh2 and high > hh1
    Lst := 1
    LH1 := hh2
    LLH := hh1
    LLs := hl1
    Lage := 0
else if Lst == 1 and close < LLH
    Lst := 2
else if Lst == 2 and not na(LLs) and low <= LLs
    Lst := 3
    LswpExt := low
else if Lst == 3
    LswpExt := math.min(LswpExt, low)
    if LswpExt < LLs and close > LLs
        Lst := 4
        LflipLvl := cHi
else if Lst == 4
    LswpExt := math.min(LswpExt, low)
    if not na(cHi) and cHi < LLH
        LflipLvl := cHi
    if close < LLs
        Lst := 3

// ─── The trap, short side ────────────────────────────────────────────────────
var int   Sst = 0
var float SH1 = na
var float SLH = na
var float SLs = na
var float SswpExt = na
var float SflipLvl = na
var int   Sage = 0

allowedS = dT == -1 and (not useFlat or fT <= 0)
if not allowedS
    Sst := 0
if Sst > 0
    Sage += 1
    if Sage > expBars
        Sst := 0
if Sst > 0 and close < SH1
    Sst := 0
if Sst == 0 and allowedS and not na(hl1) and not na(hl2) and hl1 > hl2 and low < hl1
    Sst := 1
    SH1 := hl2
    SLH := hl1
    SLs := hh1
    Sage := 0
else if Sst == 1 and close > SLH
    Sst := 2
else if Sst == 2 and not na(SLs) and high >= SLs
    Sst := 3
    SswpExt := high
else if Sst == 3
    SswpExt := math.max(SswpExt, high)
    if SswpExt > SLs and close < SLs
        Sst := 4
        SflipLvl := cLo
else if Sst == 4
    SswpExt := math.max(SswpExt, high)
    if not na(cLo) and cLo > SLH
        SflipLvl := cLo
    if close > SLs
        Sst := 3

// ─── The flip = entry ────────────────────────────────────────────────────────
trigLong  = Lst == 4 and not na(LflipLvl) and close > LflipLvl and close < LLH
trigShort = Sst == 4 and not na(SflipLvl) and close < SflipLvl and close > SLH

entry  = close
buf    = syminfo.mintick * stopTicks
stopL  = LswpExt - buf
stopS  = SswpExt + buf
stopRaw = trigLong ? stopL : trigShort ? stopS : na
riskPts = na(stopRaw) ? na : math.abs(entry - stopRaw)
target  = trigLong ? LH1 : trigShort ? SH1 : na
roomR   = not na(riskPts) and riskPts > 0 and not na(target) ? math.abs(target - entry) / riskPts : 0.0

ptVal   = syminfo.pointvalue
riskUsd = acctSize * riskPct / 100.0
qty     = not na(riskPts) and riskPts > 0 and ptVal > 0 ? math.min(maxQty, math.floor(riskUsd / (riskPts * ptVal))) : 0

okToTrade = roomR >= minRoom and inSess and tookToday < maxPerDay and not na(riskPts) and riskPts > 0 and qty > 0
fire = (trigLong or trigShort) and okToTrade
if fire
    tookToday += 1
    if trigLong
        Lst := 0
    else
        Sst := 0

t1 = na(riskPts) ? na : trigLong ? entry + riskPts : entry - riskPts
t2 = target

// ─── What you see ────────────────────────────────────────────────────────────
if fire
    label.new(bar_index, trigLong ? low : high,
         (trigLong ? "▲ TRAP LONG" : "▼ TRAP SHORT") + "  " + str.tostring(roomR, "#.0") + "R  " + str.tostring(qty) + "x",
         style = trigLong ? label.style_label_up : label.style_label_down,
         color = trigLong ? #26a69a : #ef5350, textcolor = color.white, size = size.small)
    line.new(bar_index, entry,   bar_index + 10, entry,   color = color.blue,  width = 1)
    line.new(bar_index, stopRaw, bar_index + 10, stopRaw, color = #ef5350, width = 1, style = line.style_dashed)
    line.new(bar_index, t2,      bar_index + 10, t2,      color = #26a69a, width = 1, style = line.style_dashed)

f_arrow(int t) => t == 1 ? "▲" : t == -1 ? "▼" : "–"
f_col(int t)   => t == 1 ? #26a69a : t == -1 ? #ef5350 : color.gray
stTxt(int stv) =>
    stv == 0 ? "idle" :
     stv == 1 ? "① poked the LH" :
     stv == 2 ? "② trapped — waiting for the drop" :
     stv == 3 ? "③ at the level — waiting for the sweep" :
     "④ swept — waiting for the flip"

var table dash = table.new(position.top_right, 2, 7, bgcolor = color.new(#0e1116, 10),
     frame_color = color.new(color.gray, 60), frame_width = 1)
if barstate.islast
    table.cell(dash, 0, 0, "MSB TRAP", text_color = color.white, text_size = size.small, bgcolor = #3b82f6)
    table.cell(dash, 1, 0, syminfo.ticker, text_color = color.white, text_size = size.small, bgcolor = #3b82f6)
    table.cell(dash, 0, 1, "Daily", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 1, f_arrow(dT), text_color = f_col(dT), text_size = size.small)
    table.cell(dash, 0, 2, "4H", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 2, f_arrow(fT), text_color = f_col(fT), text_size = size.small)
    table.cell(dash, 0, 3, "1H", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 3, f_arrow(hT), text_color = f_col(hT), text_size = size.small)
    table.cell(dash, 0, 4, "Long side", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 4, stTxt(Lst), text_color = Lst >= 3 ? color.yellow : color.silver, text_size = size.small)
    table.cell(dash, 0, 5, "Short side", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 5, stTxt(Sst), text_color = Sst >= 3 ? color.yellow : color.silver, text_size = size.small)
    table.cell(dash, 0, 6, "Bullets left", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 6, str.tostring(math.max(0, maxPerDay - tookToday)) + " / " + str.tostring(maxPerDay),
         text_color = tookToday < maxPerDay ? color.silver : color.gray, text_size = size.small)

// ─── Alerts — same message format the relay already understands ──────────────
plot(fire ? (trigLong ? 1 : -1) : na, "aDir",   display = display.none, editable = false)
plot(fire ? entry   : na,             "aEntry", display = display.none, editable = false)
plot(fire ? stopRaw : na,             "aStop",  display = display.none, editable = false)
plot(fire ? riskPts : na,             "aRisk",  display = display.none, editable = false)
plot(fire ? t1      : na,             "aT1",    display = display.none, editable = false)
plot(fire ? t2      : na,             "aT2",    display = display.none, editable = false)
plot(fire ? roomR   : na,             "aRoom",  display = display.none, editable = false)
plot(fire ? qty     : na,             "aQty",   display = display.none, editable = false)

alertcondition(fire, "TRADE SIGNAL — the full alert",
     "{{ticker}} MSB PURE dir {{plot(\"aDir\")}} | entry {{plot(\"aEntry\")}} | stop {{plot(\"aStop\")}} | risk {{plot(\"aRisk\")}} pts | T1 {{plot(\"aT1\")}} | T2 {{plot(\"aT2\")}} | room {{plot(\"aRoom\")}}R | qty {{plot(\"aQty\")}}")

alertcondition((Lst == 4 and Lst[1] != 4) or (Sst == 4 and Sst[1] != 4), "Swept — the flip is next",
     "{{ticker}} swept the level and reclaimed it. Watch for the flip.")
