//@version=6
// =============================================================================
//  MSB TRAP — the range play  (the watcher: dashboard + alerts)
//
//  No Daily. The 4H is the range. The 1H is the trade. The 15m only places
//  the stop. Run this on the 1H chart.
//
//  Long (shorts are the mirror):
//    1  price SWEEPS the last 1H swing low - trades through it
//    2  then CLOSES back above it              -> the reclaim
//    3  then closes above the 1H's own last small swing high -> the FLIP. ENTER.
//       (entry refused once price is already back at the last 1H high - no chasing)
//    4  stop: the last 15m swing low if it is tighter, else the sweep low
//    5  target: the 1H high on the far side - and when a lower high sits in
//       front of it, the high BEFORE that one, never the lower high itself
//
//  The full trap (lower high poked, close back below, drop, sweep, flip) is
//  the same trade with a stricter front door - switchable below.
//
//  Pure structure. Every number is a swing high, a swing low, or a close.
// =============================================================================

strategy("MSB Trap — backtest", "MSB-TRAP", overlay = true,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     initial_capital = 100000, currency = currency.USD,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.39,
     slippage = 2, margin_long = 0, margin_short = 0,
     max_lines_count = 500, max_labels_count = 500)

grpS = "Structure"
pvC = input.int(2, "Swing strength — 1H flips (small)", minval = 1, maxval = 20, group = grpS)
pvH = input.int(5, "Swing strength — 1H levels / 4H map", minval = 1, maxval = 20, group = grpS)
modeTrap = input.bool(false, "Require the full trap first (poke of a lower high + close back below)", group = grpS,
     tooltip = "OFF = any sweep of the last 1H swing counts (measured better and fires at your 1-2 a week across three instruments). ON = only after a failed break of a lower high.")
expBars = input.int(400, "Setup expires after N bars", minval = 20, group = grpS)

grpZ = "Size & stop"
riskPct  = input.float(10.0, "Risk per trade (% of account)", minval = 0.1, maxval = 100, step = 0.5, group = grpZ)
maxQty   = input.int(50, "Contract cap", minval = 1, group = grpZ)
stopTicks = input.int(4, "Stop buffer (ticks)", minval = 0, group = grpZ)
use15    = input.bool(true, "15m stop — use the last 15m swing when tighter", group = grpZ)
minRoom  = input.float(1.0, "Reject if room below this (R)", minval = 0.0, step = 0.5, group = grpZ)

grpM = "Management"
useT1 = input.bool(true, "Half off at 1R, stop to break-even", group = grpM)

grpR = "Your rules"
maxPerDay = input.int(2, "Max trades per day", minval = 1, maxval = 10, group = grpR)
useSess = input.bool(true, "Only trade the New York session", group = grpR)
sessStr = input.session("0930-1500", "Tradeable window", group = grpR)
sessTZ  = input.string("America/New_York", "Timezone", group = grpR)

// ─── Structure ───────────────────────────────────────────────────────────────
// The 1H levels: the big swings, and the one before each (for "the high
// before the lower high"). Computed on this chart with the LARGE strength.
phH = ta.pivothigh(pvH, pvH)
plH = ta.pivotlow(pvH, pvH)
var float hh1 = na
var float hh2 = na
var float ll1 = na
var float ll2 = na
if not na(phH)
    hh2 := hh1
    hh1 := phH
if not na(plH)
    ll2 := ll1
    ll1 := plH

// The small swings: the flip levels.
phC = ta.pivothigh(pvC, pvC)
plC = ta.pivotlow(pvC, pvC)
var float cHi = na
var float cLo = na
if not na(phC)
    cHi := phC
if not na(plC)
    cLo := plC

// The 15m swings, for the stop only.
f_pl() =>
    var float p = na
    x = ta.pivotlow(3, 3)
    if not na(x)
        p := x
    p
f_ph() =>
    var float p = na
    x = ta.pivothigh(3, 3)
    if not na(x)
        p := x
    p
lo15 = request.security(syminfo.tickerid, "15", f_pl(), lookahead = barmerge.lookahead_off)
hi15 = request.security(syminfo.tickerid, "15", f_ph(), lookahead = barmerge.lookahead_off)

inSess = not useSess or not na(time(timeframe.period, sessStr, sessTZ))
var int tookToday = 0
var int lastDay = na
if na(lastDay) or dayofmonth != lastDay
    tookToday := 0
    lastDay := dayofmonth

// ─── Long side ───────────────────────────────────────────────────────────────
// st: 0 idle · 1 poked · 2 trapped · 3 at the level (swept) · 4 reclaimed, waiting the flip
var int   Lst = 0
var float LH1 = na
var float LLH = na
var float LLs = na
var float LswpExt = na
var float LflipLvl = na
var int   Lage = 0

if Lst > 0
    Lage += 1
    if Lage > expBars
        Lst := 0
if Lst > 0 and close > LH1
    Lst := 0                          // the move was real - no chase
if Lst == 0
    if not modeTrap and not na(ll1) and low <= ll1
        LH1 := not na(hh2) and hh1 < hh2 ? hh2 : hh1
        LLH := hh1
        LLs := ll1
        LswpExt := low
        Lst := 3
        Lage := 0
    else if modeTrap and not na(hh1) and not na(hh2) and hh1 < hh2 and high > hh1
        Lst := 1
        LH1 := hh2
        LLH := hh1
        LLs := ll1
        Lage := 0
else if Lst == 1 and close < LLH
    Lst := 2
else if Lst == 2 and not na(LLs) and low <= LLs
    Lst := 3
    LswpExt := low
else if Lst == 3
    LswpExt := math.min(LswpExt, low)
    if LswpExt < LLs and close > LLs
        Lst := 4
        LflipLvl := cHi
else if Lst == 4
    LswpExt := math.min(LswpExt, low)
    if not na(cHi) and cHi < LLH
        LflipLvl := cHi
    if close < LLs
        Lst := 3

// ─── Short side ──────────────────────────────────────────────────────────────
var int   Sst = 0
var float SH1 = na
var float SLH = na
var float SLs = na
var float SswpExt = na
var float SflipLvl = na
var int   Sage = 0

if Sst > 0
    Sage += 1
    if Sage > expBars
        Sst := 0
if Sst > 0 and close < SH1
    Sst := 0
if Sst == 0
    if not modeTrap and not na(hh1) and high >= hh1
        SH1 := not na(ll2) and ll1 > ll2 ? ll2 : ll1
        SLH := ll1
        SLs := hh1
        SswpExt := high
        Sst := 3
        Sage := 0
    else if modeTrap and not na(ll1) and not na(ll2) and ll1 > ll2 and low < ll1
        Sst := 1
        SH1 := ll2
        SLH := ll1
        SLs := hh1
        Sage := 0
else if Sst == 1 and close > SLH
    Sst := 2
else if Sst == 2 and not na(SLs) and high >= SLs
    Sst := 3
    SswpExt := high
else if Sst == 3
    SswpExt := math.max(SswpExt, high)
    if SswpExt > SLs and close < SLs
        Sst := 4
        SflipLvl := cLo
else if Sst == 4
    SswpExt := math.max(SswpExt, high)
    if not na(cLo) and cLo > SLH
        SflipLvl := cLo
    if close > SLs
        Sst := 3

// ─── The flip = entry ────────────────────────────────────────────────────────
trigLong  = Lst == 4 and not na(LflipLvl) and close > LflipLvl and close < LLH
trigShort = Sst == 4 and not na(SflipLvl) and close < SflipLvl and close > SLH

entry = close
buf   = syminfo.mintick * stopTicks
// the 15m's whole job: a tighter stop when its structure allows one
anchL = trigLong  and use15 and not na(lo15) and lo15 > LswpExt and lo15 < entry ? lo15 : LswpExt
anchS = trigShort and use15 and not na(hi15) and hi15 < SswpExt and hi15 > entry ? hi15 : SswpExt
stopRaw = trigLong ? anchL - buf : trigShort ? anchS + buf : na
riskPts = na(stopRaw) ? na : math.abs(entry - stopRaw)
target  = trigLong ? LH1 : trigShort ? SH1 : na
roomR   = not na(riskPts) and riskPts > 0 and not na(target) ? math.abs(target - entry) / riskPts : 0.0

ptVal   = syminfo.pointvalue
riskUsd = strategy.equity * riskPct / 100.0
qty     = not na(riskPts) and riskPts > 0 and ptVal > 0 ? math.min(maxQty, math.floor(riskUsd / (riskPts * ptVal))) : 0

okToTrade = roomR >= minRoom and inSess and tookToday < maxPerDay and not na(riskPts) and riskPts > 0 and qty > 0 and strategy.position_size == 0
fire = (trigLong or trigShort) and okToTrade

var float pStop = na
var float pT1   = na
var float pT2   = na
var bool  t1Hit = false

if fire
    tookToday += 1
    pStop := stopRaw
    pT1   := trigLong ? entry + riskPts : entry - riskPts
    pT2   := target
    t1Hit := false
    if trigLong
        Lst := 0
        strategy.entry("L", strategy.long, qty = qty)
        if useT1
            strategy.exit("L-T1", "L", qty_percent = 50, limit = pT1, stop = pStop)
            strategy.exit("L-T2", "L", limit = pT2, stop = pStop)
        else
            strategy.exit("L-X", "L", limit = pT2, stop = pStop)
    else
        Sst := 0
        strategy.entry("S", strategy.short, qty = qty)
        if useT1
            strategy.exit("S-T1", "S", qty_percent = 50, limit = pT1, stop = pStop)
            strategy.exit("S-T2", "S", limit = pT2, stop = pStop)
        else
            strategy.exit("S-X", "S", limit = pT2, stop = pStop)

if strategy.position_size > 0 and useT1 and not t1Hit and high >= pT1
    t1Hit := true
    pStop := math.max(pStop, strategy.position_avg_price)
if strategy.position_size < 0 and useT1 and not t1Hit and low <= pT1
    t1Hit := true
    pStop := math.min(pStop, strategy.position_avg_price)

if strategy.position_size > 0
    if useT1
        strategy.exit("L-T1", "L", qty_percent = 50, limit = pT1, stop = pStop)
        strategy.exit("L-T2", "L", limit = pT2, stop = pStop)
    else
        strategy.exit("L-X", "L", limit = pT2, stop = pStop)
if strategy.position_size < 0
    if useT1
        strategy.exit("S-T1", "S", qty_percent = 50, limit = pT1, stop = pStop)
        strategy.exit("S-T2", "S", limit = pT2, stop = pStop)
    else
        strategy.exit("S-X", "S", limit = pT2, stop = pStop)

if useSess and not inSess and inSess[1] and strategy.position_size != 0
    strategy.close_all("EOD")

plotshape(fire and trigLong,  "Long",  shape.triangleup,   location.belowbar, color.new(#26a69a, 0), size = size.small)
plotshape(fire and trigShort, "Short", shape.triangledown, location.abovebar, color.new(#ef5350, 0), size = size.small)
plot(strategy.position_size != 0 ? pStop : na, "Stop", color.new(#ef5350, 0), style = plot.style_linebr)
plot(strategy.position_size != 0 ? pT1   : na, "T1",   color.new(#26a69a, 0), style = plot.style_linebr)
plot(strategy.position_size != 0 ? pT2   : na, "T2",   color.new(#26a69a, 50), style = plot.style_linebr)
