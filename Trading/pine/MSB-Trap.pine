//@version=6
// =============================================================================
//  MSB TRAP — the setup from the drawing  (the watcher: dashboard + alerts)
//
//  Long (shorts are the mirror):
//    1  Daily makes HH + HL                     -> longs only
//    2  1H prints a lower high (LH) under the bigger high H1
//    3  price pokes ABOVE the LH (wick or close - either)
//    4  a 1H-chart close BACK BELOW it          -> the trap is set
//       (a close above H1 instead = real move. Stand down. No chasing.)
//    5  price falls to "something": the last 1H swing low L*
//    6  this chart SWEEPS it - low takes out L*, close back above
//    7  the FLIP: a close above this chart's own last swing high
//    8  ENTER. Stop under the sweep low. Target H1 - the high from BEFORE
//       the lower high, never the LH itself.
//
//  Pure structure. Every number is a swing high, a swing low, or a close.
//  Run it on the 15m chart. The 1H, 4H and Daily are read from it.
//  This is the BACKTESTER. The alert version is MSB-Trap-Alerts.pine.
// =============================================================================

strategy("MSB Trap — backtest", "MSB-TRAP", overlay = true,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     initial_capital = 100000, currency = currency.USD,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.39,
     slippage = 2, margin_long = 0, margin_short = 0,
     max_lines_count = 500, max_labels_count = 500)

grpS = "Structure"
pvC  = input.int(3, "Swing strength — this chart",  minval = 1, maxval = 20, group = grpS)
pvH  = input.int(5, "Swing strength — 1H / 4H / Daily", minval = 1, maxval = 20, group = grpS)
useFlat = input.bool(false, "4H must not trend against the trade", group = grpS,
     tooltip = "The drawing plays a 4H consolidation. ON = block when the 4H trends against you. The backtest fired more, and better, with this OFF - the trap itself already is the consolidation.")
expBars = input.int(400, "Setup expires after N bars", minval = 20, group = grpS)

grpZ = "Size"
riskPct  = input.float(10.0, "Risk per trade (% of account)", minval = 0.1, maxval = 100, step = 0.5, group = grpZ)
maxQty   = input.int(50, "Contract cap", minval = 1, group = grpZ)
stopTicks = input.int(4, "Stop buffer (ticks beyond the sweep)", minval = 0, group = grpZ)
minRoom  = input.float(1.0, "Reject if room to H1 below this (R)", minval = 0.0, step = 0.5, group = grpZ)

grpM = "Management"
useT1  = input.bool(true, "Half off at 1R, stop to break-even", group = grpM)

grpR = "Your rules"
maxPerDay = input.int(1, "Max trades per day", minval = 1, maxval = 10, group = grpR)
useSess = input.bool(true, "Only trade the New York session", group = grpR)
sessStr = input.session("0930-1500", "Tradeable window", group = grpR)
sessTZ  = input.string("America/New_York", "Timezone", group = grpR)

// ─── Structure ───────────────────────────────────────────────────────────────
f_trend() =>
    ph = ta.pivothigh(pvH, pvH)
    pl = ta.pivotlow(pvH, pvH)
    var float h1 = na
    var float h2 = na
    var float l1 = na
    var float l2 = na
    var int   t  = 0
    if not na(ph)
        h2 := h1
        h1 := ph
    if not na(pl)
        l2 := l1
        l1 := pl
    if not na(h1) and not na(h2) and not na(l1) and not na(l2)
        if h1 > h2 and l1 > l2
            t := 1
        else if h1 < h2 and l1 < l2
            t := -1
    [t, h1, h2, l1, l2]

[dT, dh1, dh2, dl1, dl2] = request.security(syminfo.tickerid, "D",   f_trend(), lookahead = barmerge.lookahead_off)
[fT, fh1, fh2, fl1, fl2] = request.security(syminfo.tickerid, "240", f_trend(), lookahead = barmerge.lookahead_off)
[hT, hh1, hh2, hl1, hl2] = request.security(syminfo.tickerid, "60",  f_trend(), lookahead = barmerge.lookahead_off)

// this chart's swings: the flip level and the sweep read
phC = ta.pivothigh(pvC, pvC)
plC = ta.pivotlow(pvC, pvC)
var float cHi = na
var float cLo = na
if not na(phC)
    cHi := phC
if not na(plC)
    cLo := plC

inSess = not useSess or not na(time(timeframe.period, sessStr, sessTZ))
var int tookToday = 0
var int lastDay = na
if na(lastDay) or dayofmonth != lastDay
    tookToday := 0
    lastDay := dayofmonth

// ─── The trap, long side ─────────────────────────────────────────────────────
// st: 0 idle · 1 poked · 2 trapped · 3 at the level · 4 swept, waiting the flip
var int   Lst = 0
var float LH1 = na
var float LLH = na
var float LLs = na
var float LswpExt = na
var float LflipLvl = na
var int   Lage = 0

allowedL = dT == 1 and (not useFlat or fT >= 0)
if not allowedL
    Lst := 0
if Lst > 0
    Lage += 1
    if Lage > expBars
        Lst := 0
if Lst > 0 and close > LH1
    Lst := 0                       // the move was real - no chase
if Lst == 0 and allowedL and not na(hh1) and not na(hh2) and hh1 < hh2 and high > hh1
    Lst := 1
    LH1 := hh2
    LLH := hh1
    LLs := hl1
    Lage := 0
else if Lst == 1 and close < LLH
    Lst := 2
else if Lst == 2 and not na(LLs) and low <= LLs
    Lst := 3
    LswpExt := low
else if Lst == 3
    LswpExt := math.min(LswpExt, low)
    if LswpExt < LLs and close > LLs
        Lst := 4
        LflipLvl := cHi
else if Lst == 4
    LswpExt := math.min(LswpExt, low)
    if not na(cHi) and cHi < LLH
        LflipLvl := cHi
    if close < LLs
        Lst := 3

// ─── The trap, short side ────────────────────────────────────────────────────
var int   Sst = 0
var float SH1 = na
var float SLH = na
var float SLs = na
var float SswpExt = na
var float SflipLvl = na
var int   Sage = 0

allowedS = dT == -1 and (not useFlat or fT <= 0)
if not allowedS
    Sst := 0
if Sst > 0
    Sage += 1
    if Sage > expBars
        Sst := 0
if Sst > 0 and close < SH1
    Sst := 0
if Sst == 0 and allowedS and not na(hl1) and not na(hl2) and hl1 > hl2 and low < hl1
    Sst := 1
    SH1 := hl2
    SLH := hl1
    SLs := hh1
    Sage := 0
else if Sst == 1 and close > SLH
    Sst := 2
else if Sst == 2 and not na(SLs) and high >= SLs
    Sst := 3
    SswpExt := high
else if Sst == 3
    SswpExt := math.max(SswpExt, high)
    if SswpExt > SLs and close < SLs
        Sst := 4
        SflipLvl := cLo
else if Sst == 4
    SswpExt := math.max(SswpExt, high)
    if not na(cLo) and cLo > SLH
        SflipLvl := cLo
    if close > SLs
        Sst := 3

// ─── The flip = entry ────────────────────────────────────────────────────────
trigLong  = Lst == 4 and not na(LflipLvl) and close > LflipLvl and close < LLH
trigShort = Sst == 4 and not na(SflipLvl) and close < SflipLvl and close > SLH

entry  = close
buf    = syminfo.mintick * stopTicks
stopL  = LswpExt - buf
stopS  = SswpExt + buf
stopRaw = trigLong ? stopL : trigShort ? stopS : na
riskPts = na(stopRaw) ? na : math.abs(entry - stopRaw)
target  = trigLong ? LH1 : trigShort ? SH1 : na
roomR   = not na(riskPts) and riskPts > 0 and not na(target) ? math.abs(target - entry) / riskPts : 0.0

ptVal   = syminfo.pointvalue
riskUsd = strategy.equity * riskPct / 100.0
qty     = not na(riskPts) and riskPts > 0 and ptVal > 0 ? math.min(maxQty, math.floor(riskUsd / (riskPts * ptVal))) : 0

okToTrade = roomR >= minRoom and inSess and tookToday < maxPerDay and not na(riskPts) and riskPts > 0 and qty > 0 and strategy.position_size == 0
fire = (trigLong or trigShort) and okToTrade

var float pStop = na
var float pT1   = na
var float pT2   = na
var bool  t1Hit = false

if fire
    tookToday += 1
    pStop := stopRaw
    pT1   := trigLong ? entry + riskPts : entry - riskPts
    pT2   := target
    t1Hit := false
    if trigLong
        Lst := 0
        strategy.entry("L", strategy.long, qty = qty)
        if useT1
            strategy.exit("L-T1", "L", qty_percent = 50, limit = pT1, stop = pStop)
            strategy.exit("L-T2", "L", limit = pT2, stop = pStop)
        else
            strategy.exit("L-X", "L", limit = pT2, stop = pStop)
    else
        Sst := 0
        strategy.entry("S", strategy.short, qty = qty)
        if useT1
            strategy.exit("S-T1", "S", qty_percent = 50, limit = pT1, stop = pStop)
            strategy.exit("S-T2", "S", limit = pT2, stop = pStop)
        else
            strategy.exit("S-X", "S", limit = pT2, stop = pStop)

if strategy.position_size > 0 and useT1 and not t1Hit and high >= pT1
    t1Hit := true
    pStop := math.max(pStop, strategy.position_avg_price)
if strategy.position_size < 0 and useT1 and not t1Hit and low <= pT1
    t1Hit := true
    pStop := math.min(pStop, strategy.position_avg_price)

if strategy.position_size > 0
    if useT1
        strategy.exit("L-T1", "L", qty_percent = 50, limit = pT1, stop = pStop)
        strategy.exit("L-T2", "L", limit = pT2, stop = pStop)
    else
        strategy.exit("L-X", "L", limit = pT2, stop = pStop)
if strategy.position_size < 0
    if useT1
        strategy.exit("S-T1", "S", qty_percent = 50, limit = pT1, stop = pStop)
        strategy.exit("S-T2", "S", limit = pT2, stop = pStop)
    else
        strategy.exit("S-X", "S", limit = pT2, stop = pStop)

if useSess and not inSess and inSess[1] and strategy.position_size != 0
    strategy.close_all("EOD")

plotshape(fire and trigLong,  "Long",  shape.triangleup,   location.belowbar, color.new(#26a69a, 0), size = size.small)
plotshape(fire and trigShort, "Short", shape.triangledown, location.abovebar, color.new(#ef5350, 0), size = size.small)
plot(strategy.position_size != 0 ? pStop : na, "Stop", color.new(#ef5350, 0), style = plot.style_linebr)
plot(strategy.position_size != 0 ? pT1   : na, "T1",   color.new(#26a69a, 0), style = plot.style_linebr)
plot(strategy.position_size != 0 ? pT2   : na, "T2",   color.new(#26a69a, 50), style = plot.style_linebr)
