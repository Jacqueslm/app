ANTHROPIC_API_KEY=your_anthropic_api_key_here
PORT=3000
SESSION_SECRET=replace_with_a_long_random_string
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
# Optional - enables the "Continue with Google" button. Create an OAuth 2.0 Web
# client at https://console.cloud.google.com/apis/credentials, add your app's
# origin to "Authorized JavaScript origins", and paste the client ID here.
# Without it, the button stays hidden and email/password sign-in still works.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
