//@version=5
// Someday - swings and structure breaks
//
// Two things, on the timeframe in front of you:
//   1. the swing points, read from the candle BODY only - a wick above the last
//      body high is not a high;
//   2. a mark on the bar where a candle CLOSES through the last swing high or
//      low, so you can see structure break as it happens.
//
// Nothing is drawn across the chart. No lines, no box of numbers, no shaded
// area, no time window. The only marks are the letters on the swings and the
// break that follows them.
//
// It never asks which timeframe to look at. It reads the chart you have open, so
// the 5 second chart and the daily chart both work, with nothing to list and
// nothing to keep in step by hand.

indicator("Someday - swings", shorttitle="Someday", overlay=true, max_labels_count=500)

// -----------------------------------------------------------------------------
// Settings
// -----------------------------------------------------------------------------
showSwings = input.bool(true, "Show the swing points", group="Swings")
swingLen = input.int(2, "Swing length", minval=1, maxval=20, tooltip="Bars either side a candle body has to beat to count as a swing. One number drives the letters and the breaks, so they can never disagree.", group="Swings")
swingCol = input.color(color.gray, "Swing colour", group="Swings")

showBreaks = input.bool(true, "Mark the structure breaks", group="Breaks")
breakUpCol = input.color(#089981, "Break up colour", group="Breaks")
breakDownCol = input.color(#f23645, "Break down colour", group="Breaks")

// -----------------------------------------------------------------------------
// The swings
// -----------------------------------------------------------------------------
// The body is the only part of a candle that is a price, so both readings below
// use the body and never a wick.
bodyTop() => math.max(open, close)
bodyBottom() => math.min(open, close)

swingHigh = ta.pivothigh(bodyTop(), swingLen, swingLen)
swingLow = ta.pivotlow(bodyBottom(), swingLen, swingLen)

// The letters are against the last swing of the same kind: HH higher high, LH
// lower high, HL higher low, LL lower low. The first of a kind has nothing to
// compare with, so it keeps its bare letter rather than a name it has not earned.
var float namedHigh = na
var float namedLow = na

if showSwings and not na(swingHigh)
    highName = na(namedHigh) ? "H" : swingHigh > namedHigh ? "HH" : "LH"
    label.new(bar_index - swingLen, swingHigh, highName, style=label.style_label_down, color=color.new(color.black, 100), textcolor=swingCol, size=size.tiny)
    namedHigh := swingHigh

if showSwings and not na(swingLow)
    lowName = na(namedLow) ? "L" : swingLow > namedLow ? "HL" : "LL"
    label.new(bar_index - swingLen, swingLow, lowName, style=label.style_label_up, color=color.new(color.black, 100), textcolor=swingCol, size=size.tiny)
    namedLow := swingLow

// -----------------------------------------------------------------------------
// Structure
// -----------------------------------------------------------------------------
// The last confirmed swing high and the last confirmed swing low are the two
// levels being watched. Nothing is drawn for them, so the chart stays clear
// until one of them actually goes.
var float upLevel = na
var float downLevel = na
var int upBrokenAt = na
var int downBrokenAt = na

if not na(swingHigh)
    upLevel := swingHigh
    upBrokenAt := na

if not na(swingLow)
    downLevel := swingLow
    downBrokenAt := na

// A break is counted once per level, on a finished candle, and only on a close.
// The level is not watched again until the next swing of the same kind is
// confirmed, so a run of candles through the same price is one break and not
// five. The mark sits on the bar that did it, at the price that was given up.
if barstate.isconfirmed and not na(upLevel) and na(upBrokenAt) and close > upLevel
    upBrokenAt := bar_index
    if showBreaks
        label.new(bar_index, upLevel, "BROKE UP", style=label.style_label_down, color=breakUpCol, textcolor=color.white, size=size.small)

if barstate.isconfirmed and not na(downLevel) and na(downBrokenAt) and close < downLevel
    downBrokenAt := bar_index
    if showBreaks
        label.new(bar_index, downLevel, "BROKE DOWN", style=label.style_label_up, color=breakDownCol, textcolor=color.white, size=size.small)
