//@version=5
// Someday - swings
//
// One thing, on the timeframe in front of you: the swing points, read from the
// candle BODY only. A wick above the last body high is not a high and a wick
// below the last body low is not a low.
//
// The letters are against the last swing of the same kind:
//   HL higher low, LH lower high - those two need nothing else, a low that
//   stops short of the last low is a higher low on its own;
//   HH higher high, LL lower low - those two are only written once a candle
//   has CLOSED through the level being watched. Dipping past a low and closing
//   back above it is not a lower low, so no letter is written and the old low
//   stays the one that matters.
//
// Nothing else is drawn. No lines, no words, no box of numbers, no shaded area,
// no time window. It reads the chart you have open, so the 5 second chart and
// the daily chart both work, with nothing to list and nothing to keep in step.

indicator("Someday - swings", shorttitle="Someday", overlay=true, max_labels_count=500)

// -----------------------------------------------------------------------------
// Settings
// -----------------------------------------------------------------------------
showSwings = input.bool(true, "Show the swing points", group="Swings")
swingLen = input.int(2, "Swing length", minval=1, maxval=20, tooltip="Bars either side a candle body has to beat to count as a swing. One number drives every letter on the chart.", group="Swings")
swingCol = input.color(color.gray, "Swing colour", group="Swings")

// -----------------------------------------------------------------------------
// The swings
// -----------------------------------------------------------------------------
// The body is the only part of a candle that is a price, so both readings below
// use the body and never a wick.
bodyTop() => math.max(open, close)
bodyBottom() => math.min(open, close)

swingHigh = ta.pivothigh(bodyTop(), swingLen, swingLen)
swingLow = ta.pivotlow(bodyBottom(), swingLen, swingLen)

// The last high and the last low that are still standing, and whether a candle
// has closed through each of them since. A close is the only thing that counts.
var float namedHigh = na
var float namedLow = na
var bool highBroken = false
var bool lowBroken = false

if barstate.isconfirmed and not na(namedHigh) and close > namedHigh
    highBroken := true

if barstate.isconfirmed and not na(namedLow) and close < namedLow
    lowBroken := true

// A high that stops short of the last high is a lower high on its own. A high
// above the last one is only a higher high once a candle has closed through the
// last one. Until then nothing is written and the old high stays the level.
if showSwings and not na(swingHigh)
    string highName = na
    if na(namedHigh)
        highName := "H"
    else if swingHigh < namedHigh
        highName := "LH"
    else if highBroken
        highName := "HH"
    if not na(highName)
        label.new(bar_index - swingLen, swingHigh, highName, style=label.style_label_down, color=color.new(color.black, 100), textcolor=swingCol, size=size.tiny)
        namedHigh := swingHigh
        highBroken := false

// The same, the other way up. The first swing of each kind has nothing to
// compare with, so it keeps a bare H or L.
if showSwings and not na(swingLow)
    string lowName = na
    if na(namedLow)
        lowName := "L"
    else if swingLow > namedLow
        lowName := "HL"
    else if lowBroken
        lowName := "LL"
    if not na(lowName)
        label.new(bar_index - swingLen, swingLow, lowName, style=label.style_label_up, color=color.new(color.black, 100), textcolor=swingCol, size=size.tiny)
        namedLow := swingLow
        lowBroken := false
