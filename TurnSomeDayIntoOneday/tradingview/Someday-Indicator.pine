//@version=5
// Someday - the indicator, both halves.
//
// Half one: supply and demand zones built from confirmed swings, read on the
// chart's own timeframe and on four higher ones, with the retracement levels
// inside them.
//
// Half two: the times he trades - the range of a chosen timeframe starting at a
// chosen time on his own clock (8:00 and 14:00 Central, which is 9:00 and 15:00
// on the exchange clock), shaded as a column, boxed, carrying the same levels
// inside it, and kept only while price has not taken it out.
//
// Nothing here reads the future and nothing here predicts. A zone appears only
// after its swing has confirmed; a range only after its bars have closed. The
// drawing choices that are not facts are the "reaches back" and "your clock"
// inputs, and they are yours.
indicator("Someday", shorttitle="Someday", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ----------------------------------------------------------------- structure
showSwings = input.bool(true, "Swing points", group="Structure")
swingLen   = input.int(10, "Structure length", minval=2, maxval=50, group="Structure")
swingCol   = input.color(color.new(color.teal, 25), "Swing colour", group="Structure")
nameSwings = input.bool(false, "Name the swings (HH HL LH LL)", group="Structure")

// --------------------------------------------------------------------- zones
showZones  = input.bool(true, "Display zones", group="Zones")
zoneSide   = input.string("Both", "Zone display", options=["Both", "Bullish", "Bearish"], group="Zones")
showLast   = input.int(1, "Show last, per side", minval=1, maxval=10, group="Zones")
cleanBands = input.bool(true, "Clean up level overlap", group="Zones")
zoneBack   = input.int(6, "A new zone reaches back (bars)", minval=1, maxval=60, group="Zones")
zoneLive   = input.int(300, "Zone life (bars)", minval=10, maxval=2000, group="Zones")
keepBroken = input.bool(false, "Keep zones price has taken out", group="Zones")
bullCol    = input.color(color.new(#26a69a, 85), "Bullish zone", group="Zones")
bearCol    = input.color(color.new(#ef5350, 85), "Bearish zone", group="Zones")
edgeCol    = input.color(color.new(color.gray, 55), "Zone edge", group="Zones")

// -------------------------------------------------------------- retracements
// Ticked here, drawn inside both: the supply and demand zones, and the boxes
// around your two times.
fib0     = input.bool(false, "0", inline="fib", group="Retracements")
fib3     = input.bool(true, "0.3", inline="fib", group="Retracements")
fib5     = input.bool(true, "0.5", inline="fib", group="Retracements")
fib7     = input.bool(true, "0.7", inline="fib", group="Retracements")
fib1     = input.bool(false, "1", inline="fib", group="Retracements")
fibStyle = input.string("Dotted", "Line style", options=["Solid", "Dashed", "Dotted"], group="Retracements")
fibCol   = input.color(color.new(color.gray, 30), "Line colour", group="Retracements")

// --------------------------------------------------------------- timeframes
useChart = input.bool(true, "Chart timeframe", group="Timeframes")
use15    = input.bool(true, "15 minutes", group="Timeframes")
use60    = input.bool(true, "1 hour", group="Timeframes")
use240   = input.bool(true, "4 hours", group="Timeframes")
useD     = input.bool(false, "1 day", group="Timeframes")

// -------------------------------------------------------------- time ranges
showRanges  = input.bool(true, "Shade the ranges", group="Time ranges")
tzName      = input.string("America/Chicago", "Your clock", group="Time ranges")
markInsides = input.bool(false, "Mark inside bars", group="Time ranges")
insChar     = input.string("*", "Marker", group="Time ranges")
greyMark    = input.color(color.new(color.gray, 25), "Marker away from a range", group="Time ranges")
mitPct      = input.float(0.0, "Taken out once price closes past the edge by (% of the range)", minval=0, maxval=500, group="Time ranges")
keepRanges  = input.int(5, "Unmitigated ranges kept, per time", minval=1, maxval=25, group="Time ranges")
rangeLife   = input.int(500, "Range life (bars)", minval=10, maxval=5000, group="Time ranges")
extendRng   = input.bool(true, "Extend the range box", group="Time ranges")

// Time 1 - the open, on his clock
on1  = input.bool(true, "On", group="Time 1")
hr1  = input.int(8, "Hour", minval=0, maxval=23, group="Time 1")
mn1  = input.int(0, "Minute", minval=0, maxval=59, group="Time 1")
tf1  = input.timeframe("60", "Range", group="Time 1")
col1 = input.color(#2962ff, "Colour", group="Time 1")

// Time 2 - the last hour of the cash session, on his clock
on2  = input.bool(true, "On", group="Time 2")
hr2  = input.int(14, "Hour", minval=0, maxval=23, group="Time 2")
mn2  = input.int(0, "Minute", minval=0, maxval=59, group="Time 2")
tf2  = input.timeframe("60", "Range", group="Time 2")
col2 = input.color(#ff9800, "Colour", group="Time 2")

// ------------------------------------------------------------------ a zone
// A box, plus up to five levels inside it. The levels are counted from the
// swing itself: 0 sits on the swing, 1 sits at the far end of the leg.
type Zone
    box  b
    line f0
    line f3
    line f5
    line f7
    line f1

var Zone[] supplyZones = array.new<Zone>()
var Zone[] demandZones = array.new<Zone>()

lineStyle() =>
    fibStyle == "Solid" ? line.style_solid : fibStyle == "Dashed" ? line.style_dashed : line.style_dotted

makeZone(bool supply, float top, float bottom, int left) =>
    right = bar_index + 20
    z = Zone.new(box.new(left, top, right, bottom, border_color=edgeCol, border_width=1, bgcolor=supply ? bearCol : bullCol), na, na, na, na, na)
    span = top - bottom
    if span > 0
        st = lineStyle()
        if fib0
            lv = supply ? top : bottom
            z.f0 := line.new(left, lv, right, lv, color=fibCol, style=st)
        if fib3
            lv = supply ? top - span * 0.3 : bottom + span * 0.3
            z.f3 := line.new(left, lv, right, lv, color=fibCol, style=st)
        if fib5
            lv = supply ? top - span * 0.5 : bottom + span * 0.5
            z.f5 := line.new(left, lv, right, lv, color=fibCol, style=st)
        if fib7
            lv = supply ? top - span * 0.7 : bottom + span * 0.7
            z.f7 := line.new(left, lv, right, lv, color=fibCol, style=st)
        if fib1
            lv = supply ? bottom : top
            z.f1 := line.new(left, lv, right, lv, color=fibCol, style=st)
    z

killZone(Zone z) =>
    box.delete(z.b)
    if not na(z.f0)
        line.delete(z.f0)
    if not na(z.f3)
        line.delete(z.f3)
    if not na(z.f5)
        line.delete(z.f5)
    if not na(z.f7)
        line.delete(z.f7)
    if not na(z.f1)
        line.delete(z.f1)

addZone(bool supply, float top, float bottom, int left) =>
    wanted = zoneSide == "Both" or (supply and zoneSide == "Bearish") or (not supply and zoneSide == "Bullish")
    if showZones and wanted and not na(top) and not na(bottom) and top > bottom
        Zone[] arr = supply ? supplyZones : demandZones
        if cleanBands and array.size(arr) > 0
            for i = array.size(arr) - 1 to 0
                Zone old = array.get(arr, i)
                if box.get_top(old.b) >= bottom and box.get_bottom(old.b) <= top
                    killZone(old)
                    array.remove(arr, i)
        while array.size(arr) >= showLast
            killZone(array.shift(arr))
        array.push(arr, makeZone(supply, top, bottom, left))

pruneZones(Zone[] arr, bool supply) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            Zone z = array.get(arr, i)
            top = box.get_top(z.b)
            bot = box.get_bottom(z.b)
            left = box.get_left(z.b)
            box.set_right(z.b, bar_index + 20)
            if not na(z.f0)
                line.set_x2(z.f0, bar_index + 20)
            if not na(z.f3)
                line.set_x2(z.f3, bar_index + 20)
            if not na(z.f5)
                line.set_x2(z.f5, bar_index + 20)
            if not na(z.f7)
                line.set_x2(z.f7, bar_index + 20)
            if not na(z.f1)
                line.set_x2(z.f1, bar_index + 20)
            dead = bar_index - left > zoneLive
            if not keepBroken
                dead := dead or (supply ? close > top : close < bot)
            if dead
                killZone(z)
                array.remove(arr, i)

// ------------------------------------------------------ a range and its levels
// A range is a box like a zone, so it carries the same levels: here they are
// counted from the top of the range down, 0 on the high and 1 on the low, which
// is how a range is measured rather than how a leg into a swing is.
newRange(float top, float bottom, int left, color col) =>
    z = Zone.new(box.new(left, top, bar_index, bottom, border_color=color.new(col, 40), border_width=1, bgcolor=color.new(col, 88)), na, na, na, na, na)
    span = top - bottom
    if span > 0
        st = lineStyle()
        if fib0
            z.f0 := line.new(left, top, bar_index, top, color=fibCol, style=st)
        if fib3
            lv = top - span * 0.3
            z.f3 := line.new(left, lv, bar_index, lv, color=fibCol, style=st)
        if fib5
            lv = top - span * 0.5
            z.f5 := line.new(left, lv, bar_index, lv, color=fibCol, style=st)
        if fib7
            lv = top - span * 0.7
            z.f7 := line.new(left, lv, bar_index, lv, color=fibCol, style=st)
        if fib1
            z.f1 := line.new(left, bottom, bar_index, bottom, color=fibCol, style=st)
    z

// ---------------------------------------------------------- a range's upkeep
// Kept while it lives and while price has not taken it out. "Taken out" means
// a close past one of its edges by that share of the range's own height, so 0
// is any close outside and 100 is a close a whole range beyond it. The levels
// inside it come and go with it.
runRanges(Zone[] arr) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            Zone z = array.get(arr, i)
            top = box.get_top(z.b)
            bot = box.get_bottom(z.b)
            span = top - bot
            if extendRng
                box.set_right(z.b, bar_index + 5)
                if not na(z.f0)
                    line.set_x2(z.f0, bar_index + 5)
                if not na(z.f3)
                    line.set_x2(z.f3, bar_index + 5)
                if not na(z.f5)
                    line.set_x2(z.f5, bar_index + 5)
                if not na(z.f7)
                    line.set_x2(z.f7, bar_index + 5)
                if not na(z.f1)
                    line.set_x2(z.f1, bar_index + 5)
            past = mitPct / 100 * span
            old = bar_index - box.get_left(z.b) > rangeLife
            taken = close > top + past or close < bot - past
            if old or taken
                killZone(z)
                array.remove(arr, i)

// ----------------------------------------------------------- the swings, named
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastHigh = na
var float lastLow  = na

if not na(ph)
    what = na(lastHigh) ? "H" : ph > lastHigh ? "HH" : "LH"
    lastHigh := ph
    if showSwings
        label.new(bar_index - swingLen, ph, nameSwings ? what : "", style=label.style_label_down, color=color.new(color.black, 100), textcolor=swingCol, size=size.tiny)

if not na(pl)
    what = na(lastLow) ? "L" : pl > lastLow ? "HL" : "LL"
    lastLow := pl
    if showSwings
        label.new(bar_index - swingLen, pl, nameSwings ? what : "", style=label.style_label_up, color=color.new(color.black, 100), textcolor=swingCol, size=size.tiny)

// --------------------------------------------------- zones, chart timeframe
if useChart and not na(ph)
    addZone(true, ph, ta.lowest(low, swingLen)[swingLen], bar_index - zoneBack)

if useChart and not na(pl)
    addZone(false, ta.highest(high, swingLen)[swingLen], pl, bar_index - zoneBack)

// ------------------------------------------------ zones, higher timeframes
// One call per timeframe, reading the swing and the leg that led into it. The
// token is the time of the swing bar, so a swing that confirms is only drawn
// once however many chart bars sit inside the confirming bar.
var int seen15h = na
var int seen15l = na
var int seen60h = na
var int seen60l = na
var int seen4h  = na
var int seen4l  = na
var int seen1dh = na
var int seen1dl = na

[a15ph, a15pl, a15lo, a15hi, a15t] = request.security(syminfo.tickerid, "15", [ta.pivothigh(high, swingLen, swingLen), ta.pivotlow(low, swingLen, swingLen), ta.lowest(low, swingLen)[swingLen], ta.highest(high, swingLen)[swingLen], time[swingLen]], lookahead=barmerge.lookahead_off)

if use15 and not na(a15ph) and a15t != seen15h
    seen15h := a15t
    addZone(true, a15ph, a15lo, bar_index - zoneBack)

if use15 and not na(a15pl) and a15t != seen15l
    seen15l := a15t
    addZone(false, a15hi, a15pl, bar_index - zoneBack)

[b60ph, b60pl, b60lo, b60hi, b60t] = request.security(syminfo.tickerid, "60", [ta.pivothigh(high, swingLen, swingLen), ta.pivotlow(low, swingLen, swingLen), ta.lowest(low, swingLen)[swingLen], ta.highest(high, swingLen)[swingLen], time[swingLen]], lookahead=barmerge.lookahead_off)

if use60 and not na(b60ph) and b60t != seen60h
    seen60h := b60t
    addZone(true, b60ph, b60lo, bar_index - zoneBack)

if use60 and not na(b60pl) and b60t != seen60l
    seen60l := b60t
    addZone(false, b60hi, b60pl, bar_index - zoneBack)

[c4hph, c4hpl, c4hlo, c4hhi, c4ht] = request.security(syminfo.tickerid, "240", [ta.pivothigh(high, swingLen, swingLen), ta.pivotlow(low, swingLen, swingLen), ta.lowest(low, swingLen)[swingLen], ta.highest(high, swingLen)[swingLen], time[swingLen]], lookahead=barmerge.lookahead_off)

if use240 and not na(c4hph) and c4ht != seen4h
    seen4h := c4ht
    addZone(true, c4hph, c4hlo, bar_index - zoneBack)

if use240 and not na(c4hpl) and c4ht != seen4l
    seen4l := c4ht
    addZone(false, c4hhi, c4hpl, bar_index - zoneBack)

[d1dph, d1dpl, d1dlo, d1dhi, d1dt] = request.security(syminfo.tickerid, "1D", [ta.pivothigh(high, swingLen, swingLen), ta.pivotlow(low, swingLen, swingLen), ta.lowest(low, swingLen)[swingLen], ta.highest(high, swingLen)[swingLen], time[swingLen]], lookahead=barmerge.lookahead_off)

if useD and not na(d1dph) and d1dt != seen1dh
    seen1dh := d1dt
    addZone(true, d1dph, d1dlo, bar_index - zoneBack)

if useD and not na(d1dpl) and d1dt != seen1dl
    seen1dl := d1dt
    addZone(false, d1dhi, d1dpl, bar_index - zoneBack)

// ----------------------------------------------------- the ranges themselves
// The range is the high and the low of the bars from the chosen time until the
// chosen timeframe is up. On the exchange clock 8:00 Central is 9:00 and 14:00
// Central is 15:00, which is what the time input is measured against - your
// clock, as the device reports it, not an assumption.
var int   start1 = na
var float top1   = na
var float bot1   = na
var int   left1  = na
var bool  open1  = false
var Zone[] boxes1 = array.new<Zone>()

var int   start2 = na
var float top2   = na
var float bot2   = na
var int   left2  = na
var bool  open2  = false
var Zone[] boxes2 = array.new<Zone>()

tf1ms = timeframe.in_seconds(tf1) * 1000
tf2ms = timeframe.in_seconds(tf2) * 1000

if on1 and hour(time, tzName) == hr1 and minute(time, tzName) == mn1
    start1 := time
    top1   := high
    bot1   := low
    left1  := bar_index
    open1  := true

if open1
    here1 = not na(start1) and time >= start1 and time < start1 + tf1ms
    if here1
        top1 := math.max(top1, high)
        bot1 := math.min(bot1, low)
    else
        open1 := false
        if showRanges
            array.push(boxes1, newRange(top1, bot1, left1, col1))
            while array.size(boxes1) > keepRanges
                killZone(array.shift(boxes1))

if on2 and hour(time, tzName) == hr2 and minute(time, tzName) == mn2
    start2 := time
    top2   := high
    bot2   := low
    left2  := bar_index
    open2  := true

if open2
    here2 = not na(start2) and time >= start2 and time < start2 + tf2ms
    if here2
        top2 := math.max(top2, high)
        bot2 := math.min(bot2, low)
    else
        open2 := false
        if showRanges
            array.push(boxes2, newRange(top2, bot2, left2, col2))
            while array.size(boxes2) > keepRanges
                killZone(array.shift(boxes2))

in1 = on1 and not na(start1) and time >= start1 and time < start1 + tf1ms
in2 = on2 and not na(start2) and time >= start2 and time < start2 + tf2ms

// Inside bars, marked where they sit: in the colour of the range it is inside,
// grey when it is not inside one.
inside = high < high[1] and low > low[1]

if markInsides and inside
    markCol = in1 ? col1 : in2 ? col2 : greyMark
    label.new(bar_index, high, insChar, style=label.style_none, yloc=yloc.abovebar, textcolor=markCol, size=size.tiny)

// ------------------------------------------------------------------- the read
// The four states, the level, and the checklist - his rules as numbers.
//
// The frame is read off CLOSED 4h candles only. A poke above the level with no
// 4h close above it is the grab, and it changes nothing. This section is
// self-contained: it reads nothing from the halves above it and can sit at the
// very end of the file.
frameLen = input.int(2, "4h swing length", minval=2, maxval=20, group="The read")
smallTf  = input.timeframe("15", "Small chart", group="The read")
smallLen = input.int(3, "Small chart swing length", minval=2, maxval=20, group="The read")
showRead = input.bool(true, "Show the read", group="The read")
lvlCol   = input.color(#ffeb3b, "Level line", group="The read")
lowCol   = input.color(color.new(color.gray, 15), "4h low line", group="The read")
readSize = input.string("tiny", "Table text", options=["tiny", "small", "normal"], group="The read")

readText = readSize == "tiny" ? size.tiny : readSize == "small" ? size.small : size.normal

[f4hPh, f4hPl, f4hClose, f4hTok] = request.security(syminfo.tickerid, "240", [ta.pivothigh(high, frameLen, frameLen), ta.pivotlow(low, frameLen, frameLen), close[1], time[frameLen]], lookahead=barmerge.lookahead_off)

var float fHigh      = na
var float fPrevHigh  = na
var float fLow       = na
var float fPrevLow   = na
var float theLevel   = na
var float frameLow   = na
var int   seenFrameH = na
var int   seenFrameL = na

if not na(f4hPh) and f4hTok != seenFrameH
    seenFrameH := f4hTok
    fPrevHigh := fHigh
    fHigh := f4hPh

if not na(f4hPl) and f4hTok != seenFrameL
    seenFrameL := f4hTok
    fPrevLow := fLow
    fLow := f4hPl
    lowerLow = not na(fPrevLow) and f4hPl < fPrevLow
    if lowerLow
        frameLow := f4hPl
        if not na(fHigh)
            theLevel := fHigh

c4 = f4hClose
haveFrame = not na(theLevel) and not na(frameLow)
changed   = haveFrame and c4 > theLevel
underLow  = haveFrame and c4 < frameLow
atLevel   = haveFrame and not changed and high >= theLevel
retracing = haveFrame and not changed and not underLow and not atLevel and close < theLevel

stateName = not haveFrame ? "no frame yet" : changed ? "frame changed" : underLow ? "under the low" : atLevel ? "level in play" : "retracing"

// The small chart: higher highs, and the last higher low still holding - a
// close under it ends the hold, a wick does not.
[fSPh, fSPl, sClose, fSTok] = request.security(syminfo.tickerid, smallTf, [ta.pivothigh(high, smallLen, smallLen), ta.pivotlow(low, smallLen, smallLen), close, time[smallLen]], lookahead=barmerge.lookahead_off)

var float sHigh      = na
var float sPrevHigh  = na
var float sLow       = na
var float sPrevLow   = na
var float sHold      = na
var int   seenSmallH = na
var int   seenSmallL = na

if not na(fSPh) and fSTok != seenSmallH
    seenSmallH := fSTok
    sPrevHigh := sHigh
    sHigh := fSPh

if not na(fSPl) and fSTok != seenSmallL
    seenSmallL := fSTok
    sPrevLow := sLow
    sLow := fSPl
    if not na(sPrevLow) and fSPl > sPrevLow
        sHold := fSPl

ltfUp = not na(sPrevHigh) and sHigh > sPrevHigh and not na(sHold) and sClose > sHold

longOk  = haveFrame and not changed and not underLow and retracing and ltfUp
shortOk = haveFrame and not changed and atLevel
verdict = changed ? "wait - the frame changed" : shortOk ? "short" : longOk ? "long scalp" : "wait"

// The level and the 4h low, drawn so the thing he is watching is visible.
var line[] lvlLines = array.new_line()
var line[] lowLines = array.new_line()

lvChanged = not na(theLevel) and (na(theLevel[1]) or theLevel != theLevel[1])
if lvChanged
    array.push(lvlLines, line.new(bar_index, theLevel, bar_index + 20, theLevel, color=lvlCol, width=1))
    while array.size(lvlLines) > 3
        line.delete(array.shift(lvlLines))

loChanged = not na(frameLow) and (na(frameLow[1]) or frameLow != frameLow[1])
if loChanged
    array.push(lowLines, line.new(bar_index, frameLow, bar_index + 20, frameLow, color=lowCol, width=1))
    while array.size(lowLines) > 3
        line.delete(array.shift(lowLines))

if array.size(lvlLines) > 0
    for i = 0 to array.size(lvlLines) - 1
        line.set_x2(array.get(lvlLines, i), bar_index + 20)

if array.size(lowLines) > 0
    for i = 0 to array.size(lowLines) - 1
        line.set_x2(array.get(lowLines, i), bar_index + 20)

var table dash = table.new(position.top_right, 2, 8, border_width=1, frame_width=1, bgcolor=color.new(color.black, 25))

if showRead and barstate.islast
    table.cell(dash, 0, 0, "State", text_size=readText, text_color=color.new(color.white, 45))
    table.cell(dash, 1, 0, stateName, text_size=readText, text_color=color.white)
    table.cell(dash, 0, 1, "The level", text_size=readText, text_color=color.new(color.white, 45))
    table.cell(dash, 1, 1, na(theLevel) ? "none yet" : str.tostring(theLevel, format.mintick), text_size=readText, text_color=color.white)
    table.cell(dash, 0, 2, "The 4h low", text_size=readText, text_color=color.new(color.white, 45))
    table.cell(dash, 1, 2, na(frameLow) ? "none yet" : str.tostring(frameLow, format.mintick), text_size=readText, text_color=color.white)
    table.cell(dash, 0, 3, "4h lower low made", text_size=readText, text_color=color.new(color.white, 45))
    table.cell(dash, 1, 3, haveFrame ? "yes" : "no", text_size=readText, text_color=color.white)
    table.cell(dash, 0, 4, "At the level or working back", text_size=readText, text_color=color.new(color.white, 45))
    table.cell(dash, 1, 4, (atLevel or retracing) ? "yes" : "no", text_size=readText, text_color=color.white)
    table.cell(dash, 0, 5, "Small chart higher highs, higher low held", text_size=readText, text_color=color.new(color.white, 45))
    table.cell(dash, 1, 5, ltfUp ? "yes" : "no", text_size=readText, text_color=color.white)
    table.cell(dash, 0, 6, "4h closed above the level", text_size=readText, text_color=color.new(color.white, 45))
    table.cell(dash, 1, 6, changed ? "yes" : "no", text_size=readText, text_color=color.white)
    table.cell(dash, 0, 7, "Verdict", text_size=readText, text_color=color.new(color.white, 45))
    table.cell(dash, 1, 7, verdict, text_size=readText, text_color=shortOk ? color.red : longOk ? color.teal : color.new(color.white, 35))

alertcondition(longOk and not longOk[1], title="Long scalp", message="The small chart turned up while the 4h frame is down and the level has not been closed above - long scalp into the level")
alertcondition(shortOk and not shortOk[1], title="Short - price at the level", message="Price is at the 4h lower high and the 4h has not closed above it")
alertcondition(changed and not changed[1], title="Frame changed", message="The 4h closed above the level - the down frame is off")

// ----------------------------------------------------------------- the upkeep
// Zones run to the right while they live, and they come off when price takes
// them out - unless "keep zones price has taken out" is ticked. The ranges
// come off the same way, by their own width.
pruneZones(supplyZones, true)
pruneZones(demandZones, false)
runRanges(boxes1)
runRanges(boxes2)

// The columns. One call only - TradingView allows a script one background.
bgcolor(showRanges and (in1 or in2) ? (in1 ? color.new(col1, 88) : color.new(col2, 88)) : na, title="Time ranges")
