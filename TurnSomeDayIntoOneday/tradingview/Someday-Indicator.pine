//@version=5
// Someday - structure, zones and the read
//
// Jacques: "an indicator that aligns with it, letting me know high probability
// swings and zones and the best time to hold a move or scalp."
//
// It reads the chart in front of you and nothing else. Whatever timeframe that
// chart is on - the 5 second, the 5 minute, the 4 hour, the daily - it works,
// with nothing to list and nothing to keep in step. A list of timeframes can
// only ever hold what was thought of on the day it was written.
//
// 21 Sep 2026. It was marking every turn: on the daily that is a letter every
// few bars, which reads as noise rather than structure. Two things changed.
// A swing now has to be the top of a body over five bars either side, so the
// chart shows turns that held rather than every twitch. And each letter is
// coloured by what it says: green where structure is holding up, red where it
// is failing. Nothing else about it changed.
//
// Three things:
//   1. THE SWINGS. HH, LH, HL, LL, read from the candle BODY only. A wick above
//      the last body high is not a high.
//   2. THE ZONE. The range between the last swing high and the last swing low,
//      with the middle of it drawn through - the prices the market has been
//      dealing between. When a candle closes outside it, the range moves.
//   3. THE READ. One plain line at the last bar: where price sits in that range,
//      how far each edge is, and what a hold would actually need.
//
// Nothing here predicts. Every number is arithmetic on bars that have already
// closed. The last line states the condition a hold needs; it never says a move
// is coming, because that cannot be known from a chart.

indicator("Someday - structure and zones", shorttitle="Someday", overlay=true, max_labels_count=500, max_lines_count=50, max_boxes_count=5)

// -----------------------------------------------------------------------------
// Settings
// -----------------------------------------------------------------------------
swingLen = input.int(5, "Swing length", minval=2, maxval=50, group="Swings", tooltip="Bars either side a candle body has to beat to count as a swing. Five shows turns that held. One or two marks every twitch on the chart and reads as noise, so the floor here is two.")
showSwings = input.bool(true, "Show the swing points", group="Swings")
upCol = input.color(#089981, "Holding up (HH, HL)", group="Swings")
downCol = input.color(#f23645, "Failing (LH, LL)", group="Swings")

showZone = input.bool(true, "Show the zone", group="Zone")
zoneFill = input.color(color.new(#2962ff, 88), "Zone fill", group="Zone")
zoneEdge = input.color(color.new(#2962ff, 40), "Zone edge", group="Zone")
midCol = input.color(color.new(color.gray, 35), "Middle line", group="Zone")

showRead = input.bool(true, "Show the read at the last bar", group="The read")
readCol = input.color(color.new(#b2b5be, 0), "Read colour", group="The read")

// -----------------------------------------------------------------------------
// The swings
// -----------------------------------------------------------------------------
// The body is the only part of a candle that is a price, so both readings below
// use the body and never a wick.
bodyTop() => math.max(open, close)
bodyBottom() => math.min(open, close)

swingHigh = ta.pivothigh(bodyTop(), swingLen, swingLen)
swingLow = ta.pivotlow(bodyBottom(), swingLen, swingLen)

// The level being watched, and the bar it came from.
var float namedHigh = na
var float namedLow = na
var int highBar = na
var int lowBar = na

// A level is only taken out by a candle that CLOSES through it. That is what
// stops a dip under a low that closes back above it being read as a lower low -
// the old low is still standing, so the old low stays the one that matters.
var bool highBroken = false
var bool lowBroken = false

if barstate.isconfirmed and not na(namedHigh) and close > namedHigh
    highBroken := true
if barstate.isconfirmed and not na(namedLow) and close < namedLow
    lowBroken := true

// The letters are against the last swing of the same kind. Stopping short needs
// no proof: a low that does not reach the last low is a higher low by itself,
// and a high that does not reach the last high is a lower high by itself.
// Reaching past one is only called once a candle has closed through it.
//
// The colour is the letter's own meaning, not a signal: HH and HL are structure
// that is holding up, LH and LL are structure that is failing. The first swing
// of a kind has nothing to compare with, so it keeps a bare H or L in grey.
if not na(swingHigh)
    string highName = na(namedHigh) ? "H" : highBroken ? "HH" : swingHigh < namedHigh ? "LH" : ""
    if highName != ""
        if showSwings
            color highCol = highName == "HH" ? upCol : highName == "LH" ? downCol : color.gray
            label.new(bar_index - swingLen, swingHigh, highName, style=label.style_label_down, color=highCol, textcolor=color.white, size=size.small)
        namedHigh := swingHigh
        highBar := bar_index - swingLen
        highBroken := false

if not na(swingLow)
    string lowName = na(namedLow) ? "L" : lowBroken ? "LL" : swingLow > namedLow ? "HL" : ""
    if lowName != ""
        if showSwings
            color lowCol = lowName == "HL" ? upCol : lowName == "LL" ? downCol : color.gray
            label.new(bar_index - swingLen, swingLow, lowName, style=label.style_label_up, color=lowCol, textcolor=color.white, size=size.small)
        namedLow := swingLow
        lowBar := bar_index - swingLen
        lowBroken := false

// -----------------------------------------------------------------------------
// The zone
// -----------------------------------------------------------------------------
// Two swings are a range. Both are kept, so the box only ever moves when the
// structure moves - it does not draw a new box on every bar, which is what made
// the old chart look like a staircase.
var box zoneBox = na
var line midLine = na

haveZone = not na(namedHigh) and not na(namedLow)
zoneTop = haveZone ? math.max(namedHigh, namedLow) : na
zoneBot = haveZone ? math.min(namedHigh, namedLow) : na

if showZone and haveZone
    int zoneLeft = math.min(highBar, lowBar)
    float zoneMid = (zoneTop + zoneBot) / 2
    if na(zoneBox)
        zoneBox := box.new(zoneLeft, zoneTop, bar_index + 3, zoneBot, border_color=zoneEdge, border_width=1, bgcolor=zoneFill)
        midLine := line.new(zoneLeft, zoneMid, bar_index + 3, zoneMid, color=midCol, width=1)
    else
        box.set_left(zoneBox, zoneLeft)
        box.set_top(zoneBox, zoneTop)
        box.set_bottom(zoneBox, zoneBot)
        box.set_right(zoneBox, bar_index + 3)
        line.set_xy1(midLine, zoneLeft, zoneMid)
        line.set_xy2(midLine, bar_index + 3, zoneMid)
if not showZone and not na(zoneBox)
    box.delete(zoneBox)
    line.delete(midLine)
    zoneBox := na
    midLine := na

// -----------------------------------------------------------------------------
// The read
// -----------------------------------------------------------------------------
// Where in the range, how far each edge is, and what a hold needs. A description
// of the bars that have closed, not a call on the ones that have not.
var label readLbl = na

if showRead and haveZone and zoneTop > zoneBot
    float span = zoneTop - zoneBot
    float place = (close - zoneBot) / span
    float tick = syminfo.mintick
    float toTop = (zoneTop - close) / tick
    float toBot = (close - zoneBot) / tick
    string where = place >= 0.66 ? "Near the top of the range" : place <= 0.34 ? "Near the bottom of the range" : "Middle of the range"
    string needs = place >= 0.66 ? "A hold needs a close above " + str.tostring(zoneTop, format.mintick) + ". Under it, price is still in the range." : place <= 0.34 ? "A hold needs a close below " + str.tostring(zoneBot, format.mintick) + ". Over it, price is still in the range." : "A hold needs one of the edges to go first. Until then this is scalp ground."
    string flipped = namedLow > namedHigh ? "The last low is above the last high. Structure has broken upward.\n" : ""
    string txt = flipped + where + "\n" + str.tostring(toTop, "#") + " ticks to the high  |  " + str.tostring(toBot, "#") + " ticks to the low" + "\n" + needs
    if na(readLbl)
        readLbl := label.new(bar_index, close, txt, style=label.style_label_left, color=color.new(color.black, 20), textcolor=readCol, size=size.small)
    else
        label.set_xy(readLbl, bar_index, close)
        label.set_text(readLbl, txt)
