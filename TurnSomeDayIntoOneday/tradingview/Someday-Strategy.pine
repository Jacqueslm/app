//@version=5
// Someday - the frame rules, entered and priced on TradingView
//
// Jacques, 21 Sep 2026: "give it to me for tradingview."
//
// This is the desk's backtest as a strategy, so the same rules can be run over
// years of bars in TradingView's own tester instead of the few weeks a free feed
// keeps. Same rules as the desk, in the same order:
//
//   1. A new LOWER LOW that CLOSED under the low before it turns the frame down.
//      The level is the swing high that drop came from; the frame low is that
//      lower low. The close is his correction of 23 Sep: a low taken and given
//      back is a raid that turns nothing, so it is the same words, the same rule
//      the desk and the practice game use, and the same bars give the same
//      answer. It is why this backtest now shows fewer turns than the first one.
//   2. Only a CLOSE above the level cancels it. A poke above that never closed
//      cancels nothing, and the order is pulled.
//   3. Back at the level is the short. Nothing chases: the order sits at the
//      level and is pulled if the frame dies first.
//   4. The stop is one average bar above the level. A stop has to sit somewhere
//      and the rule for being wrong is the level itself.
//   5. The target is the frame low: the far side of the range.
//   6. One contract, and the commission is set to what he pays.
//
// COMMISSION, exactly: he pays .39 a contract a side, and TradingView charges
// this figure on every order, so it is set to .39. Entry and exit together come
// to .78 a contract, which is the rate the desk's log uses.
//
// What this tester cannot show: the spread, slippage, and a fill he might not
// have got. It fills at the exact price of the level, the stop and the target,
// so treat its result as the best case rather than what he would have kept.

strategy("Someday - frame rules", shorttitle="Someday strat", overlay=true, commission_type=strategy.commission.cash_per_contract, commission_value=0.39, default_qty_type=strategy.fixed, default_qty_value=1, calc_on_every_tick=false, process_orders_on_close=false, max_labels_count=500)

// -----------------------------------------------------------------------------
// Settings
// -----------------------------------------------------------------------------
swingLen = input.int(5, "Swing length", minval=2, maxval=50, group="Rules", tooltip="Bars either side a candle body has to beat to count as a swing. Five shows turns that held rather than every twitch.")
stopRoom = input.float(1.0, "Stop room, in average bars", minval=0.25, maxval=5, step=0.25, group="Rules", tooltip="How far above the level the stop sits, measured in average bars so it means the same thing on every timeframe.")
takeTarget = input.bool(true, "Target the frame low", group="Rules", tooltip="Off means the trade runs until the stop is hit or a close above the level springs it.")

showLevel = input.bool(true, "Draw the level, stop and target", group="Drawing")
levelCol = input.color(#f23645, "Level", group="Drawing")
stopCol = input.color(#787b86, "Stop", group="Drawing")
targetCol = input.color(#089981, "Target", group="Drawing")

// -----------------------------------------------------------------------------
// The bars
// -----------------------------------------------------------------------------
bodyTop() => math.max(open, close)
bodyBottom() => math.min(open, close)

unitRaw = ta.sma(high - low, 20)
unit = na(unitRaw) or unitRaw <= 0 ? syminfo.mintick : unitRaw

pivHigh = ta.pivothigh(bodyTop(), swingLen, swingLen)
pivLow = ta.pivotlow(bodyBottom(), swingLen, swingLen)

// -----------------------------------------------------------------------------
// The frame
// -----------------------------------------------------------------------------
var float lastHigh = na
var float prevLowSwing = na
var float level = na
var float frameLow = na
var float stopPx = na
var float targetPx = na
var bool live = false

// A swing high is the level a drop would come back to, so the newest one is kept
// ready for the next lower low.
if not na(pivHigh)
    lastHigh := pivHigh

// A lower low than the one before it, with its OWN bar closed under that low,
// turns the frame down and sets everything: the level, the frame low, the stop
// and the target. A wick through that closed back inside is a raid, it is not a
// break, and it leaves the frame exactly as it was. close[swingLen] is the
// pivot's own bar - the pivot is only confirmed swingLen bars later.
if not na(pivLow)
    if not na(prevLowSwing) and pivLow < prevLowSwing and close[swingLen] < prevLowSwing and not na(lastHigh)
        level := lastHigh
        frameLow := pivLow
        stopPx := level + stopRoom * unit
        targetPx := frameLow
        live := true
    prevLowSwing := pivLow

// His own rule, and the one that has been costing him: only a CLOSE above the
// level cancels the frame. The working order is pulled with it.
if live and close > level
    live := false
    strategy.cancel("frame")

// The order sits at the level. It is placed once the frame is down and is never
// moved to chase price.
if live and strategy.position_size == 0
    strategy.entry("frame", strategy.short, limit=level)

// The stop goes above the level, the target at the frame low. Nothing here is
// left open at the end of the bars: the tester closes it or it stays open, and
// the trade list says which.
if strategy.position_size < 0
    strategy.exit("out", from_entry="frame", stop=stopPx, limit=takeTarget ? targetPx : na)

// -----------------------------------------------------------------------------
// Drawing
// -----------------------------------------------------------------------------
plot(showLevel and live ? level : na, "Frame level", color=levelCol, style=plot.style_linebr, linewidth=1)
plot(showLevel and live and strategy.position_size < 0 ? stopPx : na, "Stop", color=stopCol, style=plot.style_linebr, linewidth=1)
plot(showLevel and live and takeTarget ? targetPx : na, "Target", color=targetCol, style=plot.style_linebr, linewidth=1)
